<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMOrders.Login"
             Title="Cobranzas Login"
             Shell.FlyoutBehavior="Flyout"
             Shell.NavBarIsVisible="False"
             xmlns:controls="clr-namespace:BeebTech.Maui.Controls;assembly=BeebTech.Maui.Controls"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui">
    <ContentPage.Resources>
        <Style x:Key="labelRedStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="labelGreenStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="Green" />
        </Style>
        <Style x:Key="CommonEntryStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="FillAndExpand" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <StackLayout Orientation="Vertical" BackgroundColor="#EEEEEE">
            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="10"
                Padding="30"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <Image
                    Source="logo_dmujeres.png"
                    SemanticProperties.Description=""
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" IsVisible="false"/>

                <Image
                    Source="logo_odoo.png"
                    SemanticProperties.Description=""                
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" IsVisible="false"/>
                
            </FlexLayout>

            <Frame
                CornerRadius="20"
                Padding="10,10,10,10"
                Margin="10,5,10,10"
                MaximumWidthRequest="700"
                BorderColor="Transparent">

                <VerticalStackLayout
                    Spacing="20"
                    Padding="10"
                    MinimumHeightRequest="450"
                    VerticalOptions="Fill">

                    <Image
                    Source="logo_macronegocios.png"
                    SemanticProperties.Description=""
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" />

                    <Label 
                    Text="Sistema de Pedidos"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                        FontAttributes="Bold" 
                        TextColor="Gray"
                        FontSize="19"/>
                   

                    <VerticalStackLayout x:Name="CompanySelector" IsVisible="False">
                        <material:DropdownField x:Name="ddCompany"
                                Title="Compañia">
                        </material:DropdownField>
                        <material:DropdownField x:Name="ddAgency"
                            Title="Agencia">
                        </material:DropdownField>

                        <HorizontalStackLayout HorizontalOptions="Center" Padding="10" Spacing="10">
                            <Button
                                x:Name="btnAccess"
                                Text="Ingresar"
                                SemanticProperties.Hint="Ingresar"
                                Clicked="btnAccess_Clicked"
                                WidthRequest="250"
                                CornerRadius="2"
                                HorizontalOptions="Center"
                                BackgroundColor="IndianRed" 
                                FontAttributes="Bold"/>

                            <Button
                                x:Name="btnBack"
                                Text="Regresar"
                                SemanticProperties.Hint="Regresar"
                                Clicked="btnBack_Clicked"
                                WidthRequest="250"
                                CornerRadius="2"
                                HorizontalOptions="Center"
                                BackgroundColor="BlueViolet" 
                                FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>


                    <VerticalStackLayout x:Name="LoginSelector">

                        <material:TextField
                        x:Name="txtUser"
                        Title="Usuario"
                            BorderThickness="0.4"
                        Icon="{FontImageSource FontFamily=MaterialRegular, Glyph={x:Static m:MaterialRegular.Email}}"
                        />

                        <material:TextField 
                        x:Name="txtPassword"
                        Title="Password" 
                        IsPassword="True"                        
                        Icon="{FontImageSource FontFamily=MaterialRegular, Glyph={x:Static m:MaterialRegular.Lock}}">
                            <material:TextField.Attachments>
                                <material:TextFieldPasswordShowHideAttachment />
                            </material:TextField.Attachments>
                        </material:TextField>

                        <!--<controls:EntryLayout 
                        x:Name="entryUser" 
                        Placeholder="Usuario"
                        HidePassword="False" 
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf007;"/>
                    
                    <controls:EntryLayout 
                        x:Name="entryPassword" 
                        Placeholder="Contraseña"
                        HidePassword="True" 
                        HidePasswordColor="Gray"
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf023;"
                        AllowHidePasswordPassword="True"/>-->
                        <HorizontalStackLayout HorizontalOptions="Center" Padding="10">
                            <Button
                                x:Name="BtnTryLogin"
                                Text="Iniciar sesión"
                                SemanticProperties.Hint="Iniciar sesión"
                                Clicked="TryLogin"
                                WidthRequest="250"
                                CornerRadius="2"
                                HorizontalOptions="Center"
                                BackgroundColor="IndianRed" 
                                FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <Label 
        Text="Todos los derechos reservados &#169; D'Mujeres S.A. 2023"
            FontSize="11"
        VerticalOptions="Center" 
        HorizontalOptions="Center"
                        TextColor="Gray"/>

                    <Label 
            x:Name="lblAppVersion"
        Text="Version 0.1"
            FontSize="12"
        VerticalOptions="Center" 
        HorizontalOptions="Center" 
                        Margin="0"                        
                        TextColor="Gray"/>
                    <Label
            x:Name="txtEnvironment"
        Text="Environment"
            FontSize="12"
        VerticalOptions="Center"
        HorizontalOptions="Center" 
                        TextColor="Gray"
                        />

                    <Button
                    BackgroundColor="Red"
                    x:Name="btnSetting"
                    Text=""
                    SemanticProperties.Hint="Settings"
                    Clicked="ShowSettings"
                        VerticalOptions="Start"
                        HorizontalOptions="Center"
                        MinimumHeightRequest="40"
                        IsVisible="false">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
											Color="DimGray"
											Size="20"
											FontAutoScalingEnabled="True"                                                         
											Glyph="&#xf7d9;" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Frame>
        </StackLayout>        
    </ScrollView>
</ContentPage>