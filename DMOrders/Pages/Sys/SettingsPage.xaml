                <Button                    
                x:Name="btnSave"
                Text="Guardar"                    
                    BackgroundColor="DodgerBlue"
                    Margin="2"
                    HeightRequest="35" 
                    Padding="10,0,10,0"
                SemanticProperties.Hint="Save changes"
                Clicked="btnSave_Clicked"
                HorizontalOptions="Center" >
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesome5Solid"
												Color="White"
												Size="20"
												FontAutoScalingEnabled="True"                                                         
												Glyph="&#xf0c7;" />
                </Button.ImageSource>
            </Button>

                <Button                     
    x:Name="BtnDropData"
    Text="Eliminar datos"    
    Clicked="DropData"
                    HeightRequest="35" 
    HorizontalOptions="Center"                    
    BackgroundColor="Red" 
                        IsVisible="True"
                    Padding="10,0,10,0">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                        Color="White"
                        Size="20"
                        FontAutoScalingEnabled="True"                                                         
                        Glyph="&#xf12d;" />
                    </Button.ImageSource>
                </Button>
                

                <Button
                x:Name="btnClose"                
                Text="Cerrar"                                
                Margin="2"
                HeightRequest="35" 
                Padding="10,0,10,0"
                SemanticProperties.Hint="Cerrar"
                Clicked="btnClose_Clicked"
                HorizontalOptions="End">
                    <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesome5Solid"
									Color="White"
									Size="20"
									FontAutoScalingEnabled="True"                                                         
									Glyph="&#xf060;" />
                </Button.ImageSource>
            </Button>
            </HorizontalStackLayout>

