             x:Class="DMOrders.Pages.Sys.SettingsPage"
             xmlns:control="clr-namespace:DMOrders.Controls"
             Title="Configuraciones">
    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout>
            <Label
                Text="Configuración del sistema"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="5"
                FontAttributes="Bold"
                />

            <!--<StackLayout>
