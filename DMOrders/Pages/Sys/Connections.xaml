<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            xmlns:controlsUI="clr-namespace:BeebTech.Maui.Controls.UI;assembly=BeebTech.Maui.Controls"
            x:Class="DMOrders.Pages.Sys.Connections"
            Title="Configuración"
            BarBackgroundColor="White"
            BarTextColor="Black"
            SelectedTabColor="DodgerBlue"
            UnselectedTabColor="Gray"
            NavigationPage.HasBackButton="True"
            xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
            android:TabbedPage.IsSmoothScrollEnabled="false"
            android:TabbedPage.IsSwipePagingEnabled="false">

    <ContentPage Title="Conexiones" BackgroundColor="White">
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6" Padding="8">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="8">

                    <toolkit:Expander x:Name="ExpanderCol0" IsExpanded="True">
                        <toolkit:Expander.Header>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Datos" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="FontAwesome5Solid"
                                                         Glyph="&#xf0d7;"
                                                         Color="Black"
                                                         Size="16" />
                                    </Image.Source>
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding Source={x:Reference ExpanderCol0}, Path=IsExpanded}"
                                                     Value="True">
                                            <Setter Property="Rotation" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding Source={x:Reference ExpanderCol0}, Path=IsExpanded}"
                                                     Value="False">
                                            <Setter Property="Rotation" Value="-180" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </HorizontalStackLayout>
                        </toolkit:Expander.Header>

                        <VerticalStackLayout Spacing="8" Padding="4,0,4,4">
                            <controlsUI:TitledEntryLight Title="Nombre" Text="{Binding SelectedConnection.Name}"/>
                            <controlsUI:TitledEntryLight Title="Host" Text="{Binding SelectedConnection.Host}"/>
                            <controlsUI:TitledEntryLight Title="Host Dump" Text="{Binding SelectedConnection.HostDump}"/>
                            <controlsUI:TitledEntryLight Title="Host Dump ApiKey" Text="{Binding SelectedConnection.HostDumpApiKey}" IsPassword="True" AllowPasswordMode="True"/>
                            <controlsUI:TitledEntryLight Title="Dump Service" Text="{Binding SelectedConnection.DumpService}"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <controlsUI:TitledEntryLight Grid.Column="0" Title="Prefix" Text="{Binding SelectedConnection.prefix_db}"/>
                                <controlsUI:TitledEntryLight Grid.Column="1" Title="Database Name" Text="{Binding SelectedConnection.DbName}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <controlsUI:TitledEntryLight Grid.Column="0" Title="DB Limit Default" Text="{Binding SelectedConnection.DbLimitDefault}"/>
                                <controlsUI:TitledEntryLight Grid.Column="1" Title="Tolerancy Days" Text="{Binding SelectedConnection.DataToleranceDays}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <controlsUI:TitledEntryLight Grid.Column="0" Title="Company Id" Text="{Binding SelectedConnection.CompanyId}"/>
                                <controlsUI:TitledEntryLight Grid.Column="1" Title="Sale Channel" Text="{Binding SelectedConnection.sale_channel_default}"/>
                                <controlsUI:TitledEntryLight Grid.Column="2" Title="Center Id" Text="{Binding SelectedConnection.res_center_default}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <controlsUI:TitledEntryLight Grid.Column="0" Title="Project Id" Text="{Binding SelectedConnection.project_id}"/>
                                <controlsUI:TitledEntryLight Grid.Column="1" Title="Project Stage Id" Text="{Binding SelectedConnection.stage_id}"/>
                            </Grid>

                            <controlsUI:TitledEntryLight Title="Username" Text="{Binding SelectedConnection.Username}"/>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <controlsUI:TitledEntryLight Grid.Column="0"
                                    x:Name="EntryPasswordDb"
                                    Title="Password"
                                    IsPassword="True"
                                    AllowPasswordMode="True"
                                    Text="{Binding SelectedConnection.Password, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Clicked="btnEncrypt_Clicked" BackgroundColor="BlueViolet" HeightRequest="44" WidthRequest="44" VerticalOptions="End">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="18" Glyph="&#xf0e7;" />
                                    </Button.ImageSource>
                                </Button>
                                <Button Grid.Column="2" Clicked="btnDecrypt_Clicked" BackgroundColor="BlueViolet" HeightRequest="44" WidthRequest="44" VerticalOptions="End">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="18" Glyph="&#xf0e7;" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>

                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                                <HorizontalStackLayout Margin="0,0,12,6">
                                    <Label Text="Active" VerticalOptions="Center" FontSize="12"/>
                                    <Switch IsToggled="{Binding SelectedConnection.Active}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Margin="0,0,12,6">
                                    <Label Text="Production" VerticalOptions="Center" FontSize="12"/>
                                    <Switch IsToggled="{Binding SelectedConnection.IsProduction}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Margin="0,0,12,6">
                                    <Label Text="Test Mode" VerticalOptions="Center" FontSize="12"/>
                                    <Switch IsToggled="{Binding SelectedConnection.IsTestMode}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Margin="0,0,12,6">
                                    <Label Text="Load Email" VerticalOptions="Center" FontSize="12"/>
                                    <Switch IsToggled="{Binding SelectedConnection.preload_email_domain}" />
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <Label Text="Conexiones guardadas" FontAttributes="Bold" FontSize="13" Margin="4,4,4,0"/>
                    <CollectionView ItemsSource="{Binding ConnectionsItems}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="Transparent" BorderColor="Gray" CornerRadius="5" Padding="8" Margin="2,4" InputTransparent="True" HasShadow="False">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Host}" FontSize="12" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DbName}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <FlexLayout Grid.Row="1"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="End"
                        AlignItems="Center">
                <Button Text="Cerrar" Padding="12,0" Margin="4,2" Clicked="btnClose_Clicked" BackgroundColor="BlueViolet">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="16" Glyph="&#xf060;" />
                    </Button.ImageSource>
                </Button>
                <Button Text="Save" Command="{Binding SaveCommand}" BackgroundColor="DodgerBlue" Padding="12,0" Margin="4,2"/>
                <Button Text="New" Command="{Binding NewCommand}" BackgroundColor="CadetBlue" Padding="12,0" Margin="4,2"/>
                <Button Text="Delete" Command="{Binding DeleteCommand}" BackgroundColor="Red" Padding="12,0" Margin="4,2"/>
            </FlexLayout>

            <Label Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   HorizontalOptions="Center"
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   TextColor="Red"/>
        </Grid>
    </ContentPage>

    <ContentPage Title="Modo Offline" BackgroundColor="White">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16" VerticalOptions="Start">
                <Label Text="Usar modo offline" FontSize="Medium" />
                <Switch IsToggled="{Binding IsOfflineMode}" />
                <Label Text="Cuando está activado, la aplicación trabajará sin conexión a servidor."
                       FontSize="Small" TextColor="Gray" LineBreakMode="WordWrap"/>
                <controlsUI:TitledEntryLight x:Name="lblDbPath" Title="Path"/>
                <Button Text="Rehacer configuración"
                        Padding="10,8"
                        Clicked="btnRebuildSettings_Clicked"
                        BackgroundColor="BlueViolet"
                        TextColor="White"
                        HorizontalOptions="Start">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="18" Glyph="&#xe05e;" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage Title="Base de datos" BackgroundColor="White">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6" Padding="8">
            <Picker x:Name="pickerDb"
                    Grid.Row="0"
                    Title="Seleccione Base de datos..."
                    ItemsSource="{Binding dbStructItems}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedIndexChanged="DbPicker_SelectedIndexChanged"/>

            <ScrollView Grid.Row="1" Orientation="Horizontal">
                <HorizontalStackLayout Spacing="6">
                    <Button Text="Actualizar" Padding="10,0" Clicked="btnDBTask_Reload" BackgroundColor="LimeGreen" TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="16" Glyph="&#xf021;" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="Compact" Padding="10,0" Clicked="btnDBTask_Compact" BackgroundColor="BlueViolet" TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="16" Glyph="&#xf71e;" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="Enviar" Padding="10,0" Clicked="btnUploadDB_Clicked" BackgroundColor="MediumVioletRed" TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="16" Glyph="&#xf093;" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="Restaurar" Padding="10,0" Clicked="btnDownloadDb_Clicked" BackgroundColor="Orange" TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid" Color="White" Size="16" Glyph="&#xf019;" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Tables}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2">
                            <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding .}" VerticalOptions="Center" LineBreakMode="MiddleTruncation"/>
                                <Button BackgroundColor="Red" TextColor="White" Text="Eliminar" Grid.Column="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTableCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage>
</TabbedPage>
