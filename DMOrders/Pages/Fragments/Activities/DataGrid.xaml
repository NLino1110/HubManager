<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             
             xmlns:vm="clr-namespace:DMOrders.Pages.Fragments.Activities"             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:converters="clr-namespace:DMOrders.Converters"
             xmlns:customrows="clr-namespace:DMOrders.Controls.CustomRows"
             xmlns:local="clr-namespace:DMOrders.Pages.Fragments.Activities"
             x:Class="DMOrders.Pages.Fragments.Activities.DataGrid"
             x:Name="ActivitiesDataGrid">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Grid.Column="1" BackgroundColor="LightGray" ColumnSpacing="10" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Text="ID" FontAttributes="Bold" FontSize="11" TextColor="Black"/>
            <Label Text="VENDEDOR" Grid.Column="1" FontAttributes="Bold" FontSize="11" TextColor="Black"/>
            <Label Text="FECHA REP." Grid.Column="2" FontAttributes="Bold" FontSize="11" TextColor="Black"/>
            <Label Text="FECHA SINC." Grid.Column="3" FontAttributes="Bold"  FontSize="11" TextColor="Black"/>
            <Label Text="USUARIO" Grid.Column="4" FontAttributes="Bold"  FontSize="11" TextColor="Black"/>
            <Label Text="ESTADO" Grid.Column="5" FontAttributes="Bold" FontSize="11" TextColor="Black"/>
            <Label Text="-" Grid.Column="6" FontAttributes="Bold" FontSize="11" TextColor="Black"/>
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView 
                    x:Name="MyCollectionView"
                    ItemsSource="{Binding ItemsData}" 
                                EmptyView="No hay tareas diarias ingresadas..." 
                                HorizontalOptions="Fill" 
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectionChanged="MyCollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <customrows:ActivityRow 
                                Item="{x:Binding .}" 
                                EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=EditCommand}">                                
                            </customrows:ActivityRow>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                BackgroundColor="#80000000"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                ZIndex="10">
                <ActivityIndicator 
                    IsRunning="{Binding IsLoading}" 
                    Color="MediumVioletRed"
                    WidthRequest="100"
                    HeightRequest="100"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <StackLayout Grid.Row="2"  Orientation="Horizontal" HorizontalOptions="Center" Margin="0,2">
            <Button Text=""
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}">
                <Button.ImageSource>
                    <FontImageSource x:Name="IconPrevious"
                        Color="Black"
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Skip_previous}" />
                </Button.ImageSource>
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter TargetName="IconPrevious" Property="FontImageSource.Color" Value="DarkGray" />
                    </Trigger>
                </Button.Triggers>
            </Button>

            <Label Text="{Binding Page}" VerticalOptions="Center" Margin="5" />
            <Label Text="/" VerticalOptions="Center" Margin="2"/>
            <Label Text="{Binding TotalPages}" VerticalOptions="Center" Margin="5"/>

            <Button Text="" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}">
                <Button.ImageSource>
                    <FontImageSource x:Name="IconNext"
                         Size="18"
                         FontFamily="MaterialSharp"
                         Glyph="{x:Static uranium:MaterialSharp.Skip_next}"
                         Color="Black" />
                </Button.ImageSource>
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter TargetName="IconNext" Property="FontImageSource.Color" Value="DarkGray" />
                    </Trigger>
                </Button.Triggers>
            </Button>
        </StackLayout>
    </Grid>
</ContentView>
