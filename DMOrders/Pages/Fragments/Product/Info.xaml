<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMOrders.Pages.Fragments.Product.Info"
             x:Name="info"             
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui">

    <ScrollView BackgroundColor="{StaticResource SurfaceVariant}">
        <StackLayout Padding="0,0,0,10">
            <!--<Label BackgroundColor="{StaticResource ActiveRowColor}" Text="Informacion" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>-->
        
        <Grid ColumnDefinitions="*,*" 
            RowSpacing="0"
            Padding="0"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            
            <Label Grid.Row="1"
                   Grid.ColumnSpan="2"
                   FontSize="12"
                   FontAttributes="Bold"
                   x:Name="LabelTitle" 
                   Text="ARTICULO - #" 
                   LineBreakMode="WordWrap"
                   MaxLines="3"
                   HorizontalOptions="Center"                   
                   TextColor="{StaticResource OnTertiaryContainer}"
                   MaximumWidthRequest="240"/>
            <Label Grid.Row="2" Grid.Column="0" Text="Codigo:" Padding="3" Margin="0"/>
            <Label Grid.Row="2" Grid.Column="1" x:Name="tipIden" Text="-" Padding="3" Margin="0"/>
            <Label Grid.Row="3" Grid.Column="0" Text="Marca:" />
            <Label Grid.Row="3" Grid.Column="1" x:Name="vat" Text="-" />
            <Label Grid.Row="4" Grid.Column="0" Text="Linea/Categoria:" />
            <Label Grid.Row="4" Grid.Column="1" x:Name="telephone" Text="-" />
            <Label Grid.Row="5" Grid.Column="0" Text="Incluye IVA:" />
            <Label Grid.Row="5" Grid.Column="1" x:Name="channel" Text="-" />
            <Label Grid.Row="6" Grid.Column="0" Text="Calcula IVA:" />
            <Label Grid.Row="6" Grid.Column="1" x:Name="seller" Text="-" />
            <Label Grid.Row="7" Grid.Column="0" Text="Disponible Venta:" />
            <Label Grid.Row="7" Grid.Column="1" x:Name="status" Text="-" />

            <Label Grid.Row="8" Grid.ColumnSpan="2" FontAttributes="Bold" Text="STOCK BODEGAS" Padding="0,10,0,0"/>
            <Label Grid.Row="9" Grid.Column="0" Text="BOD. PRINCIPAL:" />
            <Label Grid.Row="9" Grid.Column="1" x:Name="calif" Text="-" />
            <Label Grid.Row="10" Grid.Column="0" Text="DEMUJERES S.A.:" />
            <Label Grid.Row="10" Grid.Column="1" x:Name="cupo" Text="-" />
            <Label Grid.Row="11" Grid.Column="0" Text="PRECIOS:" />
            <Label Grid.Row="11" Grid.Column="1" x:Name="obs" Text="-" />
            <Label Grid.Row="12" Grid.Column="0" Text="MAYORISTA UNIDAD:" />
            <Label Grid.Row="12" Grid.Column="1" x:Name="days" Text="-" />
                <Label Grid.Row="13" Grid.Column="0" Text="DISTRIBUIDOR UNIDAD:" />
                <Label Grid.Row="13" Grid.Column="1" x:Name="dayszzz" Text="-" />
                <StackLayout Grid.Row="14" 
                       Grid.ColumnSpan="2" 
                       Padding="4,4,4,4">
                    <Image x:Name="productImage"
                           HorizontalOptions="Fill"
                           BackgroundColor="WhiteSmoke"                           
                           HeightRequest="130"></Image>
                </StackLayout>
            </Grid>
        </StackLayout>
    </ScrollView>
</ContentView>
