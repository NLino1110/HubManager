<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="DMOrders.Pages.Fragments.Orders.modals.CatalogViewerInner"            
            xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
            xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
            xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
            xmlns:converters="clr-namespace:DMOrders.Converters"             
            xmlns:local="clr-namespace:DMOrders.Pages.Fragments.Orders.modals"       
            xmlns:customrows="clr-namespace:DMOrders.Controls.CustomRows"
            xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
            xmlns:controls="clr-namespace:DMOrders.Controls"
            xmlns:mpowerkit="clr-namespace:MPowerKit.VirtualizeListView;assembly=MPowerKit.VirtualizeListView"
            xmlns:odoo="clr-namespace:DMSA.Models.Odoo.Native;assembly=DMSA.Models.Odoo" 
            ZIndex="1000"
            x:Name="Root">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>

        <!--<DataTemplate x:Key="RowTemplate">
            <customrows:ProductRow Item="{Binding .}" ActionButton="{Binding Source={x:Reference Root}, Path=ItemPickedCommand}" ShowSelectButton="True"/>
        </DataTemplate>

        <DataTemplate x:Key="GridTemplate">
            <customrows:ProductCanvasRow Item="{Binding .}" ActionButton="{Binding Source={x:Reference Root}, Path=ItemPickedCommand}" ShowSelectButton="True"/>
        </DataTemplate>

        <DataTemplate x:Key="ViewerTemplate">
            <customrows:ProductViewerRow Item="{Binding .}"/>
        </DataTemplate>

        <local:ProductTemplateSelector x:Key="ProductTemplateSelector"
                                   ViewerTemplate="{StaticResource ViewerTemplate}"
                                   RowTemplate="{StaticResource RowTemplate}"
                                   GridTemplate="{StaticResource GridTemplate}" />-->

        <DataTemplate x:Key="RowTemplate">            
            <mpowerkit:VirtualizeListViewCell BackgroundColor="WhiteSmoke">
                
                <customrows:ProductRow 
            Item="{Binding .}" 
            ActionButton="{Binding Source={x:Reference Root}, Path=ItemPickedCommand}" 
            ShowSelectButton="True"/>
                <mpowerkit:VirtualizeListViewCell.Triggers>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="LightBlue"/>
                    </DataTrigger>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="BackgroundColor" Value="WhiteSmoke"/>
                    </DataTrigger>
                </mpowerkit:VirtualizeListViewCell.Triggers>
            </mpowerkit:VirtualizeListViewCell>
        </DataTemplate>

        <DataTemplate x:Key="GridTemplate">
            <mpowerkit:VirtualizeListViewCell BackgroundColor="WhiteSmoke">
                <customrows:ProductCanvasRow 
            Item="{Binding .}" 
            ActionButton="{Binding Source={x:Reference Root}, Path=ItemPickedCommand}" 
            ShowSelectButton="True" ShowPrice="True"/>
                <mpowerkit:VirtualizeListViewCell.Triggers>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="LightBlue"/>
                    </DataTrigger>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="BackgroundColor" Value="WhiteSmoke"/>
                    </DataTrigger>
                </mpowerkit:VirtualizeListViewCell.Triggers>
            </mpowerkit:VirtualizeListViewCell>
        </DataTemplate>

        <DataTemplate x:Key="ViewerTemplate">
            <mpowerkit:VirtualizeListViewCell BackgroundColor="WhiteSmoke">
                <customrows:ProductViewerRow Item="{Binding .}"/>
                <mpowerkit:VirtualizeListViewCell.Triggers>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="LightBlue"/>
                    </DataTrigger>
                    <DataTrigger TargetType="mpowerkit:VirtualizeListViewCell" Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="BackgroundColor" Value="WhiteSmoke"/>
                    </DataTrigger>
                </mpowerkit:VirtualizeListViewCell.Triggers>
            </mpowerkit:VirtualizeListViewCell>
        </DataTemplate>

        <local:ProductTemplateSelector x:Key="ProductTemplateSelector"
            ViewerTemplate="{StaticResource ViewerTemplate}"
            RowTemplate="{StaticResource RowTemplate}"
            GridTemplate="{StaticResource GridTemplate}" />

    </ContentView.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="WhiteSmoke">
        
        <Grid BackgroundColor="Black" RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto" Grid.Row="0">
            <Button Grid.Row="0" Text="" 
                    Grid.Column="0" 
                    TextColor="GhostWhite"
                    BackgroundColor="Transparent"
                    Clicked="OnCloseClicked">
                <Button.ImageSource>
                    <FontImageSource
                        Color="White"
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Arrow_back}" />
                </Button.ImageSource>
            </Button>
            <Label Grid.Row="0" Grid.Column="1" Margin="-60,0,0,0"
                   Text="Seleccione Productos para pedido" 
                   TextColor="WhiteSmoke" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
            </Label>
            <Button Grid.Row="0" Text="" 
                Grid.Column="2" 
                TextColor="GhostWhite"
                BackgroundColor="Transparent"
                Clicked="OnCloseClicked">
                <Button.ImageSource>
                    <FontImageSource
                        Color="White"
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Close}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Grid Parametros -->
        <Grid BackgroundColor="WhiteSmoke" 
              RowDefinitions="Auto,Auto,Auto" 
              ColumnDefinitions="*,*,Auto" 
              Grid.Row="1" ColumnSpacing="5" RowSpacing="0"
              Padding="5">

            <material:TextField
                Grid.Row="0"
                FontSize="11"
                x:Name="TextCode"
                Title="Código producto"
                BorderThickness="0.4"                
                Margin="0"
                Padding="0"
                PropertyChanged="TextCode_PropertyChanged"/>

            <material:TextField
                Grid.Row="1"
                FontSize="11"
                x:Name="TextDescription"
                Title="Descripción"
                BorderThickness="0.4"
                 PropertyChanged="TextDescription_PropertyChanged"/>

            <material:DropdownField 
                x:Name="ddfBrands"
                Title="Marcas"
                FontSize="11"
                AllowClear="True" 
                StyleClass="ControlPreview"
                BorderThickness="0.4"
                Grid.Row="2">
                <material:DropdownField.Icon>
                    <FontImageSource Size="18" FontFamily="MaterialRounded" Glyph="{x:Static uranium:MaterialRounded.Health_and_beauty}"  />
                </material:DropdownField.Icon>
            </material:DropdownField>

            <material:DropdownField 
                    Grid.Row="0"
                Grid.Column="1"
                    x:Name="ddfNews"
                    Title="Nuevos"
                    FontSize="11"
                    AllowClear="True" 
                    StyleClass="ControlPreview"
                    BorderThickness="0.4">
                <material:DropdownField.Icon>
                    <FontImageSource
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Category}" />
                </material:DropdownField.Icon>
            </material:DropdownField>

            <material:DropdownField 
                    Grid.Row="1"
                    Grid.Column="1"
                    x:Name="ddfStock"
                    Title="Stock"
                    FontSize="11"
                    AllowClear="True" 
                    StyleClass="ControlPreview"
                    BorderThickness="0.4">
                <material:DropdownField.Icon>
                    <FontImageSource
                    Size="18"
                    FontFamily="MaterialSharp"
                    Glyph="{x:Static uranium:MaterialSharp.Category}" />
                </material:DropdownField.Icon>
            </material:DropdownField>

            <material:DropdownField 
                Grid.Row="2"
                Grid.Column="1"
                x:Name="ddfSort"
                Title="Orden"
                FontSize="11"
                AllowClear="True" 
                StyleClass="ControlPreview"
                BorderThickness="0.4">
                <material:DropdownField.Icon>
                    <FontImageSource
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Category}" />
                </material:DropdownField.Icon>
            </material:DropdownField>

            <input:SelectionView
                Grid.Row="0"
                Grid.Column="3"
                Color="Gray"
                ItemDisplayBinding="{Binding name}"
                ItemsSource="{Binding viewModesList}"
                SelectedIndex="{Binding ViewModesListSelectedIndex}"
                PropertyChanged="SelectionView_PropertyChanged"
                ColumnNumber="4"
                Padding="7">
            </input:SelectionView>

            <Button x:Name="btnClear" 
                    Text="Limpiar" 
                    FontSize="10" 
                    BackgroundColor="Gray" 
                    TextColor="White" 
                    Grid.Row="1"
                    Grid.Column="2"
                    Clicked="btnClear_Clicked">
                <Button.ImageSource>
                    <FontImageSource 
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Filter_list_off}" />
                </Button.ImageSource>
            </Button>

            <Button x:Name="btnSearch" 
                    Text="Buscar" 
                    FontSize="10" 
                    BackgroundColor="IndianRed"  
                    TextColor="White" 
                    Grid.Row="2"
                    Grid.Column="2"
                    Command="{Binding RefreshCommand}">
                <Button.ImageSource>
                    <FontImageSource 
            Size="18"
            FontFamily="MaterialSharp"
            Glyph="{x:Static uranium:MaterialSharp.Search}" />
                </Button.ImageSource>
            </Button>

            <!--<material:RadioButtonGroupView>
                <material:RadioButton Text="Option 1" IsChecked="True" />
                <material:RadioButton Text="Option 2" />
            </material:RadioButtonGroupView>-->
        </Grid>

        <Grid RowDefinitions="Auto,*" Grid.Row="2">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </Grid.GestureRecognizers>
            <Grid x:Name="GridTitleSearch" RowDefinitions="*" ColumnDefinitions="2*,*,*,*,*,Auto" BackgroundColor="LightGray">
                <Label Grid.Column="0" Text="Producto" FontAttributes="Bold" HorizontalTextAlignment="Start"></Label>
                <Label Grid.Column="1" Text="Unidad" FontAttributes="Bold" HorizontalTextAlignment="Start"></Label>
                <Label Grid.Column="2" Text="Precio" FontAttributes="Bold"  HorizontalTextAlignment="Start"></Label>
                <Label Grid.Column="3" Text="Stock" FontAttributes="Bold"  HorizontalTextAlignment="Start"></Label>
                <Label Grid.Column="4" Text="Pre. Base" FontAttributes="Bold"  HorizontalTextAlignment="Start" IsVisible="False"></Label>                
            </Grid>
            
            <!--<CollectionView
                    Grid.Row="1"
                    x:Name="MyCollectionView"
                    ItemsSource="{Binding ItemsData}"
                    EmptyView="Datos no encontrados..." 
                    HorizontalOptions="Fill" 
                    VerticalOptions="Fill"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"                    
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    ItemTemplate="{StaticResource ProductTemplateSelector}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" />
                </CollectionView.ItemsLayout>
            </CollectionView>-->

            <Grid Grid.Row="1">
                <mpowerkit:FixedRefreshView                    
                HorizontalOptions="Fill" 
                VerticalOptions="Fill"
                IsPullToRefreshEnabled="False">
                    <mpowerkit:VirtualizeListView 
                x:Name="listViewProduct"
                ItemsSource="{Binding ItemsData}"                
                Padding="0"                        
                BackgroundColor="Gray" 
                        ItemTemplate="{StaticResource ProductTemplateSelector}"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">                        
                        <mpowerkit:VirtualizeListView.ItemsLayout>
                            <mpowerkit:GridLayout HorizontalItemSpacing="1" Span="4" VerticalItemSpacing="1" />
                        </mpowerkit:VirtualizeListView.ItemsLayout>                        
                    </mpowerkit:VirtualizeListView>
                </mpowerkit:FixedRefreshView>

                <Grid
                    BackgroundColor="#80000000"
                    IsVisible="{Binding IsLoading}"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    ZIndex="10">
                    <ActivityIndicator 
                        IsRunning="{Binding IsLoading}" 
                        Color="MediumVioletRed"
                        WidthRequest="100"
                        HeightRequest="100"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />
                </Grid>
            </Grid>

        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <StackLayout Orientation="Horizontal" HorizontalOptions="Start" Margin="0,2" Grid.Column="0">
                <Button Text=""
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" >
                    <Button.ImageSource>
                        <FontImageSource x:Name="IconPrevious"
                            Color="Black"
                            Size="18"
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static uranium:MaterialSharp.Skip_previous}" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter TargetName="IconPrevious" Property="FontImageSource.Color" Value="DarkGray" />
                        </Trigger>
                    </Button.Triggers>
                </Button>

                <Label Text="{Binding Page}" VerticalOptions="Center" Margin="5" />
                <Label Text="/" VerticalOptions="Center" Margin="2"/>
                <Label Text="{Binding TotalPages}" VerticalOptions="Center" Margin="5"/>

                <Button Text=""
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}">
                    <Button.ImageSource>
                        <FontImageSource x:Name="IconNext"
             Size="18"
             FontFamily="MaterialSharp"
             Glyph="{x:Static uranium:MaterialSharp.Skip_next}"
             Color="Black" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter TargetName="IconNext" Property="FontImageSource.Color" Value="DarkGray" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>

            <Button Text=""
                Clicked="SelectSingleItem"
                HorizontalOptions="End"
                BackgroundColor="DodgerBlue"
                Grid.Column="1"
                x:Name="SelectButtonUnique">
                <Button.ImageSource>
                    <FontImageSource
                     Size="18"
                     FontFamily="MaterialSharp"
                     Glyph="{x:Static uranium:MaterialSharp.Check}"
                     Color="White" />
                </Button.ImageSource>
            </Button>
        </Grid>
        <controls:ConfettiOverlay x:Name="Confetti" 
                                  HorizontalOptions="Fill"
                              VerticalOptions="Fill" Grid.RowSpan="4"/>
    </Grid>
</ContentView>
