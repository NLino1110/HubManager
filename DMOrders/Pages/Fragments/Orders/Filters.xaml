<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeebTech.Maui.Controls;assembly=BeebTech.Maui.Controls"
             x:Class="DMOrders.Pages.Fragments.Orders.Filters"
             x:Name="mainpage"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui">
    
    <VerticalStackLayout Padding="3">
        <Label Text="Filtros" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="3"/>
        
        <Grid ColumnDefinitions="*" RowSpacing="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <material:DropdownField x:Name="ddfStatus"
                    Title="Estado" 
                                    FontSize="11"
                    AllowClear="False" 
                    StyleClass="ControlPreview"
                                    BorderThickness="0.4"
                    Grid.Row="0">
                
            </material:DropdownField>

            <material:DatePickerField
                Title="Desde"
                Grid.Row="1"
                x:Name="datePickerStart"
                Icon="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static m:MaterialSharp.Calendar_month}}">
            </material:DatePickerField>

            <material:DatePickerField
                Title="Hasta"
                Grid.Row="2"
                x:Name="datePickerEnd"
                Icon="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static m:MaterialSharp.Calendar_month}}">
            </material:DatePickerField>

            <material:DropdownField 
                x:Name="ddfCustomer"
                Title="Cliente"
                FontSize="11"
                AllowClear="True"
                StyleClass="ControlPreview"
                BorderThickness="0.4"
                Grid.Row="3"
                MaximumWidthRequest="240">
                <material:DropdownField.Icon>
                    <FontImageSource
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Category}" />
                </material:DropdownField.Icon>
            </material:DropdownField>
            
            <material:TextField
                Grid.Row="4"
                FontSize="11"
                x:Name="entryDocNumber"
                Title="No. Pedido"
                BorderThickness="0.4"
                Keyboard="Numeric"                
                Margin="0"
                Padding="0"                
                />
        </Grid>
            
        <HorizontalStackLayout 
            Spacing="10" 
            Margin="5,2,5,0"
            AbsoluteLayout.LayoutFlags="PositionProportional"
                                AbsoluteLayout.LayoutBounds="0.5, 0.9, 1, 0.1">
            <Button x:Name="btnClear" Text="Limpiar" FontSize="10" BackgroundColor="Gray" TextColor="White" Clicked="btnClear_Clicked">
                <Button.ImageSource>
                    <FontImageSource 
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Remove_done}" />
                </Button.ImageSource>
            </Button>

            <Button x:Name="btnSearch" Text="Buscar" FontSize="10" BackgroundColor="IndianRed"  TextColor="White" Clicked="Button_Clicked">
                <Button.ImageSource>
                    <FontImageSource 
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Search}" />
                </Button.ImageSource>
            </Button>
        </HorizontalStackLayout>
    </VerticalStackLayout>    
</ContentView>