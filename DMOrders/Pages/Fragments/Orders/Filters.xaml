<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BeebTech.Maui.Controls;assembly=BeebTech.Maui.Controls"
             xmlns:beebtech="clr-namespace:BeebTech.Controls.UI;assembly=BeebTech.Controls"
             x:Class="DMOrders.Pages.Fragments.Orders.Filters"
             x:Name="mainpage"             
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui">
    
    <VerticalStackLayout Padding="3">
        <Label Text="Filtros" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="3"/>
        
        <Grid ColumnDefinitions="*" RowSpacing="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <beebtech:DropdownField x:Name="ddfStatus"
                    Title="Estado" 
                                    FontSize="11"
                    AllowClear="False" 
                    StyleClass="ControlPreview"
                                    BorderThickness="0.4"
                    Grid.Row="0">
                
            </beebtech:DropdownField>

            <DatePicker                
                Grid.Row="1"
                x:Name="datePickerStart">
            </DatePicker>

            <DatePicker                
                Grid.Row="2"
                x:Name="datePickerEnd">
            </DatePicker>

            <beebtech:DropdownField 
                x:Name="ddfCustomer"
                Title="Cliente"
                FontSize="11"
                AllowClear="True"
                StyleClass="ControlPreview"
                BorderThickness="0.4"
                Grid.Row="3"
                MaximumWidthRequest="240">
                <beebtech:DropdownField.Icon>
                    <FontImageSource
                        Size="15"
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf508;" />
                </beebtech:DropdownField.Icon>
            </beebtech:DropdownField>

            <beebtech:TextField
                Grid.Row="4"
                FontSize="11"
                x:Name="entryDocNumber"
                Title="No. Pedido"
                BorderThickness="0.4"
                Keyboard="Numeric"                
                Margin="0"
                Padding="0"                
                />
        </Grid>
            
        <HorizontalStackLayout 
            Spacing="10" 
            Margin="5,2,5,0"
            AbsoluteLayout.LayoutFlags="PositionProportional"
                                AbsoluteLayout.LayoutBounds="0.5, 0.9, 1, 0.1">
            <Button x:Name="btnClear" Text="Limpiar" FontSize="10" BackgroundColor="Gray" TextColor="White" Clicked="btnClear_Clicked">
                <Button.ImageSource>
                    <FontImageSource 
                        Size="15"
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xe05e;" />
                </Button.ImageSource>
            </Button>

            <Button x:Name="btnSearch" Text="Buscar" FontSize="10" BackgroundColor="IndianRed"  TextColor="White" Clicked="Button_Clicked">
                <Button.ImageSource>
                    <FontImageSource 
                        Size="15"
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf002;" />
                </Button.ImageSource>
            </Button>
        </HorizontalStackLayout>
    </VerticalStackLayout>    
</ContentView>