<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMOrders.Pages.Fragments.Orders"             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"              
             xmlns:converters="clr-namespace:DMOrders.Converters"
             xmlns:customrows="clr-namespace:DMOrders.Controls.CustomRows"
             xmlns:local="clr-namespace:DMOrders.Pages.Fragments.Orders"
             xmlns:bh="clr-namespace:DMOrders.Controls.Behaviors"
             x:Class="DMOrders.Pages.Fragments.Orders.DataGrid"
             x:Name="ActivitiesDataGrid">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:DateToDashConverter x:Key="DateConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        
        <Grid Grid.Row="0"            
            ColumnSpacing="5"
            ColumnDefinitions="70,350,*,*,*,*,100"
            RowDefinitions="*"                
            BackgroundColor="LightGray"              
            Padding="0" 
            HeightRequest="35">
            <Label Grid.Column="0" FontAttributes="Bold" Text="No." FontSize="11" TextColor="Black" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
            <Label Grid.Column="1" FontAttributes="Bold" Text="CLIENTE" FontSize="11" TextColor="Black" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
            <Label Grid.Column="2" FontAttributes="Bold" Text="FEC. ORD." FontSize="11" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <Label Grid.Column="3" FontAttributes="Bold" Text="FEC. SINC" FontSize="11" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <Label Grid.Column="4" FontAttributes="Bold" Text="TOTAL" FontSize="11" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <Label Grid.Column="5" FontAttributes="Bold" Text="ESTADO" FontSize="11" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <Label Grid.Column="6" FontAttributes="Bold" Text="-" FontSize="11" TextColor="Black" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
        </Grid>        

        <Grid Grid.Row="1">            
            <CollectionView 
                    x:Name="MyCollectionView"
                    ItemsSource="{Binding ItemsData}" 
                                EmptyView="No existen resultados..." 
                                HorizontalOptions="Fill" 
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectionChanged="MyCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        
                        <Grid Grid.Column="0"
                            VerticalOptions="Center"
                            ColumnSpacing="10"
                            ColumnDefinitions="70,350,*,*,*,*,100"
                            RowDefinitions="*,*"
                            Margin="0,0,0,0"
                              Padding="0" Style="{StaticResource CollectionItemSelectable}">

                            <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                                <Label
                                    FontAttributes="Bold"
                                    Text="{Binding erp_name}"
                                    FontSize="9"
                                    TextColor="Green" 
                                    VerticalOptions="Start"
                                    HorizontalOptions="Center"/>
                                <Label
                                    FontAttributes="Bold"
                                    Text="{Binding id}"
                                    FontSize="12"
                                    TextColor="Black" 
                                    VerticalOptions="Start"
                                    HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                                
                            <Label 
                                Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                Text="{Binding partner_display_name}"
                                FontSize="12"
                                TextColor="Black"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" 
                                VerticalOptions="Center"/>
                 
                            <Label 
                                Grid.Column="2"
                                Grid.Row="0"
                                Text="{Binding date_order}"
                                FontSize="12"
                                TextColor="Black"                                        
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"/>

                            <Label 
                                Grid.RowSpan="2"
                                Grid.Column="3" 
                                Text="{Binding date_synchronized, Converter={StaticResource DateConverter}}"
                                FontSize="12"
                                TextColor="DarkGreen"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"/>

                            <Label 
                                Grid.RowSpan="2"
                                Grid.Column="4" 
                                Text="{Binding amount_total, StringFormat='${0:N3}'}"
                                FontSize="12"
                                TextColor="Gray" 
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"/>

                            <Label 
                                Grid.RowSpan="2"
                                Grid.Column="5" 
                                Text="{Binding state_view}"
                                FontSize="12"
                                TextColor="Gray"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center">                                
                            </Label>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="9" IsVisible="{Binding is_synchronized, Converter={StaticResource InverseBoolConverter}}" Spacing="3">
                                <Button
                                        FontSize="10" 
                                        BackgroundColor="DodgerBlue" 
                                        TextColor="White" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="35"
                                        WidthRequest="35"                                    
                                        Padding="0">
                                    <!--<Button.Behaviors>
                                    <bh:SafeTapBehavior 
Command="{Binding Source={x:Reference ActivitiesDataGrid}, Path=BindingContext.EditCommand}"
CommandParameter="{Binding .}" />
                                </Button.Behaviors>-->
                                    <Button.ImageSource>
                                        <FontImageSource 
                                            Size="15"
                                            FontFamily="FontAwesome5Solid"
                                            Glyph="&#xf303;" />
                                    </Button.ImageSource>
                                </Button>

                                <Button
                                    FontSize="10" 
                                    BackgroundColor="OrangeRed" 
                                    TextColor="White" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="35"
                                    WidthRequest="35"
                                    Grid.Row="0"
                                    Grid.Column="9"
                                    Grid.RowSpan="3"
                                    Padding="0">
                                    <Button.ImageSource>
                                        <FontImageSource 
                                        Size="15"
                                        FontFamily="FontAwesome5Solid"
                                        Glyph="&#xf2ed;" />
                                    </Button.ImageSource>
                                </Button>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="9" IsVisible="{Binding is_synchronized}" Spacing="3">
                                <Button
                                        FontSize="10" 
                                        BackgroundColor="LimeGreen" 
                                        TextColor="White" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="35"
                                        WidthRequest="35" 
                                        Padding="0">
                                    <!--<Button.Behaviors>
                                        <bh:SafeTapBehavior Command="{Binding EditCommand}" />
                                    </Button.Behaviors>-->
                                    <Button.ImageSource>
                                        <FontImageSource 
                                            Size="15"
                                            FontFamily="FontAwesome5Solid"
                                            Glyph="&#xf06e;" />
                                    </Button.ImageSource>
                                </Button>

                                <Button
                                        FontSize="10" 
                                        BackgroundColor="LightGray" 
                                        TextColor="White"
                                        HeightRequest="35"
                                        WidthRequest="35"
                                        Grid.Row="0"
                                        Grid.Column="9"
                                        Grid.RowSpan="3"
                                        Padding="0"                                        
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=ResetCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.ImageSource>
                                        <FontImageSource 
                                            Size="15"
                                            FontFamily="FontAwesome5Solid"
                                            Glyph="&#xf192;" />
                                    </Button.ImageSource>
                                </Button>
                            </HorizontalStackLayout>

                            <BoxView Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="9"
                             HeightRequest="1"
                             BackgroundColor="#E0E0E0" Color="LightGrey"/>
                        </Grid>
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid    
                BackgroundColor="#80000000"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                ZIndex="10">
                <ActivityIndicator 
                    IsRunning="{Binding IsLoading}" 
                    Color="MediumVioletRed"
                    WidthRequest="100"
                    HeightRequest="100"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
      Margin="0,2"
      ColumnDefinitions="Auto, *"
      VerticalOptions="Center">

            <Button Grid.Column="0"
                    Clicked="ButtonSync_Clicked" 
            Text="Enviar"
            HorizontalOptions="Start"
            Margin="5,0" IsVisible="False"/>

            <Button Grid.Column="0"
                Clicked="GotoCustomers_Clicked" 
                BackgroundColor="DodgerBlue"
                TextColor="White"
                Text="Nuevo"
                HorizontalOptions="Start"
                Margin="5"
                Padding="10"
                CornerRadius="8">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesome5Solid"
                        Color="White"
                        Size="20"
                        FontAutoScalingEnabled="True"
                        Glyph="&#xf067;" />
                </Button.ImageSource>
            </Button>

            <Grid Grid.Column="1"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                  HorizontalOptions="End"
                  VerticalOptions="Center">
                <Button Grid.Column="0"
                Text=""
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}">
                    <Button.ImageSource>
                        <FontImageSource x:Name="IconPrevious"
                                 Color="Black"
                                 Size="18"
                                 FontFamily="FontAwesome5Solid"
                                 Glyph="&#xf104;" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter TargetName="IconPrevious"
                            Property="FontImageSource.Color"
                            Value="DarkGray" />
                        </Trigger>
                    </Button.Triggers>
                </Button>

                <Label Grid.Column="1"
                    Text="{Binding Page}"
                    VerticalOptions="Center"
                    Margin="5,0"/>

                <Label Grid.Column="2"
                    Text="/"
                    VerticalOptions="Center"
                    Margin="2,0"/>

                <Label Grid.Column="3"
                   Text="{Binding TotalPages}"
                   VerticalOptions="Center"
                   Margin="5,0"/>

                <Button Grid.Column="4"
                Text=""
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}">
                    <Button.ImageSource>
                        <FontImageSource x:Name="IconNext"
                                 Size="18"
                                 FontFamily="FontAwesome5Solid"
                                 Glyph="&#xf105;"
                                 Color="Black" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter TargetName="IconNext"
                            Property="FontImageSource.Color"
                            Value="DarkGray" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
