<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMOrders.Pages.Fragments.Orders"             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:converters="clr-namespace:DMOrders.Converters"
             xmlns:customrows="clr-namespace:DMOrders.Controls.CustomRows"
             xmlns:local="clr-namespace:DMOrders.Pages.Fragments.Orders"
             x:Class="DMOrders.Pages.Fragments.Orders.DataGrid"
             x:Name="ActivitiesDataGrid">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <Grid Grid.Row="0"
            VerticalOptions="Center"
            ColumnSpacing="5"
            ColumnDefinitions="20,200,*,*,*,*,*,20"
            RowDefinitions="*"                
          BackgroundColor="LightGray"              
          Padding="3" 
          HeightRequest="35">

            <Label Grid.Column="0" FontAttributes="Bold" Text="No." FontSize="11" TextColor="Black" HorizontalTextAlignment="Start"/>
            <Label Grid.Column="1" FontAttributes="Bold" Text="CLIENTE" FontSize="11" TextColor="Black" HorizontalTextAlignment="Start"/>
            <Label Grid.Column="2" FontAttributes="Bold" Text="Fec. Ord." FontSize="11" TextColor="Black" HorizontalTextAlignment="End"/>
            <Label Grid.Column="3" FontAttributes="Bold" Text="Fec. Sync" FontSize="11" TextColor="Black" HorizontalTextAlignment="End"/>
            <Label Grid.Column="4" FontAttributes="Bold" Text="Total" FontSize="11" TextColor="Black" HorizontalTextAlignment="End"/>
            <Label Grid.Column="5" FontAttributes="Bold" Text="Sync" FontSize="11" TextColor="Black" HorizontalTextAlignment="End"/>
            <Label Grid.Column="6" FontAttributes="Bold" Text="-" FontSize="11" TextColor="Black" WidthRequest="200" HorizontalTextAlignment="End"/>
        </Grid>
        

        <Grid Grid.Row="1">
            
            <CollectionView 
                    x:Name="MyCollectionView"
                    ItemsSource="{Binding ItemsData}" 
                                EmptyView="No existen resultados..." 
                                HorizontalOptions="Fill" 
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectionChanged="MyCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <customrows:SaleOrderRow
                                Item="{x:Binding .}" 
                                EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=EditCommand}"
                                DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=DeleteCommand}"
                                SelectedItem="{Binding BindingContext.SelectedItem, Source={x:Reference MyCollectionView}}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <Grid 
    
    BackgroundColor="#80000000"
    IsVisible="{Binding IsLoading}"
    VerticalOptions="Fill"
    HorizontalOptions="Fill"
    ZIndex="10">
                <ActivityIndicator 
        IsRunning="{Binding IsLoading}" 
        Color="MediumVioletRed"
        WidthRequest="100"
        HeightRequest="100"
        VerticalOptions="Center"
        HorizontalOptions="Center" />
            </Grid>

        </Grid>

        <StackLayout Grid.Row="2"  Orientation="Horizontal" HorizontalOptions="Center" Margin="0,2">
            <Button Text=""
            Command="{Binding PreviousPageCommand}"
            IsEnabled="{Binding CanGoPrevious}" >
                <Button.ImageSource>
                    <FontImageSource x:Name="IconPrevious"
                        Color="Black"
                        Size="18"
                        FontFamily="MaterialSharp"
                        Glyph="{x:Static uranium:MaterialSharp.Skip_previous}" />
                </Button.ImageSource>
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter TargetName="IconPrevious" Property="FontImageSource.Color" Value="DarkGray" />
                    </Trigger>
                </Button.Triggers>
            </Button>

            <Label Text="{Binding Page}" VerticalOptions="Center" Margin="5" />
            <Label Text="/" VerticalOptions="Center" Margin="2"/>
            <Label Text="{Binding TotalPages}" VerticalOptions="Center" Margin="5"/>

            <Button Text=""
            Command="{Binding NextPageCommand}"
            IsEnabled="{Binding CanGoNext}">
                <Button.ImageSource>
                    <FontImageSource x:Name="IconNext"
                         Size="18"
                         FontFamily="MaterialSharp"
                         Glyph="{x:Static uranium:MaterialSharp.Skip_next}"
                         Color="Black" />
                </Button.ImageSource>
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter TargetName="IconNext" Property="FontImageSource.Color" Value="DarkGray" />
                    </Trigger>
                </Button.Triggers>
            </Button>
        </StackLayout>
    </Grid>
</ContentView>
