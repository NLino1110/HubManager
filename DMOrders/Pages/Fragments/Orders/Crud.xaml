<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMOrders.Pages.Fragments.Orders.Crud"
             xmlns:converters="clr-namespace:DMOrders.Converters"
             xmlns:customrows="clr-namespace:DMOrders.Controls.CustomRows"
             xmlns:customrowsv2="clr-namespace:DMOrders.Controls.CustomRowsV2"
             xmlns:customrowsheaders="clr-namespace:DMOrders.Controls.CustomRows.Headers"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"             
             xmlns:modals="clr-namespace:DMOrders.Pages.Fragments.Orders.modals"
             x:Name="RootPage"
             Title="Pedido Nuevo - Edicion">
    <ContentPage.Resources>
        <ResourceDictionary>
            <OnPlatform x:Key="IsBackButtonEnabled" x:TypeArguments="x:Boolean">
                <On Platform="Android" Value="False" />
                <On Platform="iOS" Value="True" />
                <On Platform="WinUI" Value="True" />
            </OnPlatform>            
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />            
        </ResourceDictionary>
    </ContentPage.Resources>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="{StaticResource IsBackButtonEnabled}" IsVisible="{StaticResource IsBackButtonEnabled}"/>
    </Shell.BackButtonBehavior>

    <Grid ColumnDefinitions="Auto,*">
        <modals:CatalogViewerInner x:Name="SearchProductView" 
                   IsVisible="False"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   ItemPickedCommand="{Binding BindingContext.AddLineCommand,Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                   ItemPickedByQtyCommand="{Binding BindingContext.AddLineCommandByQty,Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                   CurrentPriceList="{Binding CurrentPriceList,Source={RelativeSource AncestorType={x:Type ContentPage}}}">            
        </modals:CatalogViewerInner>

        <Grid Grid.Row="0" 
                  Grid.Column="0"
                 Padding="10"
                 RowDefinitions="Auto,Auto" 
                 WidthRequest="220">

            <Button Grid.Row="0" Text="" Clicked="ButtonClose_Clicked" BackgroundColor="Gray" TextColor="White" HeightRequest="43" WidthRequest="43" Padding="0">
                <Button.ImageSource>
                    <FontImageSource 
            Size="30"
            FontFamily="MaterialSharp"
            Glyph="{x:Static uranium:MaterialSharp.Arrow_back}"/>
                </Button.ImageSource>
            </Button>
            
            <Grid Grid.Row="1" 
                  Grid.Column="0" 
                  Padding="10"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                  WidthRequest="220"
                  IsEnabled="{Binding LockEdition, Converter={StaticResource InverseBoolConverter}, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

                
            
                <Grid Grid.Row="1" 
                        ColumnDefinitions="*,*" 
                        RowSpacing="4" 
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        Padding="5">

                    <Label Grid.Row="0" x:Name="labelGifInfo" Text="Regalo no editable." 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="Orange" 
                           Grid.ColumnSpan="2" 
                           IsVisible="False"></Label>

                    <Label Grid.Row="1" Text="{Binding Path=ProductEditing.name, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
           FontSize="13" 
           FontAttributes="Bold"
           TextColor="#242322" Grid.ColumnSpan="2" MinimumHeightRequest="80"></Label>
                
                    <Label Text="Unidad Vta.:" Grid.Row="2" Grid.Column="0"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Path=ProductEditing.uom_display, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                        FontSize="12" 
                        FontAttributes="Bold"
                        TextColor="#242322"
                           HorizontalTextAlignment="Start"
                           VerticalTextAlignment="Center"></Label>

                    <Label Text="Stock:" Grid.Row="3" Grid.Column="0"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Path=ProductEditing.qty_available, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                            FontSize="12" 
                            FontAttributes="Bold"
                            TextColor="#242322"
                           HorizontalTextAlignment="Start"
                           VerticalTextAlignment="Center"></Label>
                
                    <Label Text="Precio:" Grid.Row="4" Grid.Column="0"/>
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Path=ProductEditing.list_price, Source={RelativeSource AncestorType={x:Type ContentPage}}, StringFormat='${0:N3}'}" 
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#242322"
                           HorizontalTextAlignment="Start"
                           VerticalTextAlignment="Center"></Label>
                </Grid>

                <Border Grid.Row="2" Stroke="LightGrey" Padding="3" Margin="0,0,0,0">
                    <VerticalStackLayout>
                        <Label Text="CANT. REAL" 
                               BackgroundColor="SlateGray" 
                               TextColor="White" 
                               TextTransform="Uppercase"
                               FontAttributes="Bold"
                               FontSize="11"
                               HorizontalTextAlignment="Center"></Label>
                        <Entry x:Name="EntryCantidadSolicitada" IsReadOnly="True"
                                       Text="{Binding Path=product_uom_qty_real, 
                                        Mode=TwoWay,
                                        Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                               HorizontalTextAlignment="End"                           
                               FontAttributes="Bold">
                            <Entry.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" />
                            </Entry.GestureRecognizers>
                        </Entry>
                        <Label Text="Cant. Desp." 
                               TextTransform="Uppercase"
                                FontAttributes="Bold"
                                FontSize="11"
                               BackgroundColor="SlateGray" 
                               TextColor="White" 
                               HorizontalTextAlignment="Center"></Label>
                        <Entry x:Name="EntryCantidadFinal" IsReadOnly="True"
                               Text="{Binding Path=product_uom_qty, 
                                 Mode=TwoWay,
                                 Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                               HorizontalTextAlignment="End"
                               FontAttributes="Bold">
                            <Entry.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" />
                            </Entry.GestureRecognizers>
                        </Entry>                    
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="btnApplyQty" Grid.Row="3" Text="" BackgroundColor="LimeGreen" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        Margin="5"
                        Clicked="ApplyValueChanges">
                    <Button.ImageSource>
                        <FontImageSource 
                Size="25"
                FontFamily="MaterialSharp"
                Glyph="{x:Static uranium:MaterialSharp.Check}" />
                    </Button.ImageSource>
                </Button>

                <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Padding="5" RowSpacing="2" ColumnSpacing="2">
                    <!-- Fila 1 -->
                    <Button Text="1" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked">

                    </Button>

                    <Button Text="2" Grid.Row="0" Grid.Column="1" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked">

                    </Button>
                    <Button Text="3" Grid.Row="0" Grid.Column="2" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <!-- Fila 2 -->
                    <Button Text="4" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <Button Text="5" Grid.Row="1" Grid.Column="1" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <Button Text="6" Grid.Row="1" Grid.Column="2" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <!-- Fila 3 -->
                    <Button Text="7" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <Button Text="8" Grid.Row="2" Grid.Column="1" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <Button Text="9" Grid.Row="2" Grid.Column="2" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <!-- Fila 4 -->
                    <Button Text="." Grid.Row="3" Grid.Column="0" FontAttributes="Bold" BackgroundColor="Gray" TextColor="WhiteSmoke"/>
                    <Button Text="0" Grid.Row="3" Grid.Column="1" FontAttributes="Bold" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                    <Button Text="⌫" Grid.Row="3" Grid.Column="2" FontAttributes="Bold" FontSize="12" FontAutoScalingEnabled="True" BackgroundColor="DodgerBlue" TextColor="WhiteSmoke" Clicked="OnKeyClicked"/>
                </Grid>

                <Button x:Name="btnResetQty" Grid.Row="5"
                  Text="" 
                  HorizontalOptions="Fill" 
                  BackgroundColor="Gray" 
                  TextColor="Black"
                  FontAttributes="Italic"
                  Margin="0,8,0,0"
                        Clicked="ResetOriginalValues">
                    <Button.ImageSource>
                        <FontImageSource 
                            Size="25"
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static uranium:MaterialSharp.Undo}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Grid>
        
        <Grid RowDefinitions="Auto,Auto,*,Auto" Grid.Column="1">
            <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,Auto"
              Margin="10">

                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding Path=PartnerDisplayName, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#242322"></Label>
                    <Label Text="{Binding Path=PartnerDisplayAddress, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                           FontSize="11" 
                           FontAttributes="Bold"
                           TextColor="#4d4947"></Label>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding Path=IdReferencia, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                               FontSize="12" 
                               FontAttributes="None"
                               TextColor="#4d4947"
                               VerticalOptions="Center"></Label>
                        <Label Text="{Binding Path=IdPrimaryKey, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                           FontSize="12" 
                           FontAttributes="None"
                           TextColor="SlateGray"
                               VerticalOptions="Center"></Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{Binding Path=PriceListDisplayName, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#242322"></Label>
                    <Label Text="{Binding Path=PartnerDisplayStatus, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                           FontSize="11" 
                           FontAttributes="Bold"
                           TextColor="#4d4947"></Label>
                    
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" WidthRequest="250">
                    <material:DropdownField
                            x:Name="ddfAddress"                        
                            Title="Dirección"
                            FontSize="11"
                            TitleFontSize="8"
                            AllowClear="True"
                        IsEnabled="{Binding LockEdition, Converter={StaticResource InverseBoolConverter}, Source={RelativeSource AncestorType={x:Type ContentPage}}}">
                        <material:DropdownField.Icon>                            
                            <FontImageSource
                                Size="14"
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf3c5;" />
                        </material:DropdownField.Icon>
                    </material:DropdownField>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="3" HorizontalOptions="Fill" Spacing="10" 
                                       IsEnabled="{Binding LockEdition, Converter={StaticResource InverseBoolConverter}, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                       IsVisible="{Binding LockEdition, Converter={StaticResource InverseBoolConverter}, Source={RelativeSource AncestorType={x:Type ContentPage}}}">
                    <Button Text="" Clicked="ButtonAddNew_Clicked" BackgroundColor="DarkSlateGray" TextColor="White" HeightRequest="45" WidthRequest="45" Padding="0">
                        <Button.ImageSource>
                            <FontImageSource 
                                Size="28"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Add_business}"/>
                        </Button.ImageSource>
                    </Button>

                    <Button Text="" Clicked="ButtonPromo_Clicked" BackgroundColor="DeepPink" TextColor="White" HeightRequest="45" WidthRequest="45" Padding="0">
                        <Button.ImageSource>
                            <FontImageSource 
                                Size="28"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Price_change}"/>
                        </Button.ImageSource>
                    </Button>

                    <Button Text="Guardar" Clicked="ButtonSave_Clicked" BackgroundColor="LimeGreen" TextColor="White" HeightRequest="45" WidthRequest="120" Padding="0">
                        <Button.ImageSource>
                            <FontImageSource 
                            Size="30"
                            FontFamily="MaterialSharp"
                            Glyph="{x:Static uranium:MaterialSharp.Save_as}" />
                        </Button.ImageSource>
                    </Button>
                    
                    <Button x:Name="btnSend" Text="" Clicked="ButtonSync_Clicked" 
                            BackgroundColor="DodgerBlue" 
                            TextColor="White" 
                            HeightRequest="43" 
                            WidthRequest="43" 
                            Padding="0">
                        <Button.ImageSource>
                            <FontImageSource 
                                Size="30"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Send_and_archive}" />
                        </Button.ImageSource>
                    </Button>

                </HorizontalStackLayout>
                
            </Grid>
            <!--<Label Grid.Row="1" Grid.Column="0" Text="TITULO CABECERAS" HorizontalOptions="Center"></Label>-->
            <!--<Grid BackgroundColor="LightGray" 
                  Grid.Row="1" 
                  Grid.Column="1" 
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                  RowDefinitions="Auto" 
                  HorizontalOptions="Fill">
                <Label Grid.Column="0" FontAttributes="Bold" Text="No" WidthRequest="50" FontSize="11" ></Label>
                <Label Grid.Column="1" FontAttributes="Bold" Text="ARTICULO" WidthRequest="140" FontSize="11"></Label>
                <Label Grid.Column="2" FontAttributes="Bold" Text="UNIDAD" WidthRequest="90" FontSize="11"></Label>
                <Label Grid.Column="3" FontAttributes="Bold" Text="CNTREAL" WidthRequest="95" FontSize="11"></Label>
                <Label Grid.Column="4" FontAttributes="Bold" Text="CNTDSP" WidthRequest="200" FontSize="11"></Label>
                <Label Grid.Column="5" FontAttributes="Bold" Text="PRECIO" WidthRequest="90" FontSize="11"></Label>
                <Label Grid.Column="6" FontAttributes="Bold" Text="PRE+IVA" WidthRequest="90" FontSize="11"></Label>
                <Label Grid.Column="7" FontAttributes="Bold" Text="SUBTOT(SI)" WidthRequest="100" FontSize="11"></Label>
                <Label Grid.Column="8" FontAttributes="Bold" Text="%DESC." WidthRequest="90" FontSize="11"></Label>
                <Label Grid.Column="9" FontAttributes="Bold" Text="$DESC." WidthRequest="100" FontSize="11"></Label>
                <Label Grid.Column="10" FontAttributes="Bold" Text="IMP." WidthRequest="100" FontSize="11"></Label>
                <Label Grid.Column="11" FontAttributes="Bold" Text="TOTAL" WidthRequest="100" FontSize="11"></Label>                
            </Grid>-->

            <Grid RowDefinitions="*" ColumnDefinitions="*" Grid.Row="2" HorizontalOptions="Fill">
                <CollectionView
                    x:Name="OrderLinesCl"
                    ItemsSource="{Binding OrderLines}" 
                    EmptyView="No hay productos seleccionados..."
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    HorizontalOptions="Start"
                    SelectionChanged="detail_SelectionChanged">
                    <CollectionView.Header>
                        <!--<customrowsheaders:SaleOrderLineRowHeader Item="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=OrdersLinesHeader}" HorizontalOptions="Fill" />-->
                        <Grid
                            ColumnSpacing="8"
                            Padding="4"
                            HorizontalOptions="Fill"
                            BackgroundColor="LightGray">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.9*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- idLabel -->
                            <Label 
                                Text="N°"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="Start"
                                Grid.Column="0"
                                Padding="0"
                                Margin="0"/>

                            <!-- codeLabel -->
                            <Label 
                                Text="ARTICULO"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="Start"
                                Grid.Column="1"/>

                            <!-- nameLabel -->
                            <Label 
                                Text="UNIDAD"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="Start"
                                Grid.Column="2"/>

                            <!-- qty_real -->
                            <Label 
                                Text="CNTREAL"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="Fill"
                                Grid.Column="3"/>

                            <!-- qty -->
                            <Label 
                                Text="CNTDSP"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="Fill"
                                Grid.Column="4"/>

                            <!-- priceLabel -->
                            <Label 
                                Text="PRECIO"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="5"/>

                            <!-- priceUnitLabel -->
                            <!--<Label 
                                Text="PRE+IVA"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="6"/>-->

                            <!-- subtotalLabel -->
                            <Label 
                                Text="SUBTOT"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="6"/>

                            <!-- discountPercentLabel -->
                            <Label 
                                Text="%DESC."
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="7"/>

                            <!-- discountLabel -->
                            <Label 
                                Text="$DESC."
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="8"/>

                            <!-- taxLabel -->
                            <Label 
                                Text="IMPUESTO"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="9"/>

                            <!-- totalLabel -->
                            <Label 
                                Text="TOTAL"
                                FontAttributes="Bold"
                                FontSize="11"
                                TextColor="Black"
                                HorizontalOptions="End"
                                Grid.Column="10"/>
                            
                            <StackLayout Grid.Column="12" MinimumWidthRequest="70"></StackLayout>

                        </Grid>

                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            
                            <!--<customrows:SaleOrderLineRow
                                Item="{Binding .}"
                                HorizontalOptions="Fill"
                                SelectedItem="{Binding BindingContext.SelectedItem, Source={x:Reference OrderLinesCl}}"
                                EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=EditCommand}"
                                DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=DeleteCommand}"/>-->

                            <customrowsv2:SaleOrderLineRow
                                Item="{Binding .}"
                                HorizontalOptions="Fill"    
                                EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=EditCommand}"
                                DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=DeleteCommand}"
                                LockEdition="{Binding LockEdition, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                            
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="3" Grid.Column="3" HorizontalOptions="Fill" ColumnDefinitions="*,*,Auto">
                <CollectionView
                        Grid.Row="0" 
                        Grid.Column="0"
                        x:Name="PromoBenefits"
                        ItemsSource="{Binding ItemsDataBenefits}" 
                        EmptyView="No hay promociones aplicables..."
                        SelectionMode="Single"
                        HorizontalOptions="Fill"
                    IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Padding="10">
                                <Label Text="{Binding id}" WidthRequest="20" />
                                <Label Text="{Binding name}" WidthRequest="90" />
                                <Label Text="{Binding description}" WidthRequest="90" />
                                <Label Text="{Binding _selection_type_id}" WidthRequest="80" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding code}" WidthRequest="20" />
                                <Label Text="{Binding state}" WidthRequest="30" HorizontalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <HorizontalStackLayout Grid.Row="0" 
                                Grid.Column="1"
                               VerticalOptions="Start" 
                               HorizontalOptions="End" 
                               Margin="0,0,0,10" 
                                Spacing="10">
                    
                    <uranium:ExpanderView IsExpanded="True" WidthRequest="250">
                        <uranium:ExpanderView.Header>
                            <Label                     
                    BackgroundColor="Transparent" 
                    Text="Observaciones"
                    FontSize="12"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Padding="3" IsVisible="False"/>
                        </uranium:ExpanderView.Header>
                        <StackLayout>
                            <material:EditorField x:Name="fieldNote" Title="Observac." Text="{Binding Note2, Mode=TwoWay}" 
                                IsEnabled="{Binding LockEdition, Converter={StaticResource InverseBoolConverter}, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                        </StackLayout>
                    </uranium:ExpanderView>
                    
                </HorizontalStackLayout>

                <Grid Grid.Column="2"
                     ColumnDefinitions="*,*"                    
                     RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                     RowSpacing="4" 
                     ColumnSpacing="15"
                     BackgroundColor="GhostWhite"
                      Padding="10"
                      Margin="20">
                    <Label Text="Subtotal:" Grid.Row="1" Grid.Column="0" FontSize="11"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:N4}'}" 
                         FontSize="11" 
                         FontAttributes="Bold"
                         TextColor="#242322"
                            HorizontalTextAlignment="End"
                            VerticalTextAlignment="Center"></Label>
                    
                    <Label Text="Descuento:" Grid.Row="2" Grid.Column="0" FontSize="11"></Label>
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Descuento, StringFormat='${0:N4}'}" 
                     FontSize="11" 
                     FontAttributes="Bold"
                     TextColor="#242322"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center"></Label>

                    <Label Text="Neto:" Grid.Row="3" Grid.Column="0" FontSize="11" IsVisible="False"></Label>
                    <!--<Label Text="Total:" Grid.Row="3" Grid.Column="0" FontSize="11"></Label>-->
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Neto, StringFormat='${0:N4}'}" 
                     FontSize="11" 
                     FontAttributes="Bold"
                     TextColor="#242322"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center"
                           IsVisible="False"></Label>

                    <Label Text="Impuesto:" Grid.Row="4" Grid.Column="0" FontSize="11"></Label>
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Impuesto, StringFormat='${0:N4}'}" 
                     FontSize="11" 
                     FontAttributes="Bold"
                     TextColor="#242322"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center"></Label>

                    <Label Text="Comp. Solidaria:" Grid.Row="5" Grid.Column="0" FontSize="11" IsVisible="False"></Label>
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding CompSolidaria, StringFormat='${0:N4}'}" 
                     FontSize="11" 
                     FontAttributes="Bold"
                     TextColor="#242322"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center" IsVisible="False"></Label>

                    <Label Text="Total:" Grid.Row="6" Grid.Column="0" FontSize="15"></Label>
                    <Label Grid.Row="6" Grid.Column="1" Text="{Binding Total, StringFormat='${0:N4}'}" 
                     FontSize="15" 
                     FontAttributes="Bold"
                     TextColor="#242322"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center"></Label>

                </Grid>
                <!--<VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Margin="0" BackgroundColor="LightGray" WidthRequest="200">
                    <Label Text="Subtotal:" FontSize="10" FontAttributes="Bold"></Label>
                    <Label FontSize="10" FontAttributes="Bold" Text="{Binding Subtotal}"></Label>
                    
                    <Label Text="NETO:" FontSize="10" FontAttributes="Bold"></Label>
                    <Label Text="IMPUESTO:" FontSize="10" FontAttributes="Bold"></Label>
                    <Label Text="COMP.SOLIDARIA:" FontSize="10" FontAttributes="Bold"></Label>
                    <Label Text="TOTAL:" FontSize="10" FontAttributes="Bold"></Label>
                </VerticalStackLayout>-->
            </Grid>

        </Grid>
    </Grid>
    
</ContentPage>