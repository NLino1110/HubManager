<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMOrders.Pages.Fragments.Customers.Info"
             x:Name="info"                          
             xmlns:m="http://schemas.enisn-projects.io/dotnet/maui/uraniumui">

    <ScrollView BackgroundColor="White">
        <StackLayout>
            <!--<Label BackgroundColor="{StaticResource ActiveRowColor}" Text="Informacion" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>-->
        
        <Grid ColumnDefinitions="*,2*" 
            RowSpacing="0"
            Padding="0"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <Label Grid.Row="1" Grid.ColumnSpan="2" FontAttributes="Bold" Text="DATOS CLIENTE - #" x:Name="clienteTitulo" TextColor="{StaticResource OnTertiaryContainer}" />
                <Label Grid.Row="2" Grid.Column="0" Text="Tipo Ident:" Padding="3" Margin="0" FontSize="11"/>
                <Label Grid.Row="2" Grid.Column="1" x:Name="tipIden" Text="-" Margin="0" FontSize="11"/>
                <Label Grid.Row="3" Grid.Column="0" Text="Identificación:" Padding="3" FontSize="11"/>
                <Label Grid.Row="3" Grid.Column="1" x:Name="vat" Text="-" FontSize="11"/>
                <Label Grid.Row="4" Grid.Column="0" Text="Teléfono:" Padding="3" FontSize="11"/>
                <Label Grid.Row="4" Grid.Column="1" x:Name="telephone" Text="-" FontSize="11"/>
                <Label Grid.Row="5" Grid.Column="0" Text="Canal Venta:" Padding="3" FontSize="11"/>
                <Label Grid.Row="5" Grid.Column="1" x:Name="channel" Text="-" FontSize="11"/>
                <Label Grid.Row="6" Grid.Column="0" Text="Vendedor:" Padding="3" FontSize="11"/>
                <Label Grid.Row="6" Grid.Column="1" x:Name="seller" Text="-" FontSize="11"/>
                <Label Grid.Row="7" Grid.Column="0" Text="Estado:" Padding="3" FontSize="11"/>
                <Label Grid.Row="7" Grid.Column="1" x:Name="status" Text="-" FontSize="11"/>

            <Label Grid.Row="8" Grid.ColumnSpan="2" FontAttributes="Bold" Text="INFO. CREDITICIA" Padding="0,10,0,0"/>
                <Label Grid.Row="9" Grid.Column="0" Text="Calificación:" FontSize="11"/>
                <Label Grid.Row="9" Grid.Column="1" x:Name="calif" Text="-" FontSize="11"/>
                <Label Grid.Row="10" Grid.Column="0" Text="Cupo:" FontSize="11"/>
                <Label Grid.Row="10" Grid.Column="1" x:Name="cupo" Text="-" FontSize="11"/>
                <Label Grid.Row="11" Grid.Column="0" Text="Observación:" FontSize="11"/>
                <Label Grid.Row="11" Grid.Column="1" x:Name="obs" Text="-" FontSize="11"/>
                <Label Grid.Row="12" Grid.Column="0" Text="Días Crédito:" FontSize="11"/>
                <Label Grid.Row="12" Grid.Column="1" x:Name="days" Text="-" FontSize="11"/>
        </Grid>
        </StackLayout>
    </ScrollView>
</ContentView>
