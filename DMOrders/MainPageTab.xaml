<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:DMOrders="clr-namespace:DMOrders"
             xmlns:pages="clr-namespace:DMOrders.Pages"             
             xmlns:pagesCustomer="clr-namespace:DMOrders.Pages.Fragments.Customers"
             xmlns:pagesActivities="clr-namespace:DMOrders.Pages.Fragments.Activities"
             xmlns:pagesOrders="clr-namespace:DMOrders.Pages.Fragments.Orders"
             xmlns:pagesProducts="clr-namespace:DMOrders.Pages.Fragments.Product"             
             x:Class="DMOrders.MainPageTab"
             Title="MainPageTab"
             Padding="0"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ControlTemplate x:Key="TabControlTemplate">
            <VerticalStackLayout BindingContext="{Binding Source={RelativeSource TemplatedParent}}">
                <Image Source="{Binding Value.Icon}"
			       WidthRequest="30"
			       HeightRequest="30"
			       HorizontalOptions="Center"/>
                <Label Text="{Binding Value.Title}"  FontSize="12"
			       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ControlTemplate>
    </ContentPage.Resources>
    <Grid>

        <Grid RowDefinitions="Auto,*" Margin="0,0,0,30" >
            <Grid Grid.Row="0"
                  HeightRequest="40"
                  BackgroundColor="White"
                  ColumnDefinitions="*,*,*,*">

                <Grid Grid.Column="0" x:Name="tabBtnCustomers">
                    <Grid Padding="0" RowDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabCustomers"/>
                        </Grid.GestureRecognizers>

                        <Label x:Name="lblTabCustomers"
                           Text="Clientes"
                           FontSize="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           Grid.Row="0"/>

                        <BoxView x:Name="lineTabCustomers"
                         HeightRequest="2"
                         Color="Transparent"
                         HorizontalOptions="Fill"
                         Grid.Row="1"/>
                    </Grid>
                </Grid>
    
                <Grid Grid.Column="1" x:Name="tabBtnProducts" >
                    <Grid Padding="0" RowDefinitions="*,Auto">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabProducts"/>
                        </Grid.GestureRecognizers>
                        
                        <Label x:Name="lblTabProducts"
                           Text="Productos"
                           FontSize="12"
                           HorizontalOptions="Center"
                               VerticalOptions="Center"
                           TextColor="Gray"
                               Grid.Row="0"/>

                        <BoxView x:Name="lineTabProducts"
                             HeightRequest="2"
                                 Color="Transparent"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Fill"
                                 Grid.Row="1"/>
                    </Grid>
                </Grid>


                <Grid Grid.Column="2" x:Name="tabBtnOrders" >
                    <Grid Padding="0" RowDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabOrders"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="lblTabOrders"
                           Text="Pedidos"
                           FontSize="12"
                           HorizontalOptions="Center"
                               VerticalOptions="Center"
                           TextColor="Gray"
                               Grid.Row="0"/>

                        <BoxView x:Name="lineTabOrders"
                             HeightRequest="2"
                                 Color="Transparent"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Fill"
                                 Grid.Row="1"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="3" x:Name="tabBtnActivities" >
                    <Grid Padding="0" RowDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabActivities"/>
                        </Grid.GestureRecognizers>                        
                        <Label x:Name="lblTabActivities"
                           Text="Actividades"
                           FontSize="12"
                           HorizontalOptions="Center"
                               VerticalOptions="Center"
                           TextColor="Gray"
                               Grid.Row="0"/>
                        <BoxView x:Name="lineTabActivities"
                             HeightRequest="2"
                                 Color="Transparent"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Fill"
                                 Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <pagesCustomer:Container x:Name="tabCustomers" IsVisible="True"/>
                <pagesProducts:Container x:Name="tabProducts" IsVisible="False"/>
                <pagesOrders:Container x:Name="tabOrders" IsVisible="False"/>
                <pagesActivities:Container x:Name="tabActivities" IsVisible="False"/>
            </Grid>
        </Grid>

        <!-- Panel inferior superpuesto -->
        <ContentView x:Name="OverlayPanel"
                     BackgroundColor="#80000000"
                     IsVisible="True"
                     VerticalOptions="End"
                     HeightRequest="33"
                     Grid.RowSpan="2"
                     TranslationY="0">
            <Grid RowDefinitions="Auto,*">
                <Grid HeightRequest="33"
                        BackgroundColor="Gray"
                        ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" 
                        ColumnSpacing="10" Grid.Row="0">
                    <Grid.Shadow>
                        <Shadow Brush="Black"
                            Radius="20"
                            Opacity="0.2" />
                    </Grid.Shadow>

                    <Image Grid.Column="0" Source="icon_macronegocios.png" WidthRequest="60" VerticalOptions="Center"/>

                    <Label Grid.Column="1"
                       x:Name="lblCompany"
                       Text="-"
                       VerticalOptions="Center"
                       Padding="0"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnPrimary}"/>

                    <Label Grid.Column="2"                           
                        x:Name="lblStore"
                        BackgroundColor="LightGray"
                        Text="..."
                        VerticalOptions="Center"
                        Padding="5,0,5,0"
                        FontAttributes="None"
                        FontSize="10"
                        TextColor="DimGray"/>

                    <HorizontalStackLayout Grid.Column="3">
                        <Image
                        x:Name="imageDebug"                    
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        HeightRequest="15"
                        WidthRequest="15"
                        Margin="10">
                            <Image.Source>
                                <FontImageSource FontFamily="FontAwesome5Solid"
                             Color="DimGray"
                             Size="10"
                             FontAutoScalingEnabled="False"
                             Glyph="&#xf188;" />
                            </Image.Source>
                        </Image>

                        <Label Grid.Column="2"                           
                            x:Name="lblConnection"
                            BackgroundColor="Transparent"
                            Text="..."
                            VerticalOptions="Center"
                            Padding="5,0,5,0"
                            FontAttributes="None"
                            FontSize="10"
                            TextColor="GhostWhite"/>
                    </HorizontalStackLayout>

                    <Image 
                        Grid.Column="4"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        HeightRequest="15"
                        WidthRequest="15"
                        Margin="10">
                        <Image.Source>
                            <FontImageSource FontFamily="FontAwesome5Solid"
										Color="DimGray"
										Size="13"
										FontAutoScalingEnabled="False"                                                         
										Glyph="&#xf007;" />
                        </Image.Source>
                    </Image>

                    <Label Grid.Column="5"                           
                        x:Name="lblUser"       
                        Text="..."
                        TextColor="GhostWhite"
                        VerticalOptions="Center"
                        Padding="5,0,5,0"
                        FontAttributes="Bold"
                        FontSize="10"/>

                    <Label Grid.Column="6"                           
        x:Name="lblUserName"
           BackgroundColor="LightGray"
        Text="..."
        VerticalOptions="Center"
        Padding="5,0,5,0"
        FontAttributes="None"
        FontSize="10"
        TextColor="DimGray"/>

                    <Image Grid.Column="7"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         HeightRequest="15"
                         WidthRequest="15"
                         Margin="10">
                        <Image.Source>
                            <FontImageSource FontFamily="FontAwesome5Solid"
										Color="DimGray"
										Size="20"
										FontAutoScalingEnabled="True"                                                         
										Glyph="&#xf00c;" />
                        </Image.Source>
                    </Image>

                </Grid>
                <Grid ColumnDefinitions="*,*" Grid.Row="1">
                    <CollectionView
                        x:Name="MenuCollection"
                        ItemsSource="{Binding MenuItems}"
                        SelectionMode="Single"
                        SelectionChanged="OnMenuItemSelected"
                        BackgroundColor="White"
                        Margin="3">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           HeightRequest="20"
                                           WidthRequest="20"
                                           Margin="10"
                                           VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="FontAwesome5Solid"
                                         Glyph="{Binding Icon}"
                                         Color="DimGray"
                                         Size="20" />
                                        </Image.Source>
                                    </Image>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Description}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <StackLayout Grid.Column="1" Padding="5" BackgroundColor="Black">
                        <Label TextColor="White">0 procesos en background</Label>
                    </StackLayout>
                </Grid>
            </Grid>
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTogglePanelTapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>
    </Grid>    
</ContentPage>