<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
             xmlns:vm="clr-namespace:DMDataSafe.ViewModels"
             xmlns:conv="clr-namespace:DMDataSafe.Converters"
             xmlns:controls="clr-namespace:BeebTech.Maui.Controls;assembly=BeebTech.Maui.Controls"
             x:DataType="vm:MainViewModelCliAprob"
             x:Class="DMDataSafe.MainPageForProcess">    
        <Grid RowDefinitions="Auto,*">
            <Grid Margin="0,0,0,0" Padding="0,0" HorizontalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0" Padding="5,2,5,2" HeightRequest="55">
                <Image
                    Source="logo_dmujeres_modern.png"
                    SemanticProperties.Description=""                    
                    HorizontalOptions="Start"
                    VerticalOptions="FillAndExpand"                    
                    />
            </StackLayout>

            <Label Grid.Column="1"                    
                    Text="APROBACIÓN DE DATOS" 
                       TextColor="#FE4468" 
                       Margin="0,0,5,0" 
                       VerticalOptions="Center" 
                       FontAttributes="Bold"
                       FontSize="18">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer 
                                        Tapped="OnTapGestureRecognizerTapped"
                                            NumberOfTapsRequired="2"/>
                    </Label.GestureRecognizers>
                </Label>


            <Grid Grid.Column="2" Margin="0,0,0,0" HorizontalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>                    
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                    Text="usuario" 
                       TextColor="#FE4468" 
                       Margin="0,0,5,0" 
                       VerticalOptions="Center" 
                       FontAttributes="Bold"
                       FontSize="16"
                       x:Name="lblUser" Padding="20,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer 
                                        Tapped="OnTapLabelUser"
                                            NumberOfTapsRequired="2"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="0" Grid.Row="1"
                    Text="Agencia" 
                       TextColor="#FE4468" 
                       Margin="0,0,5,0" 
                       VerticalOptions="Center" 
                       FontAttributes="Bold"
                       FontSize="13"
                       x:Name="lblAgencia" Padding="20,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer 
                                        Tapped="OnTapLabelUser"
                                            NumberOfTapsRequired="2"/>
                    </Label.GestureRecognizers>
                </Label>

            </Grid>

            <Grid Grid.Column="3" Padding="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--<Picker x:Name="pickerSucursal"
                    Title="Sucursal:"
                    HorizontalOptions="FillAndExpand">
                </Picker>-->
                
                <!--<Picker x:Name="pickerSucursal"
                Title="Sucursal:"
                ItemsSource="{Binding formaspagos}"
                ItemDisplayBinding="{Binding descripcion}"
                SelectedItem="{Binding selFormaspagos}"
                HorizontalOptions="FillAndExpand" 
                SelectedIndexChanged="OnPickerSelectedIndexChanged">
                </Picker>-->

                <Entry
                    Grid.Column="0" 
                       Text="" 
                       x:Name="txtFilter"
                       WidthRequest="250"
                       Placeholder="Buscar por Cedula/Ruc/Nombres"
                    ClearButtonVisibility="WhileEditing" />

                <Button Grid.Column="1"
                    BackgroundColor="SteelBlue"
                    x:Name="btnBuscar"
                    Text="Buscar"
                    FontAttributes="Bold"
                    FontSize="13"
                    SemanticProperties.Hint="Buscar datos"                
                    
                    Clicked="btnBuscar_Clicked"
                    HorizontalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource 
                                        FontFamily="FontAwesome5Solid"
                                        Glyph="&#xf002;"
                                                 Size="20"                                                      
                                 FontAutoScalingEnabled="True"
                                                  />
                    </Button.ImageSource>
                </Button>
            </Grid>                

            <Button Grid.Column="4"
                    BackgroundColor="CornflowerBlue"
                    x:Name="BtnClose"
                    Text="Salir"
                    FontAttributes="Bold"
                    FontSize="14"
                    SemanticProperties.Hint="Salir de la sesión"                    
                    Clicked="BtnClose_Clicked"
                    HorizontalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource 
                            FontFamily="FontAwesome5Solid"
                            Glyph="&#xf359;"
                            Size="20"                                                     
                            FontAutoScalingEnabled="True"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        
        <dg:DataGrid Grid.Row="1" ItemsSource="{Binding ItemsData}" 
                     SelectionMode="Single"
                     SelectedItem="{Binding SelectedItem}"
                     RowHeight="70" 
                     HeaderHeight="50" 
                     BorderColor="{StaticResource GridBorderColor}"
                     HeaderBackground="{StaticResource GridHeaderBgColor}"                       
                     HeaderBordersVisible="{Binding HeaderBordersVisible}"
                     PullToRefreshCommand="{Binding RefreshCommand}" 
                     IsRefreshing="{Binding IsRefreshing}" 
                     PaginationEnabled="{Binding PaginationEnabled}" 
                     PageSize="7"
                     ActiveRowColor="{StaticResource ActiveRowColor}" 
                     x:Name="_dataGrid1" 
                     ItemSelected="_dataGrid1_ItemSelected">
            <dg:DataGrid.HeaderLabelStyle>
                <Style TargetType="Label">
                    <Setter Property="TextColor" Value="White"/>
                    <Setter Property="FontAttributes" Value="Bold"/>
                    <Setter Property="HorizontalTextAlignment" Value="Center"/>
                    <Setter Property="VerticalTextAlignment" Value="Center"/>
                </Style>
            </dg:DataGrid.HeaderLabelStyle>            
            <dg:DataGrid.Columns>
                <dg:DataGridColumn Title="CED./RUC" PropertyName="vat_doc" Width="0.5*" SortingEnabled="False"/>
                <dg:DataGridColumn Title="NOMBRES" PropertyName="FirstName" Width="0.5*" SortingEnabled="False"/>

                <dg:DataGridColumn Title="APELLIDOS" PropertyName="LastName" Width="0.5*" SortingEnabled="False"/>
                <dg:DataGridColumn Title="DIRECCIÓN" PropertyName="Address" Width="0.5*" SortingEnabled="False"/>
                <dg:DataGridColumn Title="" PropertyName="vat_doc" SortingEnabled="False" Width="0.2*">
                    <dg:DataGridColumn.CellTemplate>
                        <DataTemplate>
                            <Image WidthRequest="20">
                                <Image.Source>
                                    <FontImageSource FontFamily="FontAwesome5Solid"
                                                     Color="DarkGray"
                                                 Size="25"
                                 FontAutoScalingEnabled="True"
                                                 Glyph="&#xf017;" />
                                </Image.Source>
                                
                            </Image>

                        </DataTemplate>
                    </dg:DataGridColumn.CellTemplate>
                </dg:DataGridColumn>

                <dg:DataGridColumn Title="" PropertyName="vat_doc" SortingEnabled="False" Width="0.3*">
                    <dg:DataGridColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                BackgroundColor="OrangeRed"
                x:Name="BtnClose"
                Text="Aprobar"
                                FontAttributes="Bold"
                                FontSize="18"
                SemanticProperties.Hint="Cerrar"                
                WidthRequest="150"
                                Clicked="BtnSelect"
                HorizontalOptions="Center"
            Margin="5">
                                <Button.ImageSource>
                                    <FontImageSource 
                                        FontFamily="FontAwesome5Solid"
                                        Glyph="&#xf14a;"
                                                 Size="20"                                                      
                                 FontAutoScalingEnabled="True"
                                                  />
                                </Button.ImageSource>
                            </Button>
                        </DataTemplate>
                    </dg:DataGridColumn.CellTemplate>
                </dg:DataGridColumn>
            </dg:DataGrid.Columns>
            <dg:DataGrid.RowsBackgroundColorPalette>
                <dg:PaletteCollection>
                    <Color>#F2F2F2</Color>
                    <Color>#FFFFFF</Color>
                </dg:PaletteCollection>
            </dg:DataGrid.RowsBackgroundColorPalette>
            <dg:DataGrid.Resources>
                <ResourceDictionary>
                    <conv:StreakToColorConverter x:Key="StreakToColorConverter" />
                </ResourceDictionary>
            </dg:DataGrid.Resources>
        </dg:DataGrid>
    </Grid>
</ContentPage>
