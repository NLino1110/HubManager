<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.Controls.ProgressBarPage"
             xmlns:controls="clr-namespace:BeebTech.Maui.Controls.Controls;assembly=BeebTech.Maui.Controls"
             xmlns:local="clr-namespace:DMCobranzas.Controls;assembly=DMCobranzas"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="ProgressBarAnimationBehaviorPage">
    <ContentPage.Resources>
        <Style x:Key="labelRedStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="labelGreenStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="Green" />
        </Style>
        <Style x:Key="CommonHeader"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="CenterAndExpand" />            
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Margin" Value="10" />
        </Style>
    </ContentPage.Resources>
    <ScrollView VerticalOptions="FillAndExpand">
        <VerticalStackLayout Margin="50">            
            <Label Text="Procesando actualización" Style="{StaticResource CommonHeader}" />
            <Label Text="{Binding title}" />
            <Label Text="{Binding subTitle}" />

            <controls:CustomProgressBar 
                x:Name="customProgressBar"
                Progress="{Binding ProgressCurrent}"
                ProgressColor="DeepSkyBlue"
                TrackColor="#E0E0E0"                
                AnimationDuration="250"
                Margin="0,15,0,15"
                BarHeight="25"/>

            <Label Text="Progreso total.." x:Name="lblTitle2" Margin="0,30,0,0"/>
            <controls:CustomProgressBar 
                x:Name="customProgressBarTotal"
                Progress="{Binding ProgressTotal}"
                ProgressColor="DeepSkyBlue"
                TrackColor="#E0E0E0"                
                AnimationDuration="250"
                Margin="0,15,0,15"
                BarHeight="25"/>

            <!--<ProgressBar BackgroundColor="DeepSkyBlue">
                <ProgressBar.Behaviors>
                    <toolkit:ProgressBarAnimationBehavior
                    x:Name="ProgressBarAnimationBehaviorLocal"
                    Progress="{Binding Progress}"
                    Length="250"/>
                </ProgressBar.Behaviors>
            </ProgressBar>
            
            <ProgressBar BackgroundColor="DodgerBlue">
                <ProgressBar.Behaviors>
                    <toolkit:ProgressBarAnimationBehavior
                        x:Name="ProgressBarAnimationBehaviorLocalTotal"
                        Progress="{Binding Progress}"
                        Length="250"/>
                </ProgressBar.Behaviors>
            </ProgressBar>-->

            <Label Text="Por favor espere hasta que termine el proceso..." Margin="0,30,0,0" TextColor="DimGray"/>
            <!--<Button
                x:Name="BtnUpdate"
                Text="Ingresar"
                SemanticProperties.Hint="Actualizar"
                Clicked="BtnUpdateProgress"
                HorizontalOptions="Center" />-->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>