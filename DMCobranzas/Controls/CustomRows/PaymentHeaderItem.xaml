<?xml version="1.0" encoding="utf-8" ?>
<SwipeView
    x:Name="Root"
    x:Class="DMCobranzas.Controls.CustomRows.PaymentHeaderItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DMCobranzas.Controls.CustomRows"
    xmlns:ui="clr-namespace:DMCobranzas.Controls"
    IsClippedToBounds="True">
    
    <SwipeView.RightItems>
        <SwipeItems SwipeBehaviorOnInvoked="RemainOpen">
            <SwipeItemView>
                <StackLayout
                    Orientation="Horizontal"
                    Margin="5">

                    <Button
                        Text="TICKET"                        
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TicketCommand}"
                        CommandParameter="{Binding Item, Source={x:Reference Root}}"
                        FontAttributes="Bold"
                        BackgroundColor="WhiteSmoke"
                        TextColor="Black">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf02f;"
                                Size="20"
                                Color="Black" />
                        </Button.ImageSource>
                    </Button>

                    <Button
                        x:Name="BtnEditar"
                        Text="EDITAR"
                        IsVisible="False"                        
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                        CommandParameter="{Binding .}"
                        FontAttributes="Bold"
                        BackgroundColor="LimeGreen"
                        TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf303;"
                                Size="20"
                                Color="White" />
                        </Button.ImageSource>
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Item.payment_status, Source={x:Reference Root}}" Value="PENDIENTE">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Item.payment_status, Source={x:Reference Root}}" Value="ERROR">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button
                        x:Name="BtnEnviar"
                        Text="ENVIAR"
                        IsVisible="False"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EnviarCobroCommand}"
                        CommandParameter="{Binding .}"
                        FontAttributes="Bold"
                        BackgroundColor="DeepSkyBlue"
                        TextColor="White">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf1d8;"
                                Size="20"
                                Color="White" />
                        </Button.ImageSource>
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Item.payment_status, Source={x:Reference Root}}" Value="PENDIENTE">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Item.payment_status, Source={x:Reference Root}}" Value="ERROR">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </StackLayout>
            </SwipeItemView>
        </SwipeItems>
    </SwipeView.RightItems>
    
    <Border
        StrokeThickness="0.3"        
        Padding="5,0"
        Margin="0,1"
        BackgroundColor="GhostWhite"        
        MinimumHeightRequest="70">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="5,5,5,5">                
            </RoundRectangle>
        </Border.StrokeShape>
        
        <Grid
            Padding="2"
            ColumnSpacing="5"
            RowSpacing="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                FontAttributes="Bold"
                FontSize="14"
                Text="{Binding Item.partner_name, Source={x:Reference Root}}" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                FontSize="12"
                TextColor="Blue"
                Text="{Binding Item.recipe_name, Source={x:Reference Root}}" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                FontSize="12"
                Text="{Binding Item.amount, StringFormat='$ {0:N2}', Source={x:Reference Root}}" />

            <ui:IndicatorLabelUI
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                Text="{Binding Item.payment_status, Source={x:Reference Root}}"
                TextColor="White"
                TextBackgroundColor="DarkSeaGreen">
                <ui:IndicatorLabelUI.Triggers>
                    <DataTrigger TargetType="ui:IndicatorLabelUI"
                                 Binding="{Binding Item.payment_status, Source={x:Reference Root}}"
                                 Value="PENDIENTE">
                        <Setter Property="TextBackgroundColor" Value="Orange"/>
                    </DataTrigger>
                    <DataTrigger TargetType="ui:IndicatorLabelUI"
                                 Binding="{Binding Item.payment_status, Source={x:Reference Root}}"
                                 Value="ERROR">
                        <Setter Property="TextBackgroundColor" Value="OrangeRed"/>
                    </DataTrigger>
                </ui:IndicatorLabelUI.Triggers>
            </ui:IndicatorLabelUI>

            <ui:IndicatorUI
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"/>

            <StackLayout
                Orientation="Horizontal"
                Grid.Column="4"
                Grid.Row="0"
                Grid.RowSpan="3"
                Margin="5"
                HorizontalOptions="Center">

                <StackLayout.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean">
                        <On Platform="WinUI" Value="True"/>
                        <On Platform="Android,iOS,MacCatalyst" Value="False"/>
                    </OnPlatform>
                </StackLayout.IsVisible>

                <Button
                    Text="TICKET"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TicketCommand}"
                    CommandParameter="{Binding .}"
                    BackgroundColor="WhiteSmoke"
                    TextColor="Black"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="5"
                    MaximumWidthRequest="120"
                    HorizontalOptions="Center"
                    Margin="1"
                    ContentLayout="Top,0">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FontAwesome5Solid"
                            Glyph="&#xf02f;"
                            Size="20"
                            Color="Black" />
                    </Button.ImageSource>
                </Button>

                <Button Text="EDITAR"                    
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                    CommandParameter="{Binding .}"
                    BackgroundColor="LimeGreen"
                    TextColor="WhiteSmoke"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="5"
                    MaximumWidthRequest="120"
                    HorizontalOptions="Center"
                    Margin="1"
                    ContentLayout="Top,0">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FontAwesome5Solid"
                            Glyph="&#xf303;"
                            Size="20"
                            Color="WhiteSmoke" />
                    </Button.ImageSource>
                </Button>

                <Button Text="ENVIAR"                    
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EnviarCobroCommand}"
                    CommandParameter="{Binding .}"
                        BackgroundColor="DeepSkyBlue"
                        TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="5"
                        MaximumWidthRequest="120"
                        HorizontalOptions="Center"
                        Margin="1"
                        ContentLayout="Top,0">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FontAwesome5Solid"
                            Glyph="&#xf1d8;"
                            Size="20"
                            Color="WhiteSmoke" />
                    </Button.ImageSource>
                </Button>
            </StackLayout>
        </Grid>        
    </Border>
</SwipeView>
