<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="ThisRow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DMCobranzas.Converters"
             x:Class="DMCobranzas.Controls.CustomRows.InvoicePaymentItem">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:DateToDaysConverter x:Key="DateToDaysConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        StrokeThickness="0.1"
        Padding="2"
        Margin="2"
        BackgroundColor="Transparent"
        MinimumHeightRequest="70">

        <!-- GRID PRINCIPAL -->
        <Grid ColumnDefinitions="*,80,50"
              RowDefinitions="Auto">

            <!-- ===================== -->
            <!-- BLOQUE DE INFORMACIÓN -->
            <!-- ===================== -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,*">

                <!-- Fila 1 -->
                <!--<Label Text="{Binding invoice_id}"
                       FontSize="10"
                       FontAttributes="Bold"
                       TextColor="DimGray"/>-->

                <Label Text="{Binding docnum_mask}"
                       Grid.Column="1"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="DimGray"/>

                <!--<Label Text="{Binding invoice_name}"
                       Grid.Column="2"
                       FontSize="12"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"/>-->

                <!-- Fila 2 -->
                <Label Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Text="{Binding seller, StringFormat='VEND: {0}'}"
                       FontSize="11"
                       FontAttributes="Bold"/>

                <!-- Fila 3 -->
                <StackLayout Grid.Row="2"
                             Grid.ColumnSpan="3"
                             Orientation="Horizontal"
                             Spacing="10">

                    <Label Text="{Binding invoice_date, StringFormat='FECHA: {0:dd/MM/yyyy}'}"
                           FontSize="11"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding invoice_date, Converter={StaticResource DateToDaysConverter}, StringFormat='DIAS: {0}'}"
                           FontSize="11"
                           FontAttributes="Bold"/>
                </StackLayout>

                <!-- Fila 4 -->
                <Label Grid.Row="3"
                       Grid.ColumnSpan="3"
                       Text="{Binding amount_residual, StringFormat='SALDO: $ {0:N2}'}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="Red"/>
            </Grid>

            <!-- ========= -->
            <!-- ENTRY     -->
            <!-- ========= -->
            <Entry Grid.Column="1"
                   x:Name="entryPagoImporte"
                   Text="{Binding amount_asigned}"
                   WidthRequest="75"
                   HeightRequest="40"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center"
                   Placeholder="Pago"
                   TextChanged="EntryPagoImporte_TextChanged"/>

            <!-- ========= -->
            <!-- BOTÓN     -->
            <!-- ========= -->
            <Button Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="OrangeRed"
                    Command="{Binding ClearValueCommand, Source={x:Reference Name=ThisRow}}"
                    CommandParameter="{Binding .}"
                    Padding="0"
                    VerticalOptions="Center">

                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesome5Solid"
                                     Glyph="&#xf55a;"
                                     Color="White"
                                     Size="14"/>
                </Button.ImageSource>
            </Button>

        </Grid>
    </Border>
</ContentView>
