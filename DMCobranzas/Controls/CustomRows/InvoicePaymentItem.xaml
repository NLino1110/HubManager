<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="ThisRow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DMCobranzas.Converters"
             x:Class="DMCobranzas.Controls.CustomRows.InvoicePaymentItem">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:DateToDaysConverter x:Key="DateToDaysConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Border
        StrokeThickness="0.2"
        Padding="2"
        Margin="1"
        BackgroundColor="Transparent"        
        MinimumHeightRequest="30">
        <Grid            
            HorizontalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label
                Text="{Binding invoice_id}"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="DimGray"/>

            <!-- Documento -->
            <Label
                x:Name="labelArticulo"
                Text="{Binding invoice_name}"
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                FontSize="12"
                FontAttributes="Bold"/>

            <!-- Total -->
            <Label
                x:Name="labelTotal"
                Text="{Binding amount_total, StringFormat='($ {0:N2})'}"
                Grid.Row="0"
                Grid.Column="2"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="Black"/>

            <!-- Vendedor -->
            <Label
                x:Name="labelVendedor"
                Text="{Binding seller, StringFormat='VEND: {0}'}"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                FontSize="12"
                FontAttributes="Bold"/>

            <!-- Fecha -->
            <Label
                x:Name="labelFechaRegistro"
                Text="{Binding invoice_date, StringFormat='FECHA: {0:dd/MM/yyyy}'}"
                Grid.Row="2"
                Grid.Column="0"
                FontSize="12"
                FontAttributes="Bold"/>

            <!-- Días -->
            <Label
                x:Name="labelDias"
                Text="{Binding invoice_date, Converter={StaticResource DateToDaysConverter}, StringFormat='(DIAS: {0})'}"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5,0,0,0"
                FontSize="12"
                FontAttributes="Bold"/>

            <!-- Saldo -->
            <Label
                x:Name="labelAmountResidual"
                Text="{Binding amount_residual, StringFormat='SALDO: ${0:N2}'}"
                Grid.Row="3"
                Grid.Column="0"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="Red"/>

            <!-- Importe -->
            <Entry
                x:Name="entryPagoImporte"
                Text="{Binding amount_asigned}"
                Grid.Column="5"
                Grid.RowSpan="4"
                WidthRequest="75"
                HeightRequest="40"
                Keyboard="Numeric"
                HorizontalTextAlignment="End"
                Placeholder="Pago"
                TextChanged="EntryPagoImporte_TextChanged"/>

            <!-- Botón limpiar -->
            <Button
                Grid.Column="6"
                Grid.RowSpan="4"
                WidthRequest="40"
                HeightRequest="35"
                CornerRadius="25"
                BackgroundColor="OrangeRed"
                Command="{Binding ClearValueCommand, Source={x:Reference Name=ThisRow}}"
                CommandParameter="{Binding .}"
                HorizontalOptions="Center"
                Padding="0,0,3,0">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf55a;"
                        Color="White"
                        Size="13"/>
                </Button.ImageSource>
            </Button>

        </Grid>
    </Border>
</ContentView>
