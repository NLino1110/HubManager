<?xml version="1.0" encoding="utf-8" ?>
<!-- NC Cobranzas: fila compacta. Revertir desde git: CreditNoteRequestDetailRow.xaml -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.Controls.CustomRows.CreditNoteRequestDetailRow"
             x:Name="root">
    <Border StrokeThickness="0.3"
            Padding="4,3"
            Margin="0,1"
            BackgroundColor="Transparent">

        <Grid ColumnDefinitions="*,68,46"
              ColumnSpacing="4">

            <!-- Columna 1: todo el detalle apilado -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="1"
                                 VerticalOptions="Start">

                <HorizontalStackLayout Spacing="10">
                    <Label FontSize="11"
                           TextColor="DimGray"
                           LineBreakMode="NoWrap">
                        <Label.Text>
                            <Binding Path="DataItem.invoice_date"
                                     Source="{x:Reference root}"
                                     StringFormat="FECHA: {0:dd/MM/yyyy}" />
                        </Label.Text>
                    </Label>
                    <Label FontSize="11"
                           TextColor="DimGray"
                           LineBreakMode="NoWrap">
                        <Label.Text>
                            <Binding Path="DataItem.docnum_mask"
                                     Source="{x:Reference root}"
                                     StringFormat="Nº {0}" />
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>

                <Label FontSize="12"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap"
                       MaxLines="3"
                       Text="{Binding DataItem.display_name, Source={x:Reference root}}" />

                <HorizontalStackLayout Spacing="12">
                    <Label FontSize="11"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           Text="{Binding DataItem.price_total, Source={x:Reference root}, StringFormat='PRECIO: ${0:0.##}'}" />
                    <Label FontSize="11"
                           FontAttributes="Bold"
                           TextColor="Green"
                           LineBreakMode="NoWrap"
                           Text="{Binding DataItem.discount_percentage, Source={x:Reference root}, StringFormat='% DESC: {0:0.##}'}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Cant.Disp:"
                               FontSize="10"
                               TextColor="Gray"
                               VerticalOptions="Center" />
                        <Label FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Text="{Binding DataItem.quantity_available, Source={x:Reference root}, StringFormat='{0:0.##}'}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Cant.xU.M:"
                               FontSize="10"
                               TextColor="Gray"
                               VerticalOptions="Center" />
                        <Label FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Text="{Binding DataItem.quantity_available_by_uom, Source={x:Reference root}, StringFormat='{0:0.##}'}" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <Label FontSize="10"
                       TextColor="Gray"
                       LineBreakMode="TailTruncation"
                       MaxLines="2">
                    <Label.Text>
                        <Binding Path="DataItem.uom_display_name"
                                 Source="{x:Reference root}"
                                 StringFormat="U.M.: {0}" />
                    </Label.Text>
                </Label>
            </VerticalStackLayout>

            <!-- Devolver -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="1"
                                 VerticalOptions="Center">
                <Label Text="Devolver"
                       FontSize="9"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="NoWrap" />
                <Entry x:Name="entryCantidad"
                       Keyboard="Numeric"
                       FontSize="12"
                       HeightRequest="32"
                       HorizontalTextAlignment="Center"
                       Text="{Binding DataItem.quantity, Source={x:Reference root}, Mode=TwoWay}" />
                <Label FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#444444"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       IsVisible="{Binding DataItem.show_uom_conversion, Source={x:Reference root}}">
                    <Label.Text>
                        <Binding Path="DataItem.quantity_by_uom"
                                 Source="{x:Reference root}"
                                 StringFormat="= {0:0.##}" />
                    </Label.Text>
                </Label>
            </VerticalStackLayout>

            <!-- Botones -->
            <VerticalStackLayout Grid.Column="2"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <Button WidthRequest="40"
                        HeightRequest="32"
                        CornerRadius="4"
                        BackgroundColor="Orange"
                        Padding="0"
                        Clicked="Button_Clicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid" Glyph="&#xf55a;" Color="White" Size="13"/>
                    </Button.ImageSource>
                </Button>
                <Button WidthRequest="40"
                        HeightRequest="32"
                        CornerRadius="4"
                        BackgroundColor="Red"
                        Padding="0"
                        Command="{Binding DeleteCommand, Source={x:Reference root}}"
                        CommandParameter="{Binding BindingContext, Source={x:Reference root}}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid" Glyph="&#xf2ed;" Color="White" Size="13"/>
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
