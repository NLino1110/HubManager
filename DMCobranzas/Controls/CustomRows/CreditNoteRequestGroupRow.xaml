<?xml version="1.0" encoding="utf-8" ?>
<SwipeView
    x:Class="DMCobranzas.Controls.CustomRows.CreditNoteRequestGroupRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:DMCobranzas.Controls"
    x:Name="Root">

    <!-- ================= RIGHT SWIPE ================= -->
    <SwipeView.RightItems>
        <SwipeItems SwipeBehaviorOnInvoked="RemainOpen">
            <SwipeItemView>
                <StackLayout
                    Orientation="Horizontal"
                    Margin="5">

                    <!-- TICKET -->
                    <Button Text="TICKET"
                            FontAttributes="Bold"
                            BackgroundColor="WhiteSmoke"
                            TextColor="Black"
                            Command="{Binding TicketCommand,
                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                            FontSize="13"
                            CornerRadius="5"
                            MaximumWidthRequest="120"
                            HorizontalOptions="Center"
                            Margin="1"
                            ContentLayout="Top,0">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf02f;"
                                Size="20"
                                Color="Black"/>
                        </Button.ImageSource>
                    </Button>

                    <!-- EDITAR -->
                    <Button Text="EDITAR"
                            FontAttributes="Bold"
                            BackgroundColor="LimeGreen"
                            TextColor="WhiteSmoke"
                            IsVisible="False"
                            Command="{Binding EditCommand,
                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                            FontSize="13"
                            CornerRadius="5"
                            MaximumWidthRequest="120"
                            HorizontalOptions="Center"
                            Margin="1"
                            ContentLayout="Top,0">

                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                         Value="PENDIENTE">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Button"
                                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                         Value="ERROR">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Button.Triggers>
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf303;"
                                Size="20"
                                Color="White"/>
                        </Button.ImageSource>
                    </Button>

                    <!-- ENVIAR -->
                    <Button Text="ENVIAR"
                            BackgroundColor="DeepSkyBlue"
                            TextColor="WhiteSmoke"
                            IsVisible="False"
                            Command="{Binding SendItemCommand,
                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                            FontSize="13"
                            CornerRadius="5"
                            MaximumWidthRequest="120"
                            HorizontalOptions="Center"
                            Margin="1"
                            ContentLayout="Top,0">

                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                         Value="PENDIENTE">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Button"
                                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                         Value="ERROR">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Button.Triggers>
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FontAwesome5Solid"
                                Glyph="&#xf1d8;"
                                Size="20"
                                Color="White"/>
                        </Button.ImageSource>
                    </Button>

                    <Button Text="BORRAR"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        IsVisible="False"
                        Command="{Binding DeleteCommand,
                        Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                        CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                        FontSize="13"
                        CornerRadius="5"
                        MaximumWidthRequest="120"
                        HorizontalOptions="Center"
                        Margin="1"
                        ContentLayout="Top,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                    Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                    Value="PENDIENTE">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Button"
                                 Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                 Value="ERROR">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Button.Triggers>
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
                                Glyph="&#xf2ed;"
                                Size="20"
                                Color="White"/>
                        </Button.ImageSource>
                    </Button>

                </StackLayout>
            </SwipeItemView>
        </SwipeItems>
    </SwipeView.RightItems>

    <Border
        StrokeThickness="0.3"  
        Padding="5,0"
        Margin="0,1"
        BackgroundColor="Transparent"        
        MinimumHeightRequest="70">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="5,5,5,5">
            </RoundRectangle>
        </Border.StrokeShape>

        <Grid Padding="2"
            ColumnSpacing="5"
            RowSpacing="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Partner -->
            <Label Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="12"
                   FontAttributes="Bold"
                   Padding="10,0,0,0"
                   Text="{Binding DataItem.partner_display, Source={x:Reference Root}}" />

            <Label Grid.Row="1"
                   Grid.Column="0"
                   FontSize="12"
                   TextColor="DimGray"
                   Padding="10,0,0,0"
                   Text="{Binding DataItem.create_datetime, Source={x:Reference Root}}" />

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Padding="10,0,0,0"
                   Text="{Binding DataItem.request_name, Source={x:Reference Root}}" />

            <!-- STATUS INDICATOR -->
            <ui:IndicatorLabelUI
                Grid.Column="0"
                Grid.Row="3"
                Text="{Binding DataItem.request_status, Source={x:Reference Root}}"
                TextColor="White"
                TextBackgroundColor="DarkSeaGreen"
                VerticalOptions="Center">
                <ui:IndicatorLabelUI.Triggers>
                    <DataTrigger TargetType="ui:IndicatorLabelUI"
                                 Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                 Value="PENDIENTE">
                        <Setter Property="TextBackgroundColor"
                                Value="Orange"/>
                    </DataTrigger>
                    <DataTrigger TargetType="ui:IndicatorLabelUI"
                                 Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                                 Value="ERROR">
                        <Setter Property="TextBackgroundColor"
                                Value="OrangeRed"/>
                    </DataTrigger>
                </ui:IndicatorLabelUI.Triggers>
            </ui:IndicatorLabelUI>            

            <ui:IndicatorUI Text="&#xf0d9;" 
                TextColor="DodgerBlue" 
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="2"
                VerticalOptions="Center"></ui:IndicatorUI>

            <StackLayout 
                Grid.Row="0"
                Grid.Column="3"
                Grid.RowSpan="4"
                Orientation="Horizontal"
                Margin="5"
                VerticalOptions="Center">

                <StackLayout.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean">
                        <On Platform="WinUI" Value="True"/>
                        <On Platform="Android,iOS,MacCatalyst" Value="False"/>
                    </OnPlatform>
                </StackLayout.IsVisible>
                
                <Button Text="TICKET"
                        BackgroundColor="WhiteSmoke"
                        TextColor="Black"
                        FontAttributes="Bold"
                        Command="{Binding TicketCommand,
                        Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                        CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                        FontSize="13"
                        CornerRadius="5"
                        MaximumWidthRequest="120"
                        HorizontalOptions="Center"
                        Margin="1"
                        ContentLayout="Top,0">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                             Glyph="&#xf02f;"
                             Size="20"
                             Color="Black"/>
                    </Button.ImageSource>
                </Button>
                
                <Button Text="EDITAR"
                    BackgroundColor="LimeGreen"
                    TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                    IsVisible="False"
                    Command="{Binding EditCommand,
                    Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                    FontSize="13"
                    CornerRadius="5"
                    MaximumWidthRequest="120"
                    HorizontalOptions="Center"
                    Margin="1"
                    ContentLayout="Top,0">

                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="PENDIENTE">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="ERROR">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                             Glyph="&#xf303;"
                             Size="20"
                             Color="WhiteSmoke"/>
                    </Button.ImageSource>
                </Button>

                <!-- ENVIAR -->
                <Button Text="ENVIAR"
                    BackgroundColor="DeepSkyBlue"
                    TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                    IsVisible="False"
                    Command="{Binding SendItemCommand,
                    Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                    FontSize="13"
                    CornerRadius="5"
                    MaximumWidthRequest="120"
                    HorizontalOptions="Center"
                    Margin="1"
                    ContentLayout="Top,0">

                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="PENDIENTE">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="ERROR">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf1d8;"
                         Size="20"
                         Color="WhiteSmoke"/>
                    </Button.ImageSource>
                </Button>

                <!-- BORRAR -->
                <Button Text="BORRAR"
                    BackgroundColor="Red"
                    TextColor="White"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Command="{Binding DeleteCommand,
                    Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding Source={x:Reference Root}, Path=DataItem}"
                    FontSize="13"
                    CornerRadius="5"
                    MaximumWidthRequest="120"
                    HorizontalOptions="Center"
                    Margin="1"
                    ContentLayout="Top,0">

                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="PENDIENTE">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Button"
                         Binding="{Binding DataItem.request_status, Source={x:Reference Root}}"
                         Value="ERROR">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                            Glyph="&#xf2ed;"
                            Size="20"
                            Color="White"/>
                    </Button.ImageSource>
                </Button>

            </StackLayout>


        </Grid>
    </Border>
</SwipeView>

