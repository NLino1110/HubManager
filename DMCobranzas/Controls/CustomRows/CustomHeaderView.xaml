<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.Controls.CustomRows.CustomHeaderView">
    <StackLayout
        HorizontalOptions="Fill"
        VerticalOptions="Center"
        Margin="0"
        Padding="0">
        <Border
            BackgroundColor="SlateGray"
            StrokeThickness="0.2"
            Padding="0"
            Margin="0"
            HeightRequest="35"
            VerticalOptions="Center">

            <Grid Padding="0" ColumnSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="0"
                    Text="{Binding BindingContext.Title, Source={x:Reference Root}}"
                    TextColor="WhiteSmoke"
                    FontSize="14"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="Transparent"
                    Margin="5,0,0,0" />

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    
                    <!--<StackLayout
                        HeightRequest="55"
                        Padding="5,5,5,5"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        BackgroundColor="GhostWhite">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Button1Command, Source={x:Reference ThisView}}"
                                CommandParameter="{Binding CommandParameter, Source={x:Reference ThisView}}" />
                        </StackLayout.GestureRecognizers>

                        <Label
                            Text="REPORTE"
                            FontSize="8"
                            FontAttributes="Bold"
                            TextColor="DodgerBlue"
                            VerticalTextAlignment="Center"
                            HorizontalTextAlignment="Center" />
                    </StackLayout>-->
                    
                    <Button                        
                        Text="REPORTE"
                        VerticalOptions="Start"                        
                        CornerRadius="2"
                        BorderColor="DodgerBlue"
                        BorderWidth="1"
                        BackgroundColor="GhostWhite"
                        FontAttributes="Bold"
                        FontSize="8"
                        TextColor="DodgerBlue"                    
                        IsVisible="{Binding ShowButton1, Source={x:Reference Root}}"
                        Command="{Binding Button1Command, Source={x:Reference Root}}"
                        CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />

                    <Button                        
                        Text="CIERRE"
                        CornerRadius="2"
                        BorderColor="DodgerBlue"
                        BorderWidth="1"
                        BackgroundColor="GhostWhite"
                        FontAttributes="Bold"
                        FontSize="8"
                        TextColor="DodgerBlue"
                        Margin="0"
                        IsVisible="{Binding ShowButton2, Source={x:Reference Root}}"
                        Command="{Binding Button2Command, Source={x:Reference Root}}"
                        CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </StackLayout>
</ContentView>
