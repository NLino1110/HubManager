<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.Controls.CustomListItem">
    <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Aqua">
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" 
                                                Swiped="OnSwipeLeft"                                                
                                                CommandParameter="{Binding .}"/>
            <!--<SwipeGestureRecognizer Direction="Right" 
                                                Swiped="OnSwipeRight" 
                                                CommandParameter="{Binding .}"/>-->
        </Grid.GestureRecognizers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackLayout Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
            <Label Text="{Binding Title1}" FontAttributes="Bold"/>
            <Label Text="{Binding Title2}" FontAttributes="Bold"/>
        </StackLayout>
        <StackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center">
            <Label Text="{Binding Tag1}"/>
            <Label Text="{Binding Tag2}"/>
            <Label Text="{Binding Description1}"/>
            <Label Text="{Binding Description2}"/>
        </StackLayout>
        <StackLayout x:Name="ActionsBox" Grid.Row="1" Grid.RowSpan="1" Grid.Column="1" VerticalOptions="Center" WidthRequest="30">
            <StackLayout Orientation="Horizontal">
                <!--<Button Text="I" Clicked="ClickShowHideTools"/>-->
                <Button Text="Button 1"/>
                <Button Text="Button 2"/>
            </StackLayout>
        </StackLayout>
        <!--<BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="LightGray" Margin="0,5,0,0"/>-->
    </Grid>
</ContentView>
