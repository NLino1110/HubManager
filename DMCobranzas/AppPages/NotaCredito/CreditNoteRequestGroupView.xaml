<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="DMCobranzas.AppPages.NotaCredito.CreditNoteRequestGroupView"
             xmlns:converters="clr-namespace:DMCobranzas.Converters"
             xmlns:bh="clr-namespace:DMCobranzas.Controls.Behaviors"
             xmlns:ui="clr-namespace:DMCobranzas.Controls"
             Title="Grupo">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:RequestTypeConverter x:Key="RequestTypeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="btnSave" Text="GUARDAR" Clicked="btnSave_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf0c7;"
                         Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem x:Name="btnCancel" Text="CANCELAR" Clicked="btnClose_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf410;"
                         Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FontAwesome5Solid"
                                 Glyph="&#xf3d1;"
                                 Color="Black" />
    </ContentPage.IconImageSource>
    <StackLayout>
        <Grid x:Name="GridParent" HorizontalOptions="FillAndExpand" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="3"
                  Grid.Row="0"
                  Grid.Column="0"
                  x:Name="GridPartner">
                <Entry x:Name="txtCliente"
                       Placeholder="Seleccione un cliente..."
                       PlaceholderColor="SlateGray"
                       HorizontalOptions="FillAndExpand"
                       IsReadOnly="True"
                       MinimumWidthRequest="190"
                       FontAttributes="Bold">
                    <Entry.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEntryTapped"
                                              NumberOfTapsRequired="1" />
                    </Entry.GestureRecognizers>
                </Entry>
            </Grid>

            <HorizontalStackLayout x:Name="StackActions"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Spacing="4"
                                   VerticalOptions="Center"
                                   Margin="5,3,3,3">
                <Button x:Name="btnCustomerSearch"
                        Style="{StaticResource IconSearchButtonStyle}"
                        Text=""
                        Clicked="btnCustomer_Clicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="12"
                                         FontAutoScalingEnabled="True"
                                         Glyph="&#xf002;" />
                    </Button.ImageSource>
                </Button>

                <Button x:Name="btnRemoveCustomer"
                        Style="{StaticResource IconClearButtonStyle}"
                        Clicked="btnRemoveCustomer_Clicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="12"
                                         FontAutoScalingEnabled="True"
                                         Glyph="&#xf00d;" />
                    </Button.ImageSource>
                </Button>

                <Button x:Name="BtnAddNew"
                        Text="Agregar"
                        BackgroundColor="DodgerBlue"
                        FontAttributes="Bold"
                        CornerRadius="4"
                        Padding="8,4">
                    <Button.Behaviors>
                        <bh:SafeTapBehavior Command="{Binding AddCNCommand}" />
                    </Button.Behaviors>
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="20"
                                         FontAutoScalingEnabled="True"
                                         Glyph="&#xf067;" />
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Start"
                   Text="Importante: cada detalle que agregue se registrará como una nota de crédito individual y quedará asociada al cliente seleccionado."
                   VerticalTextAlignment="Center"
                   FontAttributes="Bold"
                   TextColor="DimGray"
                   FontSize="12" />

            <StackLayout Grid.Row="3"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Orientation="Horizontal">
                <Label x:Name="txtTotalPagado"
                       HorizontalOptions="Center"
                       Text="TOTAL PAGO: $ 0.00"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       IsVisible="false" />
                <Label x:Name="txtTotalAplicado"
                       HorizontalOptions="Center"
                       Text="TOTAL APLICADO: $ 0.00"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       IsVisible="false" />
            </StackLayout>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter TargetName="GridPartner" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GridPartner" Property="Grid.Column" Value="0" />
                            <Setter TargetName="GridPartner" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="StackActions" Property="Grid.Row" Value="1" />
                            <Setter TargetName="StackActions" Property="Grid.Column" Value="0" />
                            <Setter TargetName="StackActions" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="StackActions" Property="HorizontalOptions" Value="Center" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter TargetName="GridPartner" Property="Grid.Row" Value="0" />
                            <Setter TargetName="GridPartner" Property="Grid.Column" Value="0" />
                            <Setter TargetName="GridPartner" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="StackActions" Property="Grid.Row" Value="0" />
                            <Setter TargetName="StackActions" Property="Grid.Column" Value="1" />
                            <Setter TargetName="StackActions" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="StackActions" Property="HorizontalOptions" Value="End" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>


        <Border StrokeThickness="0.4" Padding="10" Margin="1" BackgroundColor="Gray">
            <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>                    
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Text="Notas de Credito" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                
            </Grid>
        </Border>
        
        <CollectionView x:Name="collectionView" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView x:Name="swipeView" IsClippedToBounds="true">
                        <SwipeView.RightItems>
                            <SwipeItems SwipeBehaviorOnInvoked="RemainOpen">
                                <SwipeItemView>
                                    <StackLayout Orientation="Horizontal" Margin="5,5,5,5">
                                        <Button                                                 
                                            CornerRadius="5"
                                        ContentLayout="Top,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                        CommandParameter="{Binding .}" 
                                            MaximumWidthRequest="120"                                                    
                                        BackgroundColor="Red"
                                        Text="BORRAR"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                                Margin="1,1,1,1">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                            Color="White"
                                            Size="20"
                                            FontAutoScalingEnabled="True"                                                         
                                            Glyph="&#xf2ed;" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button                                                 
                                            CornerRadius="5"
                                        ContentLayout="Top,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                        CommandParameter="{Binding .}" 
                                            MaximumWidthRequest="120"
                                        BackgroundColor="LimeGreen"
                                        Text="EDITAR"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                            Margin="1,1,1,1">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                            Color="White"
                                            Size="20"
                                            FontAutoScalingEnabled="True"                                                         
                                            Glyph="&#xf303;" />
                                            </Button.ImageSource>
                                        </Button>
                                    </StackLayout>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Border StrokeThickness="0.3" Padding="5, 0, 5, 0" Margin="1" BackgroundColor="White" MinimumHeightRequest="70">
                            <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" 
                                   Grid.Column="0" 
                                   HorizontalOptions="Start" 
                                   VerticalOptions="Center"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   Text="{Binding partner_name}"/>
                                
                                <Label Grid.Row="1" Grid.Column="0" 
                                       HorizontalOptions="Start" 
                                       VerticalOptions="Center"
                                       FontSize="11"
                                       Text="{Binding display_parent_nc}"/>

                                <Label Grid.Row="2" Grid.Column="0" 
                                       HorizontalOptions="Start" 
                                       VerticalOptions="Center"
                                       FontSize="11"
                                       Text="{Binding display_type_module}"/>                                

                                <ui:IndicatorLabelUI
                                    Text="{Binding request_type, Converter={StaticResource RequestTypeConverter}}"
                                    Grid.Row="0" 
                                    Grid.Column="1"
                                    Grid.RowSpan="3"
                                    TextColor="GhostWhite"
                                    TextBackgroundColor="LimeGreen"
                                    HorizontalOptions="Start">
                                </ui:IndicatorLabelUI>

                                <StackLayout Grid.Row="0" 
                                                Grid.Column="2" 
                                             Grid.RowSpan="3"
                                                Orientation="Horizontal" 
                                                Margin="2"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.isWindows}">
                                        
                                    <Button CornerRadius="5"
                                        ContentLayout="Top,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                        CommandParameter="{Binding .}" 
                                        MaximumWidthRequest="120"
                                        BackgroundColor="Red"
                                        Text="BORRAR"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                            Margin="1,1,1,1">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FontAwesome5Solid"
                                            Color="White"
                                            Size="20"
                                            FontAutoScalingEnabled="True"                                                         
                                            Glyph="&#xf2ed;" />
                                        </Button.ImageSource>
                                    </Button>
                                    <Button CornerRadius="5"
                                        ContentLayout="Top,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                        CommandParameter="{Binding .}" 
                                        MaximumWidthRequest="120"
                                        BackgroundColor="LimeGreen"
                                        Text="EDITAR"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                            Margin="1,1,1,1">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FontAwesome5Solid"
                                            Color="White"
                                            Size="20"
                                            FontAutoScalingEnabled="True"                                                         
                                            Glyph="&#xf303;" />
                                        </Button.ImageSource>
                                    </Button>
                                </StackLayout>

                                <ui:IndicatorUI Text="&#xf0d9;" 
                                    TextColor="DodgerBlue" 
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="3"
                                    VerticalOptions="Center"></ui:IndicatorUI>                                    
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>
</ContentPage>