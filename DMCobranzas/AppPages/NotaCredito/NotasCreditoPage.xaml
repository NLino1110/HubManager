    <StackLayout HorizontalOptions="Fill">
        <StackLayout Orientation="Vertical" Margin="4">
            <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" Margin="10, 0,0,0">
                <Label Text="Empresa:" VerticalOptions="Center" WidthRequest="100" TextColor="DodgerBlue"></Label>
                <Picker x:Name="SelectorCmp"
                    Title=""
                    ItemDisplayBinding="{Binding name}"
                    SelectedIndexChanged="OnPickerSelectedIndexChanged"
                    Margin="0,0,0,0" 
                    HorizontalOptions="FillAndExpand"/>
                </StackLayout>

            <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" Margin="10, 0,0,0">
                <Label Text="F. desde:" WidthRequest="100" VerticalTextAlignment="Center" TextColor="DodgerBlue"></Label>
                <DatePicker x:Name="dateIni" HorizontalOptions="FillAndExpand"/>
            </StackLayout>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" Margin="10, 0,0,0">
                <Label Text="F. hasta:" WidthRequest="100" VerticalTextAlignment="Center" TextColor="DodgerBlue"></Label>
                <DatePicker x:Name="dateEnd" HorizontalOptions="FillAndExpand"/>
            </StackLayout>
            <StackLayout Orientation="Horizontal" Margin="10">
