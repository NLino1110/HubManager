                        BackgroundColor="DodgerBlue" 
                        Text="Buscar" 
                        Margin="2" 
                        Clicked="btnBuscar_Clicked"
                        HeightRequest="35" Padding="10,0,10,0">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="14"
                                         FontAutoScalingEnabled="True"                                                         
                                         Glyph="&#xf002;" />
                    </Button.ImageSource>
                </Button>

                <Button CornerRadius="2" x:Name="btnNewGroup"
                        Text="Grupo/Solicitudes" 
                        Margin="2" 
                        Clicked="btnNewGroup_Clicked"
                        HeightRequest="35" Padding="10,0,10,0"
                        BackgroundColor="DodgerBlue">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="14"
                                         FontAutoScalingEnabled="True"                                                         
                                         Glyph="&#xf362;" />
                    </Button.ImageSource>
                </Button>

            </StackLayout>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" Margin="10, 0,0,0">
                <Entry x:Name="txtSearch" 
                       Text=""
                       Placeholder="Buscar por Cliente" 
                       HorizontalOptions="FillAndExpand"/>
            </StackLayout>
        </StackLayout>
        
