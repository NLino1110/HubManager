<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"			
				x:Class="CobranzasDMSA_Odoo.AppPages.NotaCredito.AccountMoveSendProdCrud"
				xmlns:control="clr-namespace:CobranzasDMSA_Odoo.Controls"
				Title="MultiplePopupPage">
    <ContentPage.ToolbarItems>
		<ToolbarItem x:Name="btnSaveToolbar" Text="GUARDAR" Clicked="btnSave_Clicked">
			<ToolbarItem.IconImageSource>
				<FontImageSource FontFamily="FontAwesome5Solid"
								 Glyph="&#xf0c7;"
								 Color="White" />
			</ToolbarItem.IconImageSource>
		</ToolbarItem>
		<ToolbarItem x:Name="btnCancelToolbar" Text="CANCELAR" Clicked="btnClose_Clicked">
			<ToolbarItem.IconImageSource>
				<FontImageSource FontFamily="FontAwesome5Solid"
								 Glyph="&#xf410;"
								 Color="White" />
			</ToolbarItem.IconImageSource>
		</ToolbarItem>
	</ContentPage.ToolbarItems>
	<ContentPage.Content>
        
        <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
		<StackLayout>
                <!--TOP-->
                <!--<Grid BackgroundColor="WhiteSmoke" Padding="0,5,0,5" HeightRequest="55">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="130"/>
