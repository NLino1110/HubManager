                </Grid>-->

                <AbsoluteLayout Margin="0" MinimumHeightRequest="50" Padding="0" BackgroundColor="{StaticResource Primary}">
                    <Label x:Name="lblTitle" Text="SOLICITUD-CLIENTE NOMBRE" 
                           VerticalOptions="Center" Margin="2,0,0,0" 
                           TextColor="DarkBlue" FontSize="18" FontAttributes="Bold"
                           AbsoluteLayout.LayoutFlags="All"
                           AbsoluteLayout.LayoutBounds="0, 0.5, 1, 1"></Label>


                    <!--<Button x:Name="btnSaveTop" 
                            Text="GUARDAR" Clicked="btnSave_Clicked" 
                            Margin="2" BackgroundColor="SeaGreen" FontAttributes="Bold" FontSize="12">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
Glyph="&#xf0c7;"
Color="White"
    Size="20"/>
                        </Button.ImageSource>
                    </Button>
                    <Button x:Name="btnCancelTop" Text="CANCELAR" 
                            Clicked="btnClose_Clicked" 
                            Margin="2" 
                            BackgroundColor="OrangeRed" 
                            FontAttributes="Bold" 
                            FontSize="12">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
Glyph="&#xf00d;"
Color="White" Size="20"/>
                        </Button.ImageSource>
                    </Button>-->

                    <StackLayout Orientation="Horizontal"
AbsoluteLayout.LayoutFlags="All"
AbsoluteLayout.LayoutBounds="0, 1, 1, 0.5"
HorizontalOptions="End"
VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" x:Name="TopTools" IsVisible="False" 
    MaximumHeightRequest="40" 
    ZIndex="1">
                            <Button x:Name="btnSave" 
   Text="GUARDAR" 
   FontSize="12" 
   Clicked="btnSave_Clicked" 
   Margin="1" 
   BackgroundColor="DodgerBlue" 
   CornerRadius="2"
   FontAttributes="Bold"
   HeightRequest="28"
   Padding="10,0,10,0">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome5Solid"
    Glyph="&#xf0c7;"
    Color="White"
        Size="15"/>
                                    <!-- Icono de notificaciones -->
                                </Button.ImageSource>
                            </Button>
                            <Button x:Name="btnCancel" Text="SALIR" 
   FontSize="12" 
   Clicked="btnClose_Clicked" 
   Margin="1" 
   BackgroundColor="OrangeRed" FontAttributes="Bold"
   CornerRadius="2"
   HeightRequest="28"
   Padding="10,0,10,0">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome5Solid"
    Glyph="&#xf00d;"
    Color="White" 
    Size="15"/>
                                    <!-- Icono de notificaciones -->
                                </Button.ImageSource>
                            </Button>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" 
    VerticalOptions="Start">
                            <Button x:Name="btnTopTools" 
   Text="" 
   FontSize="12" 
   Clicked="BtnTopTools_OnClicked_Clicked" 
   BackgroundColor="DodgerBlue" 
   CornerRadius="50"
   TextColor="White"
   HeightRequest="45"
   ContentLayout="Top,0"
   Padding="5,5,5,5"
   Margin="1,1,1,1">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome5Solid"
                    Glyph="&#xf0c9;"
                    Color="White" Size="18"/>
                                    <!-- Icono de notificaciones -->
                                </Button.ImageSource>
                            </Button>
                        </StackLayout>
						</StackLayout>
                </AbsoluteLayout>

                <VerticalStackLayout Spacing="12">
				<Grid Margin="15,10,15,2" HorizontalOptions="FillAndExpand">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

					<StackLayout Orientation="Horizontal" 
								 VerticalOptions="Center" Margin="0,0,4,0" 
                                 BackgroundColor="WhiteSmoke"
								 Grid.Row="0" 
                                 Grid.Column="0">
						<Picker x:Name="SelectorCmp"
					Title="Empresa:"
			 HorizontalOptions="FillAndExpand"/>
					</StackLayout>

					<StackLayout Orientation="Horizontal" VerticalOptions="Center" 
								 Margin="0,0,4,0"  BackgroundColor="WhiteSmoke"
								 Grid.Row="0" Grid.Column="1">
						<Picker x:Name="pickerModulos"
					Title="Modulos nota credito:"
			SelectedIndexChanged="pickerModulos_SelectedIndexChanged"
							HorizontalOptions="FillAndExpand" 
							/>
					</StackLayout>

					<StackLayout Orientation="Horizontal" VerticalOptions="Center" 
								 Margin="0,0,4,0" BackgroundColor="WhiteSmoke"
								 Grid.Row="0" Grid.Column="2">
						<Picker x:Name="pickerTipoNc"
					Title="Tipo nota credito:"
			HorizontalOptions="FillAndExpand"/>
					</StackLayout>

                        <StackLayout 
Orientation="Horizontal" 
 VerticalOptions="Center" 
 BackgroundColor="WhiteSmoke"
 Grid.Row="0" Grid.Column="3"
                            IsVisible="False">
                            <Picker x:Name="pickerCNJournal"
    Title="Diario:"
    HorizontalOptions="FillAndExpand"
    FontSize="12"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal"
                                 Margin="5" Grid.Row="1" 
                                 Grid.Column="0" 
                                 Grid.ColumnSpan="3" 
                                 IsVisible="false">
						<Label Text="CLIENTE:" VerticalTextAlignment="Center" TextColor="DimGray"></Label>
						<Entry x:Name="txtCliente" HorizontalOptions="FillAndExpand" IsReadOnly="True">
						</Entry>
						<Button Text="" Clicked="HandleReturnResultPopupButtonClicked" 
                                Grid.Row="1" 
                                Grid.Column="2" Margin="0,0,2,0">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
													Color="White"
													Size="20"
													FontAutoScalingEnabled="True"                                                         
													Glyph="&#x2b;" />
							</Button.ImageSource>
						</Button>
						<Button x:Name="btnRemoveCustomer" 
								Text="" Clicked="btnRemoveCustomer_Clicked" 
								Grid.Row="1" Grid.Column="2"
								BackgroundColor="PaleVioletRed">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
													Color="White"
													Size="13"
													FontAutoScalingEnabled="True"                                                         
													Glyph="&#xf068;" />
							</Button.ImageSource>
						</Button>
					</StackLayout>

					<StackLayout Orientation="Horizontal" Margin="5" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
						<Label Text="PRODUCTO:" VerticalTextAlignment="Center"></Label>
						<Entry x:Name="txtProducto" HorizontalOptions="FillAndExpand" IsReadOnly="True">
						</Entry>
						<Button Text="" Clicked="PopupSearchInvoiceButtonClicked" 
                                Grid.Row="1" Grid.Column="2"
                                Margin="0,0,2,0"
                                BackgroundColor="LightGray"
                                MaximumHeightRequest="40"
MaximumWidthRequest="45">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
								Color="DimGray"
								Size="20"
								FontAutoScalingEnabled="True"                                                         
								Glyph="&#xf078;" />
							</Button.ImageSource>
						</Button>
						<Button x:Name="btnRemoveInvoice" 
			Text="" Clicked="btnRemoveInvoice_Clicked" 
			Grid.Row="1" Grid.Column="2"
			BackgroundColor="LightGray"
                                MaximumHeightRequest="40"
								MaximumWidthRequest="45">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
								Color="DimGray"
								Size="20"
								FontAutoScalingEnabled="True"                                                         
								Glyph="&#xf00d;" />
							</Button.ImageSource>
						</Button>
					</StackLayout>
					
					<FlexLayout Wrap="Wrap" JustifyContent="Start" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
						<Label Text="Cada linea de solicitud de nota de credito sera un documento distinto en Odoo"
                               TextColor="DimGray"
                               FontSize="12"
                               FontAttributes="Bold"></Label>
						<!--<Label Text="Diario-"></Label>
						<Label Text="Punto de emision"></Label>-->
					</FlexLayout>
					
					<StackLayout Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                            <Label Text="Observaciones:" VerticalTextAlignment="Center" IsVisible="False"></Label>
                            <Entry x:Name="txtObs" Text="" HorizontalOptions="FillAndExpand" IsReadOnly="False" Placeholder="Ingresar Observaciones...">
						</Entry>
					</StackLayout>
					
					<!--<StackLayout Orientation="Horizontal" Margin="10" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">-->
					<FlexLayout Wrap="Wrap" JustifyContent="Start" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">
						<Button x:Name="btnAddAllItems" Text="Agregar" Clicked="btnLoadItems_Clicked"
								BackgroundColor="MediumSeaGreen" Margin="0,0,2,0"
                                CornerRadius="2">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
									Color="White"
									Size="15"
									FontAutoScalingEnabled="True"                                                         
									Glyph="&#xf59d;" />
							</Button.ImageSource>
						</Button>
						
						<Button x:Name="btnLoadItems" 
                                Text="" Clicked="btnLoadItems_Clicked" IsVisible="false"
                                CornerRadius="2">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
													Color="White"
													Size="20"
													FontAutoScalingEnabled="True"                                                         
													Glyph="&#xf00e;" />
							</Button.ImageSource>
						</Button>

                            <Button x:Name="btnBackAllItems" 
                        Text="Todo" Clicked="btnLoadItemsAndBack_Clicked"
BackgroundColor="OrangeRed" Margin="0,0,2,0"
                        CornerRadius="2">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome5Solid"
					Color="White"
					Size="20"
					FontAutoScalingEnabled="True"                                                         
					Glyph="&#xf049;" />
                                </Button.ImageSource>
                            </Button>
                        
                            <Button x:Name="btnClearItems" 
                                Text="Quitar" Clicked="btnClearItems_Clicked"
								BackgroundColor="PaleVioletRed" Margin="0,0,2,0"
                                CornerRadius="2">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
													Color="White"
													Size="15"
													FontAutoScalingEnabled="True"                                                         
													Glyph="&#xf056;" />
							</Button.ImageSource>
						</Button>						
						
						<Button x:Name="btnStatus" Text="XYZ" 
								Clicked="btnLoadItems_Clicked"                                 
								IsEnabled="False"
								IsVisible="False">
							<Button.ImageSource>
								<FontImageSource FontFamily="FontAwesome5Solid"
													Color="White"
													Size="20"
													FontAutoScalingEnabled="True"                                                         
													Glyph="&#xf500;" />
							</Button.ImageSource>
						</Button>

						<StackLayout Orientation="Horizontal" VerticalOptions="Center" IsVisible="false">
							<CheckBox Color="#D32F2F" IsChecked="False" x:Name="chkSelectAll" ScaleX="1.5" ScaleY="1.5" CheckedChanged="chkSelectAll_CheckedChanged"/>
							<Label Margin="0,7">
								<Label.FormattedText>
									<FormattedString>
										<Span Text="Seleccionar Todos" FontSize="18" />
									</FormattedString>
								</Label.FormattedText>
							</Label>
						</StackLayout>
					</FlexLayout>

					<StackLayout Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
						<Label x:Name="lblSummary" Text="Total registros 0" FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"></Label>
					</StackLayout>
				</Grid>
				
				<!--<Button Text="Buscar" Clicked="FinData" IsVisible="False"/>-->
			</VerticalStackLayout>

            <!--<control:HeaderLikeTable>
                    <control:HeaderLikeTable.Columns>
                        <x:String>Hola</x:String>
                        <x:String>Col2</x:String>
                        <x:String>Col3</x:String>
                        <x:String>Col4</x:String>
                    </control:HeaderLikeTable.Columns>
                </control:HeaderLikeTable>-->

                <control:HeaderLikeTable Columns="Fecha, Diario, Metodo de Pago, Importe, Referencia"/>

                <ScrollView VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <CollectionView x:Name="collectionView" VerticalOptions="FillAndExpand">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                                <control:AccountMoveInvoiceForSend AccountMoveSend="{Binding .}"></control:AccountMoveInvoiceForSend>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
			</ScrollView>
		</StackLayout>
        </ScrollView>
	</ContentPage.Content>
</ContentPage>