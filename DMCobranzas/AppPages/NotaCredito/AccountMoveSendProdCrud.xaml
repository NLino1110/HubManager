                            <FontImageSource FontFamily="FontAwesome5Solid"
                 Glyph="&#xf0c7;"
                 Color="White"
                     Size="20"/>                            
                        </Button.ImageSource>
                    </Button>
                    <Button x:Name="btnCancelTop" Text="CANCELAR" Clicked="btnClose_Clicked" Grid.Column="2" Margin="0" BackgroundColor="OrangeRed" FontAttributes="Bold">
