<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CobranzasDMSA_Odoo.AppPages.Printing.TestTool"
             Title="Configuraciones">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
            Text="Impresora Bluetooth"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <Label Text="Prueba de impresión"></Label>
            <Editor x:Name="editor" 
                    BackgroundColor="GhostWhite"                    
        HeightRequest="120"
        TextChanged="OnEditorTextChanged"
        Completed="OnEditorCompleted" 
                    IsReadOnly="False"
                    MinimumHeightRequest="120"/>

            <!--<ListView x:Name="myListView" ItemsSource="{Binding m_deviceList}">-->
            <ListView x:Name="myListView">
                    <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="btnScan"
                Text="Buscar"
                SemanticProperties.Hint="Bluetooth devices"                
                HorizontalOptions="Center" />

            <Button 
                    x:Name="btnExplore"
                    Text="Explorar"
                    SemanticProperties.Hint="Bluetooth devices"
                    Clicked="Explore"
                    HorizontalOptions="Center" />

            <Button 
                x:Name="btnPrintSetup"
                Text="Configurar"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="PrintSetup"
                HorizontalOptions="Center" />

            <Grid Padding="5" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                x:Name="btnPrintData"
                Text="Send Data"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="Print"
                HorizontalOptions="Center" />

                <Button Grid.Row="1" Grid.Column="0"
                x:Name="btnPrintGraphical"
                Text="Graphical Print"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="PrintGraphical"
                HorizontalOptions="Center" />

                <Button Grid.Row="2" Grid.Column="0"
                x:Name="btnPrintQr"
                Text="Generate Qr Code Print"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="PrintQr"
                HorizontalOptions="Center" />

                <Button Grid.Row="0" Grid.Column="1"
                x:Name="btnPrintImg"
                Text="Print Picture"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="PrintImg"
                HorizontalOptions="Center" />

                <Button Grid.Row="1" Grid.Column="1"
                x:Name="btnPrintBarCode"
                Text="Print 1D/2D Codebar"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="PrintBarCode"
                HorizontalOptions="Center" />

                <Button Grid.Row="2" Grid.Column="1"
                x:Name="btnTurnOnCamera"
                Text="Turn on the camera"
                SemanticProperties.Hint="Bluetooth devices"
                Clicked="btnTurnOnCamera_Clicked"
                HorizontalOptions="Center" />

                <Image Grid.Row="3" Grid.Column="0"
                x:Name="imgPrint"
                Source="demo.bmp"
                SemanticProperties.Description="Avantar profile picture"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center" />

                <Image Grid.Row="3" Grid.Column="1"
                x:Name="imgPrintSk"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center" />

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>