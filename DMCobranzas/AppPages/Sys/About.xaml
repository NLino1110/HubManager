<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.AppPages.Sys.About"
             Title="Acerca de la aplicación">
    <VerticalStackLayout Margin="20">
        <Border Padding="10"  Margin="10" StrokeShape="RoundRectangle 6" Stroke="LightGray">            
            <StackLayout>
                <Label Text="Dispositivo" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" Margin="10,10,10,10"/>
                <BoxView Color="LightGray" HeightRequest="1" HorizontalOptions="Fill" />
                <Label Text="NAME" VerticalOptions="Center" x:Name="lblAppName" HorizontalOptions="Center" Margin="10,10,10,10"/>                
                <Label Text="01/01/2023 00:00:00" x:Name="lblUpdated" HorizontalOptions="Center" Margin="10,10,10,10"/>
                <Label Text="-" VerticalOptions="Center" x:Name="lblUpdatedInfo" HorizontalOptions="Center" Margin="10,10,10,10"/>
                <Label Text="App version:" VerticalOptions="Center" x:Name="lblAppVersion" HorizontalOptions="Center" Margin="10,10,10,10"/>
            </StackLayout>
        </Border>

        <Grid Margin="0,0,0,0" Padding="20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />                
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </VerticalStackLayout>
</ContentPage>