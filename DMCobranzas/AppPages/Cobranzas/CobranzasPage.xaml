<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMCobranzas.AppPages.CobranzasPage"
             xmlns:local="clr-namespace:DMCobranzas"
             xmlns:control="clr-namespace:DMCobranzas.Controls"
             xmlns:controlCustom="clr-namespace:DMCobranzas.Controls.CustomRows"
             Title="Cobranzas">
    <Grid>        
        <Grid RowDefinitions="Auto,*">           
            <StackLayout Grid.Row="0" Margin="4">
                <StackLayout Orientation="Horizontal" Margin="10,0,0,0">
                    <Label Text="Empresa:" WidthRequest="70" TextColor="DodgerBlue" VerticalOptions="Center"/>
                    <Picker x:Name="SelectorCmp"
                            ItemDisplayBinding="{Binding name}"
                            SelectedIndexChanged="OnPickerSelectedIndexChanged"
                            HorizontalOptions="FillAndExpand"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="10,0,0,0">
                    <Label Text="F. desde:" WidthRequest="70" TextColor="DodgerBlue" VerticalOptions="Center"/>
                    <DatePicker x:Name="dateIni" HorizontalOptions="FillAndExpand"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="10,0,0,0">
                    <Label Text="F. hasta:" WidthRequest="70" TextColor="DodgerBlue" VerticalOptions="Center"/>
                    <DatePicker x:Name="dateEnd" HorizontalOptions="FillAndExpand"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="10">
                    <Button CornerRadius="4" Text="Buscar" BackgroundColor="DodgerBlue" HeightRequest="35" Clicked="btnBuscar_Clicked">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
                                             Glyph="&#xf002;"
                                             Color="White"
                                             Size="14"/>
                        </Button.ImageSource>
                    </Button>

                    <Button CornerRadius="4" Text="Nuevo Cobro" BackgroundColor="DodgerBlue" HeightRequest="35" Margin="5"
                            Clicked="NewPayment">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
                                             Glyph="&#xf067;"
                                             Color="White"
                                             Size="14"/>
                        </Button.ImageSource>
                    </Button>
                </StackLayout>

                <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    Padding="5,1,5,1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Margin="5,0" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="FontAwesome5Solid"
                                    Glyph="&#xf002;"
                                    Color="Gray"
                                    Size="20"/>
                            </Image.Source>
                        </Image>

                        <Entry Grid.Column="1" x:Name="txtSearch"
                               Placeholder="Buscar por Cliente"
                               BackgroundColor="Transparent"/>
                    </Grid>
                </Border>
            </StackLayout>

            <CollectionView Grid.Row="1"
                            x:Name="collectionView"
                            ItemsSource="{Binding _items}"
                            IsGrouped="True"
                            SelectionMode="None"
                            Margin="5"
                            EmptyView="No existen datos para mostrar...">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <controlCustom:CustomHeaderView
                            Title="{x:Binding Title}"
                            CommandParameter="{Binding .}"
                            ShowButton2="{x:Binding showButtonCierre}"
                            Button1Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReporteDiaCommand}"
                            Button2Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CerrarDiaCommand}"/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controlCustom:MultipleCobrosInvoiceRow Item="{x:Binding .}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid 
                Grid.Row="1" 
                  BackgroundColor="#80000000"
                  IsVisible="{Binding IsLoading}"
                  ZIndex="999">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                       Color="MediumVioletRed"
                       WidthRequest="100"
                       HeightRequest="100"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>            
        </Grid>
    </Grid>
</ContentPage>


                
