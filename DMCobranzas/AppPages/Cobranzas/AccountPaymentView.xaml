<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DMCobranzas.Converters"
             x:Class="DMCobranzas.Controls.Modals.TabbedPages.AccountPaymentView"
             xmlns:control="clr-namespace:DMCobranzas.Controls"             
             Title="PAGOS">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TipoEmisionConverter x:Key="TipoEmisionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="btnSave" Text="GUARDAR" Clicked="btnSave_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf0c7;"
                         Color="Wheat" />                
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem x:Name="btnCancel" Text="CANCELAR" Clicked="btnClose_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf410;"
                         Color="Wheat" />                
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FontAwesome5Solid"
                                 Glyph="&#xf3d1;"
                                 Color="Black" />
    </ContentPage.IconImageSource>
    <StackLayout HorizontalOptions="FillAndExpand">
        <StackLayout Orientation="Horizontal" Margin="10" HorizontalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                                
                <Grid Margin="3" 
                            Grid.Row="0" 
                            Grid.Column="0" 
                            Grid.ColumnSpan="1"
                      x:Name="GridPartner">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    
                    <!--<Label Text="CLIENTE:" VerticalTextAlignment="Center" TextColor="DimGray"></Label>-->
                    <Entry x:Name="txtCliente"
                           Placeholder="Seleccione un cliente..."
                           PlaceholderColor="SlateGray"
                           HorizontalOptions="FillAndExpand" 
                           IsReadOnly="True"
                           MinimumWidthRequest="190"
                           FontAttributes="Bold"
                           Grid.ColumnSpan="3">
                        <Entry.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="OnEntryTapped" 
                            NumberOfTapsRequired="1" />
                        </Entry.GestureRecognizers>
                    </Entry>

                    <Button 
                         Grid.Column="1"
                         CornerRadius="5"
                         Text=""
                         BackgroundColor="Transparent"                            
                         Clicked="HandleReturnResultPopupButtonClicked"                         
                         WidthRequest="2"                         
                         HeightRequest="2"
                         Margin="3"
                         Padding="5">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
								Color="DimGray"
								Size="12"
								FontAutoScalingEnabled="True"                                                         
								Glyph="&#xf002;" />
                        </Button.ImageSource>
                    </Button>
                    
                    <Button
                        Grid.Column="2"                        
                        WidthRequest="20"                        
                        HeightRequest="20"
                        CornerRadius="5"
                        Margin="0,0,5,0"
                        x:Name="btnRemoveCustomer" 						
                        Clicked="btnRemoveCustomer_Clicked"                        
						BackgroundColor="Transparent">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
											Color="DimGray"
											Size="12"
											FontAutoScalingEnabled="True"                                                         
											Glyph="&#xf00d;" />
                        </Button.ImageSource>
                    </Button>                    
                </Grid>
                
                <Button
                    CornerRadius="5"
                    BackgroundColor="DodgerBlue"
                    HorizontalOptions="Center"
                    Text="AGREGAR"                    
                    Grid.Column="1"
                    Grid.Row="0"
                    Clicked="btnAddAccountPayment_Clicked"
                    FontAttributes="Bold"                     
                    Margin="0,8,0,8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="20"
                                         FontAutoScalingEnabled="True"                                         
                                         Glyph="&#x2b;" />
                    </Button.ImageSource>
                </Button>

                <Button 
                    CornerRadius="5"
                    Grid.Row="0" 
                    Grid.Column="2" x:Name="btnCustomerAccounts" 
                    Clicked="ResultPopupAccountMove"
                    Text="Ver saldos" 
                    BackgroundColor="DeepSkyBlue"                     
                    Margin="0,8,0,8"
                    HorizontalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="20"
                                         FontAutoScalingEnabled="True"                                                         
                                         Glyph="&#xf4c0;" />
                    </Button.ImageSource>
                </Button>
                
                <!--<Button HorizontalOptions="Center"
                        Text="NUEVO PAGO"
                        Margin="5"
                        Grid.Column="0"
                        Grid.Row="1"
                        Clicked="Button_Clicked"
                        FontAttributes="Bold">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                                    Color="White"
                                                    Size="20"
                                                    FontAutoScalingEnabled="True"                                         
                                                    Glyph="&#xf155;" />
                    </Button.ImageSource>
                </Button>-->

                <HorizontalStackLayout Grid.Column="0" Grid.Row="2" Spacing="10" Margin="10">
                    <Label HorizontalOptions="Center" 
                           Text="Cada línea de pago es un registro individual en Odoo." 
                           VerticalTextAlignment="Center"  
                           Grid.Column="0" 
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           FontAttributes="Bold"
                           TextColor="DimGray" IsVisible="False"></Label>

                    <Label HorizontalOptions="Center" 
                        Text="Id:" 
                        VerticalTextAlignment="Center"  
                        FontAttributes="Bold"
                        TextColor="DimGray"></Label>

                    <Label HorizontalOptions="Center" 
                        Text="{Binding Sel_MultipleCobrosInvoice.id}" 
                        VerticalTextAlignment="Center"  
                        FontAttributes="Bold"
                        TextColor="DimGray"></Label>

                    <Label HorizontalOptions="Center" 
                        Text="Secuencial Recibo:" 
                        VerticalTextAlignment="Center"  
                        FontAttributes="Bold"
                        TextColor="DimGray" IsVisible="False"></Label>

                    <Label HorizontalOptions="Center" 
                           x:Name="lblReceiptReceipt"
                            Text="0000" 
                            VerticalTextAlignment="Center"  
                            FontAttributes="Bold"
                            TextColor="DimGray" IsVisible="False"></Label>

                    <Label x:Name="txtTotalPagado" 
                           HorizontalOptions="Center" 
                           Text="TOTAL PAGO: $ 0.00" 
                           VerticalTextAlignment="Center"  
                           FontAttributes="Bold"
                           Margin="20,0,0,0"></Label>

                    <Label x:Name="txtTotalAplicado" 
                           HorizontalOptions="Center" 
                           Text="TOTAL APLICADO: $ 0.00" 
                           VerticalTextAlignment="Center"  
                           FontAttributes="Bold" IsVisible="false"></Label>
                </HorizontalStackLayout>
            </Grid>            
        </StackLayout>

        <Border Padding="10" Margin="1" BackgroundColor="Gray" StrokeThickness="0.3">
            <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <!--<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>-->
                    <!--<ColumnDefinition Width="Auto"/>-->
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Text="Listado de pagos" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <!--<Label Grid.Row="0" Grid.Column="1" HorizontalOptions="Start" VerticalOptions="Center" Text="Diario" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Text="Método de Pago" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="4" HorizontalOptions="Start" VerticalOptions="Center" Text="Importe" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="5" HorizontalOptions="Start" VerticalOptions="Center" Text="Referencia" TextColor="WhiteSmoke" FontAttributes="Bold"/>-->
            </Grid>
        </Border>
        
        <!--<ScrollView VerticalOptions="FillAndExpand">-->
            <CollectionView x:Name="collectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView x:Name="swipeView" IsClippedToBounds="true">
                            <SwipeView.RightItems>
                                <SwipeItems SwipeBehaviorOnInvoked="RemainOpen">
                                    <SwipeItemView>
                                        <StackLayout Orientation="Horizontal" Margin="5,2,5,2" Spacing="2">
                                            <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                            CommandParameter="{Binding .}"
                                                    WidthRequest="55"
                                            BackgroundColor="Red"
                                            Text="BORRAR"
                                            FontAttributes="Bold"
                                            FontSize="8"
                                            HorizontalOptions="Center"
                                                    Padding="0,8,0,3">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf2ed;" />
                                                </Button.ImageSource>
                                            </Button>
                                            <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                            CommandParameter="{Binding .}" WidthRequest="55"
                                            BackgroundColor="LimeGreen"
                                            Text="EDITAR"
                                            FontAttributes="Bold"
                                            FontSize="8"
                                            HorizontalOptions="Center"                                                    
                                                    Padding="0,8,0,3">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf303;" />
                                                </Button.ImageSource>
                                            </Button>
                                        </StackLayout>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <!-- Content -->
                            <Border Padding="10" Margin="0" BackgroundColor="Transparent" StrokeThickness="0.3">
                                <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" TextTransform="Uppercase" Text="{Binding Type, Converter={StaticResource TipoEmisionConverter}}" FontAttributes="Bold" VerticalOptions="Center"></Label>
                                    <!--<Label Grid.Row="0" Grid.Column="1" Text="{Binding JournalId}" VerticalOptions="Center"></Label>-->
                                    <!--<Label Grid.Row="0" Grid.Column="2" Text="{Binding journal_name}" VerticalOptions="Center"></Label>-->
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='$ {0}'}"  FontAttributes="Bold" VerticalOptions="Center"></Label>
                                    
                                    <!--<Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Margin="15">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding JournalId}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="-"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="{Binding journal_name}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text=" ("
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="$ "
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="{Binding Amount}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text=")"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>-->
                                    <StackLayout Grid.Row="0" 
                                                 Grid.RowSpan="3" 
                                                 Grid.Column="4" 
                                                 Orientation="Horizontal"
                                                 Margin="2"
                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.isWindows}">
                                        <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                            CommandParameter="{Binding .}" 
                                            MaximumWidthRequest="120"
                                            BackgroundColor="Red"
                                            Text=""
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf2ed;" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                            CommandParameter="{Binding .}" MaximumWidthRequest="120"
                                            BackgroundColor="LimeGreen"
                                            Text=""
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf303;" />
                                            </Button.ImageSource>
                                        </Button>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" 
                                         Grid.RowSpan="1" 
                                         Grid.Column="5"
                                         VerticalOptions="Center">

                                    <control:IndicatorUI Text="&#xf0d9;" TextColor="DodgerBlue"></control:IndicatorUI>
                                </StackLayout>                                    
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        <!--</ScrollView>-->
    </StackLayout>
</ContentPage>