<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="DMCobranzas.Controls.Modals.TabbedPages.AccountPaymentView"
             xmlns:control="clr-namespace:DMCobranzas.Controls"
             Title="PAGOS">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="btnSave" Text="GUARDAR" Clicked="btnSave_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf0c7;"
                         Color="Black" />                
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem x:Name="btnCancel" Text="CANCELAR" Clicked="btnClose_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesome5Solid"
                         Glyph="&#xf410;"
                         Color="Black" />                
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FontAwesome5Solid"
                                 Glyph="&#xf3d1;"
                                 Color="Black" />
    </ContentPage.IconImageSource>
    <StackLayout HorizontalOptions="FillAndExpand">
        <StackLayout Orientation="Horizontal" Margin="10" HorizontalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>                    
                </Grid.ColumnDefinitions>
                
                <StackLayout Orientation="Horizontal"
                            Margin="3" 
                            Grid.Row="0" 
                            Grid.Column="0" 
                            Grid.ColumnSpan="2">
                    <!--<Label Text="CLIENTE:" VerticalTextAlignment="Center" TextColor="DimGray"></Label>-->
                    <Entry x:Name="txtCliente"
                           HorizontalOptions="FillAndExpand" 
                           IsReadOnly="True"
                           MinimumWidthRequest="190"
                           FontAttributes="Bold">
                        <Entry.GestureRecognizers>
                            <TapGestureRecognizer
                            Tapped="OnEntryTapped" 
                            NumberOfTapsRequired="1" />
                        </Entry.GestureRecognizers>
                    </Entry>
                    <Button 
                        CornerRadius="5"
                        Text=""
                            BackgroundColor="LightGray"                            
                            Clicked="HandleReturnResultPopupButtonClicked"
                            MaximumWidthRequest="30"
                            WidthRequest="30"
                            MaximumHeightRequest="30"
                            HeightRequest="30"
                            Padding="2"
                            Margin="1">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
											Color="DimGray"
											Size="12"
											FontAutoScalingEnabled="True"                                                         
											Glyph="&#xf078;" />
                        </Button.ImageSource>
                    </Button>

                    <Button
                        MaximumWidthRequest="30"
                        WidthRequest="30"
                        MaximumHeightRequest="30"
                        HeightRequest="30"
                        CornerRadius="5"
                        x:Name="btnRemoveCustomer" 
						Text=""
                        Clicked="btnRemoveCustomer_Clicked"                        
						BackgroundColor="LightGray"
                        Padding="2"
                        Margin="1">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
											Color="DimGray"
											Size="12"
											FontAutoScalingEnabled="True"                                                         
											Glyph="&#xf00d;" />
                        </Button.ImageSource>
                    </Button>                    
                </StackLayout>
                
                <Button
                    CornerRadius="2"
                    BackgroundColor="DodgerBlue"
                    HorizontalOptions="Center"
                    Text="AGREGAR"                    
                    Grid.Column="0"
                    Grid.Row="1"
                    Clicked="btnAddAccountPayment_Clicked"
                    FontAttributes="Bold"
                    MaximumHeightRequest="40" 
                    Margin="0,0,5,0">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="20"
                                         FontAutoScalingEnabled="True"                                         
                                         Glyph="&#x2b;" />
                    </Button.ImageSource>
                </Button>

                <Button 
                    CornerRadius="2"
                    Grid.Row="1" 
                    Grid.Column="1" x:Name="btnCustomerAccounts" 
                                    Clicked="ResultPopupAccountMove"
                                    Text="Ver saldos" 
                                    BackgroundColor="DeepSkyBlue"
                    MaximumHeightRequest="40" 
                    Margin="0,0,5,0" 
                    HorizontalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                         Color="White"
                                         Size="20"
                                         FontAutoScalingEnabled="True"                                                         
                                         Glyph="&#xf4c0;" />
                    </Button.ImageSource>
                </Button>
                <!--<Button HorizontalOptions="Center"
                        Text="NUEVO PAGO"
                        Margin="5"
                        Grid.Column="0"
                        Grid.Row="1"
                        Clicked="Button_Clicked"
                        FontAttributes="Bold">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesome5Solid"
                                                    Color="White"
                                                    Size="20"
                                                    FontAutoScalingEnabled="True"                                         
                                                    Glyph="&#xf155;" />
                    </Button.ImageSource>
                </Button>-->                
                
                <Label HorizontalOptions="Center" 
                       Text="Cada línea de pago es un registro individual en Odoo." 
                       VerticalTextAlignment="Center"  
                       Grid.Column="0" 
                       Grid.Row="2"
                       Grid.ColumnSpan="2"
                       FontAttributes="Bold"
                       TextColor="DimGray"
                       Margin="5" IsVisible="False"></Label>
                
                <Label x:Name="txtTotalPagado" 
                       HorizontalOptions="Center" 
                       Text="TOTAL PAGO: $ 0.00" 
                       VerticalTextAlignment="Center"  
                       Grid.Column="0" 
                       Grid.ColumnSpan="2" 
                       Grid.Row="3"
                       FontAttributes="Bold"></Label>
                
                <Label x:Name="txtTotalAplicado" 
                       HorizontalOptions="Center" 
                       Text="TOTAL APLICADO: $ 0.00" 
                       VerticalTextAlignment="Center"  
                       Grid.Column="1" 
                       Grid.Row="3"
                       FontAttributes="Bold" IsVisible="false"></Label>
            </Grid>            
        </StackLayout>

        <Border Padding="10" Margin="1" BackgroundColor="Gray" StrokeThickness="0.3">
            <Grid HorizontalOptions="FillAndExpand" BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <!--<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>-->
                    <!--<ColumnDefinition Width="Auto"/>-->
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Text="Listado de pagos" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <!--<Label Grid.Row="0" Grid.Column="1" HorizontalOptions="Start" VerticalOptions="Center" Text="Diario" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Text="Método de Pago" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="4" HorizontalOptions="Start" VerticalOptions="Center" Text="Importe" TextColor="WhiteSmoke" FontAttributes="Bold"/>
                <Label Grid.Row="0" Grid.Column="5" HorizontalOptions="Start" VerticalOptions="Center" Text="Referencia" TextColor="WhiteSmoke" FontAttributes="Bold"/>-->
            </Grid>
        </Border>
        
        <ScrollView VerticalOptions="FillAndExpand">
            <CollectionView x:Name="collectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView x:Name="swipeView" IsClippedToBounds="true">
                            <SwipeView.RightItems>
                                <SwipeItems SwipeBehaviorOnInvoked="RemainOpen">
                                    <SwipeItemView>
                                        <StackLayout Orientation="Horizontal" Margin="5,5,5,5">
                                            <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                            CommandParameter="{Binding .}" MaximumWidthRequest="120"
                                            BackgroundColor="Red"
                                            Text="BORRAR"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf2ed;" />
                                                </Button.ImageSource>
                                            </Button>
                                            <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                            CommandParameter="{Binding .}" MaximumWidthRequest="120"
                                            BackgroundColor="LimeGreen"
                                            Text="EDITAR"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf303;" />
                                                </Button.ImageSource>
                                            </Button>
                                        </StackLayout>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <!-- Content -->
                            <Border Padding="10" Margin="1" BackgroundColor="WhiteSmoke" StrokeThickness="0.3">
                                <Grid HorizontalOptions="FillAndExpand" BackgroundColor="WhiteSmoke">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Type}" VerticalOptions="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding JournalId}" VerticalOptions="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding journal_name}" VerticalOptions="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding Amount, StringFormat='$ {0}'}" VerticalOptions="Center"></Label>
                                    
                                    <!--<Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Margin="15">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding JournalId}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="-"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="{Binding journal_name}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text=" ("
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="$ "
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text="{Binding Amount}"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                                <Span Text=")"
                                                  TextColor="Black"
                                                  TextTransform="Uppercase"                                                      
                                                      FontSize="12"
                                                      FontAttributes="Bold">
                                                </Span>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>-->
                                    <StackLayout Grid.Row="0" 
                                                 Grid.RowSpan="3" 
                                                 Grid.Column="4" 
                                                 Orientation="Horizontal"
                                                 Margin="2"
                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.isWindows}">
                                        <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                                            CommandParameter="{Binding .}" 
                                            MaximumWidthRequest="120"
                                            BackgroundColor="Red"
                                            Text=""
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf2ed;" />
                                            </Button.ImageSource>
                                        </Button>
                                        <Button CornerRadius="5"
                                            ContentLayout="Top,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditItemCommand}"
                                            CommandParameter="{Binding .}" MaximumWidthRequest="120"
                                            BackgroundColor="LimeGreen"
                                            Text=""
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="FontAwesome5Solid"
                                                Color="White"
                                                Size="20"
                                                FontAutoScalingEnabled="True"                                                         
                                                Glyph="&#xf303;" />
                                            </Button.ImageSource>
                                        </Button>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" 
                                         Grid.RowSpan="1" 
                                         Grid.Column="5"
                                         VerticalOptions="Center">
                                        <!-- indicador -->
                                        <control:IndicatorUI></control:IndicatorUI>
                                    </StackLayout>                                    
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </StackLayout>
</ContentPage>