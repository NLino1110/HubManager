        <StackLayout Orientation="Vertical" BackgroundColor="#EEEEEE">
            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="10"
                Padding="30"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <!--<Image
                    Source="logo_dmujeres.png"
                    SemanticProperties.Description=""
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" IsVisible="false"/>-->

                <!--<Image
                    Source="logo_odoo.png"
                    SemanticProperties.Description=""                
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" IsVisible="false"/>-->
                
            </FlexLayout>

            <Border
                
                Padding="10,10,10,10"
                Margin="10,5,10,10"
                MaximumWidthRequest="700">

                <VerticalStackLayout
                    Spacing="20"
                    Padding="10"
                    MinimumHeightRequest="450"
                    VerticalOptions="Fill">

                    <Image
                    Source="logo_macronegocios.png"
                    SemanticProperties.Description=""
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center" />

                    <Label 
                    Text="Sistema de Pedidos"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                        FontAttributes="Bold" 
                        TextColor="Gray"
                        FontSize="19"/>                  

                    <VerticalStackLayout x:Name="CompanySelector" IsVisible="False">
                        <material:DropdownField x:Name="ddCompany"
                                Title="Compañia">
                        </material:DropdownField>
                        <material:DropdownField x:Name="ddAgency"
                            Title="Agencia" IsVisible="False">
                        </material:DropdownField>
                    <material:DropdownField x:Name="ddWarehouse"
                        Title="Bodega">
                    </material:DropdownField>

                    <FlexLayout Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center"
                            Padding="10">
                            <Button
                                x:Name="btnAccess"
                                Text="Ingresar"
                                SemanticProperties.Hint="Ingresar"
                                Clicked="btnAccess_Clicked"
                                WidthRequest="250"
                                CornerRadius="2"                                
                                BackgroundColor="IndianRed" 
                                FontAttributes="Bold"
                                Margin="3"/>

                            <Button
                                x:Name="btnBack"
                                Text="Regresar"
                                SemanticProperties.Hint="Regresar"
                                Clicked="btnBack_Clicked"
                                WidthRequest="250"
                                CornerRadius="2"                                
                                BackgroundColor="BlueViolet" 
                                FontAttributes="Bold"
                                Margin="3"/>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LoginSelector" Spacing="3">

                    <material:TextField
                            x:Name="txtUser"
                            Title="Usuario"
                            BorderThickness="0.4">
                        <material:TextField.Icon>
                            <FontImageSource 
                                Size="18"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Emoji_people}" />
                        </material:TextField.Icon>
                    </material:TextField>
                    
                    <material:TextField 
                        x:Name="txtPassword"
                        Title="Password" 
                        IsPassword="True">
                        <material:TextField.Icon>
                            <FontImageSource 
                                Size="18"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Key}" />
                        </material:TextField.Icon>
                        <material:TextField.Attachments>
                                <material:TextFieldPasswordShowHideAttachment />
                            </material:TextField.Attachments>
                    </material:TextField>

                        <!--<controls:EntryLayout 
                        x:Name="entryUser" 
                        Placeholder="Usuario"
                        HidePassword="False" 
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf007;"/>
                    
                    <controls:EntryLayout 
                        x:Name="entryPassword" 
                        Placeholder="Contraseña"
                        HidePassword="True" 
                        HidePasswordColor="Gray"
                        FontFamily="FontAwesome5Solid"
                        Glyph="&#xf023;"
                        AllowHidePasswordPassword="True"/>-->
                        <HorizontalStackLayout HorizontalOptions="Center" Padding="10">
                            <Button
                                x:Name="BtnTryLogin"
                                Text="Iniciar sesión"
                                SemanticProperties.Hint="Iniciar sesión"
                                Clicked="TryLogin"
                                WidthRequest="250"
                                CornerRadius="2"
                                HorizontalOptions="Center"
                                BackgroundColor="IndianRed" 
                                FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <Label 
        Text="Todos los derechos reservados &#169; D'Mujeres S.A. 2023"
            FontSize="11"
        VerticalOptions="Center" 
        HorizontalOptions="Center"
                        TextColor="Gray"/>

                    <Label 
            x:Name="lblAppVersion"
        Text="Version 0.1"
            FontSize="12"
        VerticalOptions="Center" 
        HorizontalOptions="Center" 
                        Margin="0"                        
                        TextColor="Gray"/>
                    <Label
            x:Name="txtEnvironment"
        Text="Environment"
            FontSize="12"
        VerticalOptions="Center"
        HorizontalOptions="Center" 
                        TextColor="Gray"
                        />

                    <Button
                    BackgroundColor="Red"
                    x:Name="btnSetting"
                    Text=""
                    SemanticProperties.Hint="Settings"
                    Clicked="ShowSettings"
                        VerticalOptions="Start"
                        HorizontalOptions="Center"
                        MinimumHeightRequest="40"
                        IsVisible="false">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome5Solid"
											Color="DimGray"
											Size="20"
											FontAutoScalingEnabled="True"                                                         
											Glyph="&#xf7d9;" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>

        <AbsoluteLayout Margin="0" MinimumHeightRequest="25" Padding="0" BackgroundColor="Transparent">
            <Label x:Name="lblTitle" 
           Text="Powered By Macronegocios &#169;"
           VerticalOptions="Center" 
           Margin="10,0,0,0" 
           TextColor="DarkBlue" 
           FontSize="12" 
           FontAttributes="None"
           AbsoluteLayout.LayoutFlags="All"
           AbsoluteLayout.LayoutBounds="0, 5, 1, 0.1"></Label>
            <StackLayout Orientation="Horizontal"
     AbsoluteLayout.LayoutFlags="All"
     AbsoluteLayout.LayoutBounds="0, 5, 1, 0.1"
     HorizontalOptions="End"
     VerticalOptions="Center">                
                <StackLayout Orientation="Horizontal" x:Name="TopTools"
         MaximumHeightRequest="40" 
         ZIndex="1">
                    <Image
                    Source="logo_odoo.png"
                    SemanticProperties.Description=""                
                    MaximumWidthRequest="200"
                    WidthRequest="200"
                    HorizontalOptions="Center"/>                    
                </StackLayout>                
            </StackLayout>
        </AbsoluteLayout>
    </StackLayout>    
</ContentPage>