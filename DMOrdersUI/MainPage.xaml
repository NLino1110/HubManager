<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             xmlns:validation="clr-namespace:InputKit.Shared.Validations;assembly=InputKit.Maui"
             x:Class="DMOrdersUI.MainPage"
             xmlns:local="clr-namespace:DMOrdersUI"
             xmlns:pages="clr-namespace:DMOrdersUI.Pages.Fragments.Customers"
            xmlns:pagesOrders="clr-namespace:DMOrdersUI.Pages.Fragments.Orders"
             xmlns:pagesActivities="clr-namespace:DMOrdersUI.Pages.Fragments.Activities"
             xmlns:pagesProducts="clr-namespace:DMOrdersUI.Pages.Fragments.Product"
             x:Name="page" 
            Title="Principal"
            NavigationPage.HasNavigationBar="False">
    <uranium:UraniumContentPage.BindingContext>
        <local:MainPageViewModel />
    </uranium:UraniumContentPage.BindingContext>

    <uranium:UraniumContentPage.Resources>
        <Style TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}" />
        </Style>
    </uranium:UraniumContentPage.Resources>    

        <Grid>

            <material:TabView x:Name="tabViewMain" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="0,0,0,30">
                
                <material:TabItem Title="Clientes">
                    <material:TabItem.Content>
                        <!--<Label Text="Tab Content Customers" Margin="60" />-->
                        <pages:Container x:Name="tabCustomers"></pages:Container>
                    </material:TabItem.Content>
                </material:TabItem>

                <material:TabItem Title="Artículos">
                    <material:TabItem.Content>
                        <pagesProducts:Container x:Name="tabProducts"></pagesProducts:Container>
                    </material:TabItem.Content>
                </material:TabItem>

                <material:TabItem Title="Pedidos">
                    <material:TabItem.Content>
                        <pagesOrders:Container x:Name="tabOrders"></pagesOrders:Container>
                    </material:TabItem.Content>
                </material:TabItem>

                <material:TabItem Title="Actividades">
                    <material:TabItem.Content>
                    <pagesActivities:Container x:Name="tabActivities"></pagesActivities:Container>
                </material:TabItem.Content>
                </material:TabItem>
            </material:TabView>

        </Grid>    

    <uranium:UraniumContentPage.Attachments>

        <material:BottomSheetView x:Name="bottomSheet" DisablePageWhenOpened="False" CloseOnTapOutside="True">
            <material:BottomSheetView.Header>
                <Grid HeightRequest="33"
                    BackgroundColor="Gray"
                    ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" 
                      ColumnSpacing="10">
                    <Grid.Shadow>
                        <Shadow Brush="Black"
                    Radius="20"
                    Opacity="0.2" />
                    </Grid.Shadow>

                    <Image Grid.Column="0" Source="logo_macronegocios.png" WidthRequest="60"/>

                    <Label Grid.Column="1"
                           x:Name="lblCompany"
                           Text="Opciones"
                           VerticalOptions="Center"
                           Padding="0"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnPrimary}"/>

                    <Label Grid.Column="2"                           
                        x:Name="lblStore"
                           BackgroundColor="LightGray"
                        Text="..."
                        VerticalOptions="Center"
                        Padding="5,0,5,0"
                        FontAttributes="None"
                        FontSize="10"
                        TextColor="DimGray"/>

                    <ImageButton 
                        x:Name="imageDebug"
                        Grid.Column="3"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Start"
                         VerticalOptions="Center"
                         HeightRequest="15"
                         WidthRequest="15"
                         Margin="10">
                        <ImageButton.Source>
                            <FontImageSource 
                                Size="18"
                                FontFamily="MaterialSharp"
                                Glyph="{x:Static uranium:MaterialSharp.Bug_report}"
                                Color="{StaticResource OnPrimaryContainerDark}" />
                        </ImageButton.Source>
                    </ImageButton>


                    <ImageButton 
                        Grid.Column="4"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Start"
                         VerticalOptions="Center"
                         HeightRequest="15"
                         WidthRequest="15"
                         Margin="10">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="MaterialSharp"
                                 Color="{StaticResource Gray100}"
                                 Size="20"
                                 FontAutoScalingEnabled="True"
                                 Glyph="{x:Static uranium:MaterialSharp.Person}" />
                        </ImageButton.Source>
                    </ImageButton>
                    
                    <Label Grid.Column="5"                           
                        x:Name="lblUser"       
                        Text="..."
                           TextColor="Pink"
                        VerticalOptions="Center"
                        Padding="5,0,5,0"
                        FontAttributes="None"
                        FontSize="10"/>

                    <Label Grid.Column="6"                           
                        x:Name="lblUserName"
                           BackgroundColor="LightGray"
                        Text="..."
                        VerticalOptions="Center"
                        Padding="5,0,5,0"
                        FontAttributes="None"
                        FontSize="10"
                        TextColor="DimGray"/>

                    <ImageButton Grid.Column="7"
                     BackgroundColor="Transparent"
                     VerticalOptions="Center"
                     HeightRequest="15"
                     WidthRequest="15"
                     Margin="10">
                        <ImageButton.Source>
                            <FontImageSource 
                                Size="18"
                                FontFamily="MaterialSharp"
                         Glyph="{x:Static uranium:MaterialSharp.Check}"
                         Color="{StaticResource OnPrimaryContainerDark}" />
                        </ImageButton.Source>
                    </ImageButton>

                </Grid>
            </material:BottomSheetView.Header>
            <Grid ColumnDefinitions="*,Auto">
                <TableView Intent="Menu" Margin="0" BackgroundColor="White" Grid.Column="0">
                    <TableRoot>
                        <TableSection>
                            <!--<ViewCell Tapped="ViewCell_Add_Sale">
                                <Grid Padding="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Point_of_sale}, Color={StaticResource Primary}}" WidthRequest="24" HeightRequest="24" Margin="10,0" />

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Nuevo pedido" FontAttributes="Bold" />
                                        <Label Text="Volver a ingresar credenciales." FontSize="12" />
                                    </StackLayout>
                                </Grid>
                            </ViewCell>-->

                            <ViewCell Tapped="ViewCell_Add_Task">
                                <Grid Padding="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Add_task}, Color={StaticResource Primary}}" WidthRequest="24" HeightRequest="24" Margin="10,0" />

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Nueva actividad" FontAttributes="Bold" />
                                        <Label Text="Volver a ingresar credenciales." FontSize="12" />
                                    </StackLayout>
                                </Grid>
                            </ViewCell>

                            <ViewCell Tapped="ViewCell_Tapped_Update">
                                <Grid Padding="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Cloud}, Color={StaticResource Primary}}" WidthRequest="24" HeightRequest="24" Margin="10,0" />

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Actualización" FontAttributes="Bold" />
                                        <Label Text="Sincronizar los datos principales." FontSize="12" />
                                    </StackLayout>
                                </Grid>
                            </ViewCell>

                            <ViewCell Tapped="ViewCell_Tapped_Exit">
                                <Grid Padding="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Exit_to_app}, Color={StaticResource Primary}}" WidthRequest="24" HeightRequest="24" Margin="10,0" />

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Salir" FontAttributes="Bold" />
                                        <Label Text="Volver a ingresar credenciales." FontSize="12" />
                                    </StackLayout>
                                </Grid>
                            </ViewCell>

                            <ViewCell Tapped="ShowSettings">
                                <Grid Padding="3" BackgroundColor="GhostWhite">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Settings}, Color={StaticResource Primary}}" WidthRequest="24" HeightRequest="24" Margin="10,0" />

                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Configuraciones" FontAttributes="Bold" />
                                        <Label Text="Modificar rutas de servidores y variables de entorno." FontSize="12" />
                                    </StackLayout>
                                </Grid>
                            </ViewCell>

                            <!--<ImageCell Text="Report" ImageSource="{FontImageSource FontFamily=MaterialSharp, Glyph={x:Static uranium:MaterialSharp.Report}, Color={StaticResource Primary}}"
                                Detail="Report this content." />-->
                        </TableSection>
                    </TableRoot>
                </TableView>
                <StackLayout Grid.Column="1" Margin="10">
                    <Label>0 procesos en background</Label>
                </StackLayout>
            </Grid>
        </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>
</uranium:UraniumContentPage>


