<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DMSA.Models.Odoo.Native"
             x:DataType="models:sale_order_line"
            xmlns:converters="clr-namespace:DMOrders.Converters"
            x:Name="Root">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Padding="4" ColumnSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>            
        </Grid.ColumnDefinitions>

        <!-- Ordinal -->
        <Label
        Grid.RowSpan="2"
        Grid.Column="0"
        Text="{Binding sequence}"
        FontSize="12"
        TextColor="Green"/>

        <!-- Code + SKU -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
            <Label
            Text="{Binding product_code}"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="Green"/>

            <Label
            Text="{Binding product_id, StringFormat='({0})'}"
            FontSize="10"
            FontAttributes="Bold"
            TextColor="DarkGray"
            VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Product Name -->
        <Label
        Grid.Row="1"
        Grid.Column="1"
        Grid.ColumnSpan="5"
        Text="{Binding product_display}"
        FontSize="11"
        TextColor="Black"/>

        <!-- UOM -->
        <Label Grid.Column="2"
            Text="{Binding uom_category_display}"
            FontSize="12"
            FontAttributes="Bold"/>

        <!-- Qty Real -->
        <Label Grid.Column="3"
            Text="{Binding product_uom_qty_real}"
            FontSize="12"
            FontAttributes="Bold"/>

        <!-- Qty -->
        <Label Grid.Column="4"
            Text="{Binding product_uom_qty}"
            FontSize="12"
            FontAttributes="Bold"/>

        <!-- Price -->
        <Label Grid.Column="5"
            Text="{Binding virtual_price_no_tax, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

        <!-- Subtotal -->
        <Label Grid.Column="6"
            Text="{Binding virtual_line_subtotal, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

        <!-- Discount % -->
        <Label Grid.Column="7"
            Text="{Binding discount, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

        <!-- Discount -->
        <Label Grid.Column="8"
            Text="{Binding amount_discount, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

        <!-- Tax -->
        <Label Grid.Column="9"
            Text="{Binding price_tax, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

        <!-- Total -->
        <Label Grid.Column="10"
            Text="{Binding price_total, StringFormat='{0:N4}'}"
            FontSize="12"
            FontAttributes="Bold"
            HorizontalTextAlignment="End"/>

            <HorizontalStackLayout Grid.Column="11" Grid.RowSpan="2" Spacing="5">

                <Button                    
                    HeightRequest="35"
                    WidthRequest="35"
                    FontSize="5"
                    FontAttributes="Bold"
                    TextColor="DimGray"
                    BackgroundColor="Transparent"                    
                    ImageSource="{FontImage FontFamily=FontAwesome5Solid, Glyph=&#xf06b;, Color=DodgerBlue, Size=10}"
                    Opacity="{Binding is_gift, Converter={StaticResource BoolToOpacity}}"
                    InputTransparent="{Binding is_gift, Converter={StaticResource InverseBool}}"
                    Padding="3"
                    Margin="2"/>
                
                <Button
                    HeightRequest="35"
                    WidthRequest="35"
                    BackgroundColor="OrangeRed"
                    HorizontalOptions = "Center"
                    ImageSource="{FontImage FontFamily=FontAwesome5Solid, Glyph=&#xf2ed;, Color=White, Size=15}"
                    Padding="3"
                    Margin="2"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding Item}"
                    IsVisible="{Binding LockEdition, Converter={StaticResource InverseBool}}"/>

            </HorizontalStackLayout>
        <!--</Grid>-->
    
    </Grid>
</ContentView>
