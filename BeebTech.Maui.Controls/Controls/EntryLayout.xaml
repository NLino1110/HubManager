<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeebTech.Maui.Controls.EntryLayout"
             x:Name="root">
    <VerticalStackLayout BindingContext="{x:Reference root}">
        <Border Padding="0,0,0,0" BackgroundColor="White" Stroke="LightGray" StrokeShape="RoundRectangle 4,4,4,4">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Start">
                
                <Image Margin="5,0,5,0"
                    WidthRequest="20" 
                    HeightRequest="20" 
                    HorizontalOptions="Start" 
                    VerticalOptions="Center"
                       IsVisible="{Binding ShowIcon}">
                    <Image.Source>
                        <FontImageSource FontFamily="{Binding FontFamily}"
                                     Color="{Binding IconColor}"
                                     Size="20"                                 
                                    FontAutoScalingEnabled="True"
                                     Glyph="{Binding Glyph}" />
                    </Image.Source>
                </Image>

                <Label x:Name="lblPlaceholder" 
                   Text="{Binding Placeholder}"
                   FontSize="14"
                   TextColor="Gray"
                   TranslationX="-4"
                   TranslationY="16"
                   BackgroundColor="White"
                   Padding="5,0"
                   VerticalOptions="Start" 
                   Grid.Column="1"/>

                <Entry x:Name="txtContent"
                   FontSize="16"
                   TextColor="Black"
                       Text="{Binding Text}"
                   BackgroundColor="Transparent"                   
                   Margin="-3,10,0,0"
                   TextChanged="TxtContent_TextChanged"
                   Focused="TxtContent_Focused"
                   Unfocused="TxtContent_Unfocused"
                       IsPassword="{Binding HidePassword}"
                   Grid.Column="1"/>

                <StackLayout Grid.RowSpan="2" Grid.Row="0" Grid.Column="2" 
                    WidthRequest="30"                             
                    IsVisible="{Binding AllowHidePasswordPassword}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="-5,0,0,0"
                             Margin="0,0,5,0">
                    <ImageButton
                    Clicked="OnImageButtonClicked"
                    BackgroundColor="Transparent">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton"
                     Binding="{Binding HidePassword}"
                     Value="True">
                            <Setter Property="Source">
                                <Setter.Value>
                                    <FontImageSource FontFamily="FontAwesome5Regular"
                                     Size="18"
                                     Color="{Binding HidePasswordColor}"
                                     Glyph="&#xf06e;" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger TargetType="ImageButton"
                     Binding="{Binding HidePassword}"
                     Value="False">
                            <Setter Property="Source">
                                <Setter.Value>
                                    <FontImageSource FontFamily="FontAwesome5Regular"
                                     Size="18"
                                     Color="{Binding HidePasswordColor}"
                                     Glyph="&#xf070;" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
                </StackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
