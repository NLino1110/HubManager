<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeebTech.Maui.Controls.Controls.CustomProgressBar"
             x:Name="this">
    <Grid HeightRequest="{Binding BarHeight, Source={x:Reference this}}"
          BackgroundColor="{Binding TrackColor, Source={x:Reference this}}"
          HorizontalOptions="Fill"
          VerticalOptions="Center">

        <Grid x:Name="ProgressFill"
              BackgroundColor="{Binding ProgressColor, Source={x:Reference this}}"
              HorizontalOptions="Start"
              VerticalOptions="Fill"
              HeightRequest="{Binding BarHeight, Source={x:Reference this}}"
              WidthRequest="0">

            <Label x:Name="ProgressLabel"
                   Text="{Binding ProgressText, Source={x:Reference this}}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="6,0"/>
        </Grid>
    </Grid>
</ContentView>