@page "/packages"
@using WebMobileManager.Web.Services.Interfaces
@inject IPackageService packageService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h5">Paquetes</MudText>

<MudStack Row Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="ReloadGrid">
        Refrescar
    </MudButton>
</MudStack>

    <MudDataGrid @ref="grid"
             T="PackageViewDto"
                 ServerData="LoadServerData"
                 Hover="true"
                 Dense="true">
    <Columns>

        <PropertyColumn Property="x => x.Name" Title="Nombre" />
        <PropertyColumn Property="x => x.database_name" Title="Base de datos" />
        <PropertyColumn Property="x => x.file_name" Title="Archivo" />

        <TemplateColumn Title="Archivos">
            <CellTemplate>
                @if (context.Item.Files != null && context.Item.Files.Any())
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var file in context.Item.Files)
                        {
                            <MudChip Color="@(file.success_upload ? Color.Success : Color.Error)"
                                     Size="Size.Small">
                                @file.file_name
                            </MudChip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption">Sin archivos</MudText>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Estado">
            <CellTemplate>
                <MudChip Color="@(context.Item.success_upload ? Color.Success : Color.Warning)">
                    @(context.Item.processing_state ?? "Pendiente")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.created_at" Title="Fecha" />
        <TemplateColumn Title="Acciones">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => Delete(context.Item.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Download"
                               Color="Color.Error"
                               OnClick="@(() => DownloadFullPack(context.Item.Id))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

</MudDataGrid>

@code
{
    private MudDataGrid<PackageViewDto> grid;

    private async Task<GridData<PackageViewDto>> LoadServerData(
    GridState<PackageViewDto> state,
    CancellationToken cancellationToken)
    {
        int page = state.Page + 1;
        int pageSize = state.PageSize;

        var result = await packageService.GetPackages(page, pageSize);

        return new GridData<PackageViewDto>
        {
            Items = result.Item1,
            TotalItems = result.Item2
        };
    }

    private async Task Delete(int id)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            "¿Eliminar este paquete?",
            yesText: "Sí",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await packageService.DeletePackage(id);

            Snackbar.Add("Paquete eliminado", Severity.Success);

            await ReloadGrid();
        }
    }

    private async Task DownloadFullPack(int id)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar",
            "¿Descargar este paquete?",
            yesText: "Sí",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            Snackbar.Add("Descargando Paquete", Severity.Success);
            
        }
    }

    private async Task ReloadGrid()
    {
        await grid.ReloadServerData();
    }
}