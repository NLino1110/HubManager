@page "/hubmanager"
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Authorize]

<h3>HubManager</h3>

<div>
    Servidor en ejecución: 
</div>

<MudButton 
    Variant="Variant.Filled" 
    Color="Color.Primary"
           @onclick="() => LoadDevices()">Cargar</MudButton>
<MudButton 
    Variant="Variant.Filled" 
    Color="Color.Secondary" 
           StartIcon="@Icons.Material.Filled.Delete"
    @onclick="() => ClearDevices()">Limpiar</MudButton>

@* <MudButton Variant="Variant.Filled"
           Color="Color.Secondary"
           StartIcon="@Icons.Material.Filled.Delete"           
           @onclick="() => LoadDummy()">Cargar Datos</MudButton> *@

@* <button type="button" class="btn btn-sm btn-info"
        @onclick="TestDialog"
        data-toggle="tooltip"
        data-placement="top"
        title="Verificar estado">
    <i class="fa fa-sm fa-wifi"></i>
    Probar
</button> *@

<MudDataGrid Items="@devices.Take(4)">
    <Columns>
        <PropertyColumn Property="x => x.AppName" Title="Nr" />
        <PropertyColumn Property="x => x.DeviceName" />
        <PropertyColumn Property="x => x.Platform" />
        <PropertyColumn Property="x => x.Manufacturer" />
        <PropertyColumn Property="x => x.Model" />
        <PropertyColumn Property="x => x.VersionString" Title="Version" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudStack Row>
                    @* <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">Hire</MudButton> *@

                    <MudFab Color="Color.Secondary"
                            StartIcon="@Icons.Material.Filled.Download"
                            @onclick="(x) => SendMessageDevice(context.Item)"
                            Size="Size.Small" />

                    <MudFab Color="Color.Success"
                            StartIcon="@Icons.Material.Filled.Message"
                            @onclick="(x) => SendMessageDevice(context.Item)"
                            Size="Size.Small" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

