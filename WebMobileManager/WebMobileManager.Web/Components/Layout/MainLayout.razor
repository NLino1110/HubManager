 @inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudLayout>
    
    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Mini">
        <NavMenu />
    </MudDrawer>
        
    <MudMainContent>
        
        <MudAppBar Elevation="1">
            <MudText Typo="Typo.h6">WebMobileManager</MudText>
            <MudSpacer />
            <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank">
                About
            </MudLink>
        </MudAppBar>
                
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-1 ma-1">
            @Body
        </MudContainer>

    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>