 @inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- Sidebar -->
    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Mini">
        <NavMenu />
    </MudDrawer>

    <!-- Contenido principal -->
    <MudMainContent>

        <!-- Top bar -->
        <MudAppBar Elevation="1">
            <MudText Typo="Typo.h6">WebMobileManager</MudText>
            <MudSpacer />
            <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank">
                About
            </MudLink>
        </MudAppBar>

        <!-- Body -->
        <MudContainer Class="mt-4">
            @Body
        </MudContainer>

    </MudMainContent>

</MudLayout>

<!-- Error UI (puedes dejarlo igual) -->
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>