@page "/syncmanager"
@using BlazorDateRangePicker;
@inject IWebHostEnvironment WebHostEnvironment

<h3>Sincronización de clientes</h3>

<div class="px-0 m-0">
    <div class="row">
        <div class="m-1">
            <DateRangePicker CustomDateClass="form-control auto"
                             TimePicker="true"
                             TimePicker24Hour="true"
                             DateFormat="@($"dd/MM/yyyy hh:mm tt")"
                             @bind-StartDate="StartDate" @bind-EndDate="EndDate" />
        </div>
        <div class="m-1">
            <button type="button" class="btn btn-sm btn-success"
                    @onclick="() => SyncInit()"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="Iniciar sincronización">
                <i class="fa fa-sm fa-database"></i>
                SyncInit
            </button>
        </div>
    </div>
</div>


