                             @bind-StartDate="StartDate" @bind-EndDate="EndDate" />
        </div>
        <div class="m-1">
            <button type="button" class="btn btn-sm btn-success"
                    @onclick="() => SyncManager()"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="Verificar estado">
