<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show" @onclick="Cancel"></div>
    <div class="modal-dialog" style="z-index: 1050">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@BlazoredModal.Title</h5>
                <button type="button" class="btn btn-sm close" aria-label="Close" @onclick="Cancel">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="m-3">
            <p style="word-break: break-all;">@Message</p>
            </div>
            <div class="modal-footer">
                <button @onclick="SubmitForm" class="btn btn-primary">Precios</button>
                <button @onclick="SubmitForm" class="btn btn-primary">Stock</button>
                <button @onclick="SubmitForm" class="btn btn-primary">Precios y Stock</button>
                <button @onclick="Cancel" class="btn btn-secondary">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    [Parameter]
    public string Message { get; set; }    

    async Task SubmitForm() => await BlazoredModal.CloseAsync();
    async Task Cancel() => await BlazoredModal.CancelAsync();
}