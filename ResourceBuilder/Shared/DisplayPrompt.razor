<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show" @onclick="Cancel"></div>
    <div class="modal-dialog" style="z-index: 1050">
        <!-- Pop it above the backdrop -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@BlazoredModal.Title</h5>
                <button type="button" class="close" aria-label="Close" @onclick="Cancel">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="m-3">
                <p style="word-break: break-all;">@Message</p>
                <input @bind-value=@PromptValue type="text" class="form-control" placeholder="">
            </div>
            <div class="modal-footer">
                <button @onclick="SubmitForm" class="btn btn-primary">Aceptar</button>
                <button @onclick="Cancel" class="btn btn-secondary">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    [Parameter]
    public string Message { get; set; }

    [Parameter]
    public string PromptValue { get; set; }

    async Task SubmitForm() => await BlazoredModal.CloseAsync(ModalResult.Ok(PromptValue));
    async Task Cancel() => await BlazoredModal.CancelAsync();

}