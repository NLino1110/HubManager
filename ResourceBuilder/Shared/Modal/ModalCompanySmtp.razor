<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show" @onclick="Cancel"></div>
    <div class="modal-dialog" style="z-index: 1050"> <!-- Pop it above the backdrop -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@BlazoredModal.Title</h5>
                <button type="button" class="close" aria-label="Close" @onclick="Cancel">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>
                    Ingrese la información correcta
                </p>
                <p class="alert alert-success">Modificando datos</p>
                <form>
                    <div class="form-group">
                        <div class="row">
                            <div class="col-2">
                                <div class="card-body d-table-cell align-middle" style="padding: 0.5em;">
                                    host:
                                </div>
                            </div>
                            <div class="col-6">
                                <input @bind-value=@selectedItem.host type="text" class="form-control" placeholder="host">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-2">
                                <div class="card-body d-table-cell align-middle" style="padding: 0.5em;">
                                    Puerto:
                                </div>
                            </div>
                            <div class="col-6">
                                <input @bind-value=@selectedItem.port type="number" class="form-control" placeholder="Puerto">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-2">
                                <div class="card-body d-table-cell align-middle" style="padding: 0.5em;">
                                    userName:
                                </div>
                            </div>
                            <div class="col-6">
                                <input @bind-value=@selectedItem.userName type="text" class="form-control" placeholder="Usuario">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2">
                                <div class="card-body d-table-cell align-middle" style="padding: 0.5em;">
                                    Password:
                                </div>
                            </div>
                            <div class="col-6">
                                <input @bind-value=@selectedItem.password type="text" class="form-control" placeholder="Password">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="cs1" @bind=selectedItem.EnableSsl>
                                    <label class="custom-control-label" for="cs1">EnableSsl</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="cs2" @bind=selectedItem.UseDefaultCredentials>
                                    <label class="custom-control-label" for="cs2">UseDefaultCredentials</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button @onclick="SaveChanges" class="btn btn-primary">Guardar</button>
                <button @onclick="Cancel" class="btn btn-secondary">Cerrar</button>
            </div>
        </div>
    </div>
</div>
