<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeebTech.Maui.Controls.TogglePasswordEntry"
             x:Name="root">
    <ContentView.Content>
        <Grid BindingContext="{x:Reference root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Image WidthRequest="20">
                <Image.Source>
                <FontImageSource FontFamily="FontAwesome5Solid"
                                                 Color="{Binding HidePasswordColor}"
                                                 Size="20"
                                 FontAutoScalingEnabled="True"
                                                 Glyph="&#xf023;" />
                </Image.Source>
            </Image>
            
            <Entry Placeholder="{Binding Placeholder}"
                   Text="{Binding Text}"
                   IsPassword="{Binding HidePassword}"
                   Grid.Column="1"
                   Completed="OnEntryCompleted"/>
            
            
            <ImageButton Clicked="OnImageButtonClicked"
                         BackgroundColor="Transparent"
                         Grid.Column="2" WidthRequest="20">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton"
                                 Binding="{Binding HidePassword}"
                                 Value="True">
                        <Setter Property="Source">
                            <Setter.Value>
                                <FontImageSource FontFamily="FontAwesome5Regular"
                                                 Size="18"
                                                 Color="{Binding HidePasswordColor}"
                                                 Glyph="&#xf06e;" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger TargetType="ImageButton"
                                 Binding="{Binding HidePassword}"
                                 Value="False">
                        <Setter Property="Source">
                            <Setter.Value>
                                <FontImageSource FontFamily="FontAwesome5Regular"
                                                 Size="18"
                                                 Color="{Binding HidePasswordColor}"
                                                 Glyph="&#xf070;" />
                                </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>
        </Grid>
    </ContentView.Content>
</ContentView>