<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeebTech.Maui.Controls.Controls.TitledPicker"
             x:Name="This">
    <VerticalStackLayout Spacing="2">

        <!-- Título SOLO Android -->
        <Label
            x:Name="TitleLabel"
            Text="{Binding Title, Source={x:Reference This}}"
            FontSize="12"
            TextColor="Gray"
            IsVisible="False" />

        <!-- Picker real -->
        <Picker
            x:Name="InnerPicker"
            Title="{Binding Title, Source={x:Reference This}}"
            ItemsSource="{Binding ItemsSource, Source={x:Reference This}}"
            SelectedItem="{Binding SelectedItem, Source={x:Reference This}, Mode=TwoWay}" />

    </VerticalStackLayout>
</ContentView>
